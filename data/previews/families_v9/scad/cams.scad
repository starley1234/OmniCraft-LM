$fn = 32;
// ----------------------------------------------------------------------
// Cam: base radius 20 mm with a 14 mm lift over 150 degrees
// ----------------------------------------------------------------------

// --- parameters (mm) ---
base_r = 20;              // base radius
lift = 14;                // lift height above the base radius
lift_span = 150;          // angular width of the lift
lift_start = 30;          // angle where the lift starts
cam_t = 8;                // cam plate thickness
hub_d = 17;               // hub diameter
hub_h = 18;               // hub height
bore_d = 9.53;            // bore
key_w = 4;                // keyway width
key_depth = 1.74;         // keyway depth

cam_profile = [[20, 0], [19.924, 1.743], [19.696, 3.473], [19.319, 5.176], [18.794, 6.84], [18.126, 8.452], [17.321, 10], [16.794, 11.759], [16.802, 14.099], [17.036, 17.036], [17.141, 20.428], [16.8, 23.993], [15.792, 27.353], [14.04, 30.109], [11.618, 31.92], [8.726, 32.568], [5.644, 32.009], [2.658, 30.384], [0, 27.996], [-2.209, 25.253], [-3.983, 22.591], [-5.464, 20.392], [-6.884, 18.913], [-8.452, 18.126], [-10, 17.321], [-11.472, 16.383], [-12.856, 15.321], [-14.142, 14.142], [-15.321, 12.856], [-16.383, 11.472], [-17.321, 10], [-18.126, 8.452], [-18.794, 6.84], [-19.319, 5.176], [-19.696, 3.473], [-19.924, 1.743], [-20, 0], [-19.924, -1.743], [-19.696, -3.473], [-19.319, -5.176], [-18.794, -6.84], [-18.126, -8.452], [-17.321, -10], [-16.794, -11.759], [-16.802, -14.099], [-17.036, -17.036], [-17.141, -20.428], [-16.8, -23.993], [-15.792, -27.353], [-14.04, -30.109], [-11.618, -31.92], [-8.726, -32.568], [-5.644, -32.009], [-2.658, -30.384], [0, -27.996], [2.209, -25.253], [3.983, -22.591], [5.464, -20.392], [6.884, -18.913], [8.452, -18.126], [10, -17.321], [11.472, -16.383], [12.856, -15.321], [14.142, -14.142], [15.321, -12.856], [16.383, -11.472], [17.321, -10], [18.126, -8.452], [18.794, -6.84], [19.319, -5.176], [19.696, -3.473], [19.924, -1.743]];

difference() {
  union() {
    linear_extrude(height = cam_t) polygon(cam_profile);
    /* hub, proud of the cam plate on both sides */
    translate([0, 0, -5]) cylinder(h = hub_h, d = hub_d);
  }
  /* bore through the hub, 2.5 mm clear on both faces */
  translate([0, 0, -7.5]) cylinder(h = hub_h + 5, d = bore_d);
  /* keyway, milled through the whole hub */
  translate([3.022, -2, -7.5]) cube([4.24, 4, 23]);
}
