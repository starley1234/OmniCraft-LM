$fn = 32;
// ----------------------------------------------------------------------
// Thumb nut: 7 lobe grip, 16 mm tall, M12.7 thread
// ----------------------------------------------------------------------

// --- parameters (mm) ---
base_r = 14;              // grip base radius
lobe_amp = 2.5;           // lobe height above the base radius
lobes = 7;                // number of grip lobes
grip_h = 10;              // grip height
boss_d = 22;              // threaded boss diameter
boss_h = 6;               // boss height
bore_d = 12.7;            // thread core diameter
pitch = 1.75;             // thread pitch
thread_d = 1.05;          // thread depth

grip = [[16.5, 0], [15.389, 2.026], [12.898, 3.456], [10.8, 4.474], [10.249, 5.917], [10.848, 8.324], [11.149, 11.149], [10.032, 13.073], [7.625, 13.207], [4.991, 12.05], [2.998, 11.19], [1.568, 11.914], [0, 14], [-2.086, 15.847], [-4.248, 15.855], [-5.724, 13.818], [-6.375, 11.042], [-7.014, 9.141], [-8.649, 8.649], [-11.366, 8.721], [-13.999, 8.083], [-15.068, 6.241], [-14.148, 3.791], [-12.371, 1.629], [-11.5, 0], [-12.371, -1.629], [-14.148, -3.791], [-15.068, -6.241], [-13.999, -8.083], [-11.366, -8.721], [-8.649, -8.649], [-7.014, -9.141], [-6.375, -11.042], [-5.724, -13.818], [-4.248, -15.855], [-2.086, -15.847], [0, -14], [1.568, -11.914], [2.998, -11.19], [4.991, -12.05], [7.625, -13.207], [10.032, -13.073], [11.149, -11.149], [10.848, -8.324], [10.249, -5.917], [10.8, -4.474], [12.898, -3.456], [15.389, -2.026]];

difference() {
  union() {
    /* grip outline extruded straight up */
    linear_extrude(height = grip_h) polygon(grip);
    /* boss sunk half a millimetre into the grip */
    translate([0, 0, grip_h - 0.5]) cylinder(h = boss_h + 0.5, d = boss_d);
  }
  /* threaded bore through grip and boss */
  translate([0, 0, -2.5]) cylinder(h = grip_h + boss_h + 5, d = bore_d);
  translate([0, 0, 2.0]) rotate_extrude() polygon([[5.35, 0], [5.35, 12], [5.85, 12], [7.4, 11.125], [5.85, 10.25], [7.4, 9.375], [5.85, 8.5], [7.4, 7.625], [5.85, 6.75], [7.4, 5.875], [5.85, 5], [7.4, 4.125], [5.85, 3.25], [7.4, 2.375], [5.85, 0], [5.35, 0]]);
}
