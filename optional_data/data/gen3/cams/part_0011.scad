$fn = 32;

// ----------------------------------------------------------------------
// Cam: base radius 24 mm with a 10 mm lift over 180 degrees
// ----------------------------------------------------------------------

// --- parameters (mm) ---
base_r = 24;              // base radius
lift = 10;                // lift height above the base radius
lift_span = 180;          // angular width of the lift
lift_start = 0;           // angle where the lift starts
cam_t = 10;               // cam plate thickness
hub_d = 22.8;             // hub diameter
hub_h = 18;               // hub height
bore_d = 9.53;            // bore
key_w = 5;                // keyway width
