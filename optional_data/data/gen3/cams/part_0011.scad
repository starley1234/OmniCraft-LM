cam_profile = [[24, 0], [24.157, 2.113], [24.594, 4.337], [25.21, 6.755], [25.856, 9.411], [26.355, 12.289], [26.531, 15.318], [26.236, 18.371], [25.37, 21.288], [23.898, 23.898], [21.853, 26.044], [19.329, 27.604], [16.465, 28.518], [13.426, 28.793], [10.374, 28.503], [7.444, 27.782], [4.726, 26.802], [2.253, 25.749], [0, 24.794], [-2.106, 24.068], [-4.168, 23.635], [-6.212, 23.182], [-8.208, 22.553], [-10.143, 21.751], [-12, 20.785], [-13.766, 19.66], [-15.427, 18.385], [-16.971, 16.971], [-18.385, 15.427], [-19.66, 13.766], [-20.785, 12], [-21.751, 10.143], [-22.553, 8.208], [-23.182, 6.212], [-23.635, 4.168], [-23.909, 2.092], [-24, 0], [-24.157, -2.113], [-24.594, -4.337], [-25.21, -6.755], [-25.856, -9.411], [-26.355, -12.289], [-26.531, -15.318], [-26.236, -18.371], [-25.37, -21.288], [-23.898, -23.898], [-21.853, -26.044], [-19.329, -27.604], [-16.465, -28.518], [-13.426, -28.793], [-10.374, -28.503], [-7.444, -27.782], [-4.726, -26.802], [-2.253, -25.749], [0, -24.794], [2.106, -24.068], [4.168, -23.635], [6.212, -23.182], [8.208, -22.553], [10.143, -21.751], [12, -20.785], [13.766, -19.66], [15.427, -18.385], [16.971, -16.971], [18.385, -15.427], [19.66, -13.766], [20.785, -12], [21.751, -10.143], [22.553, -8.208], [23.182, -6.212], [23.635, -4.168], [23.909, -2.092]];

difference() {
  union() {
    linear_extrude(height = cam_t) polygon(cam_profile);
    /* hub, proud of the cam plate on both sides */
    translate([0, 0, -4]) cylinder(h = hub_h, d = hub_d);
  }
  /* bore through the hub, 2.5 mm clear on both faces */
  translate([0, 0, -6.5]) cylinder(h = hub_h + 5, d = bore_d);
  /* keyway, milled through the whole hub */
  translate([2.263, -2.5, -6.5]) cube([5, 5, 23]);
