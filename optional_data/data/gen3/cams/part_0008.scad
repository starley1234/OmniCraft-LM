cam_profile = [[24, 0], [23.909, 2.092], [23.635, 4.168], [23.182, 6.212], [22.553, 8.208], [21.751, 10.143], [20.785, 12], [19.771, 13.844], [18.796, 15.771], [17.799, 17.799], [16.712, 19.917], [15.466, 22.088], [14, 24.249], [12.271, 26.315], [10.261, 28.191], [7.979, 29.778], [5.464, 30.986], [2.777, 31.742], [0, 32], [-2.777, 31.742], [-5.464, 30.986], [-7.979, 29.778], [-10.261, 28.191], [-12.271, 26.315], [-14, 24.249], [-15.466, 22.088], [-16.712, 19.917], [-17.799, 17.799], [-18.796, 15.771], [-19.771, 13.844], [-20.785, 12], [-21.751, 10.143], [-22.553, 8.208], [-23.182, 6.212], [-23.635, 4.168], [-23.909, 2.092], [-24, 0], [-23.909, -2.092], [-23.635, -4.168], [-23.182, -6.212], [-22.553, -8.208], [-21.751, -10.143], [-20.785, -12], [-19.66, -13.766], [-18.385, -15.427], [-16.971, -16.971], [-15.427, -18.385], [-13.766, -19.66], [-12, -20.785], [-10.143, -21.751], [-8.208, -22.553], [-6.212, -23.182], [-4.168, -23.635], [-2.092, -23.909], [0, -24], [2.092, -23.909], [4.168, -23.635], [6.212, -23.182], [8.208, -22.553], [10.143, -21.751], [12, -20.785], [13.766, -19.66], [15.427, -18.385], [16.971, -16.971], [18.385, -15.427], [19.66, -13.766], [20.785, -12], [21.751, -10.143], [22.553, -8.208], [23.182, -6.212], [23.635, -4.168], [23.909, -2.092]];

difference() {
  union() {
    linear_extrude(height = cam_t) polygon(cam_profile);
    /* hub, proud of the cam plate on both sides */
    translate([0, 0, -6]) cylinder(h = hub_h, d = hub_d);
  }
  /* bore through the hub, 2.5 mm clear on both faces */
  translate([0, 0, -8.5]) cylinder(h = hub_h + 5, d = bore_d);
