$fn = 32;

// ----------------------------------------------------------------------
// Cam: base radius 18 mm with a 8 mm lift over 120 degrees
// ----------------------------------------------------------------------

// --- parameters (mm) ---
base_r = 18;              // base radius
lift = 8;                 // lift height above the base radius
lift_span = 120;          // angular width of the lift
lift_start = 30;          // angle where the lift starts
cam_t = 8;                // cam plate thickness
hub_d = 15.3;             // hub diameter
hub_h = 20;               // hub height
bore_d = 12.7;            // bore
key_w = 6;                // keyway width
key_depth = 1.6;          // keyway depth

cam_profile = [[18, 0], [17.932, 1.569], [17.727, 3.126], [17.387, 4.659], [16.914, 6.156], [16.314, 7.607], [15.588, 9], [14.856, 10.403], [14.199, 11.915], [13.556, 13.556], [12.856, 15.321], [12.025, 17.173], [11, 19.053], [9.735, 20.877], [8.208, 22.553], [6.426, 23.982], [4.422, 25.077], [2.254, 25.765], [0, 26], [-2.254, 25.765], [-4.422, 25.077], [-6.426, 23.982], [-8.208, 22.553], [-9.735, 20.877], [-11, 19.053], [-12.025, 17.173], [-12.856, 15.321], [-13.556, 13.556], [-14.199, 11.915], [-14.856, 10.403], [-15.588, 9], [-16.314, 7.607], [-16.914, 6.156], [-17.387, 4.659], [-17.727, 3.126], [-17.932, 1.569], [-18, 0], [-17.932, -1.569], [-17.727, -3.126], [-17.387, -4.659], [-16.914, -6.156], [-16.314, -7.607], [-15.588, -9], [-14.745, -10.324], [-13.789, -11.57], [-12.728, -12.728], [-11.57, -13.789], [-10.324, -14.745], [-9, -15.588], [-7.607, -16.314], [-6.156, -16.914], [-4.659, -17.387], [-3.126, -17.727], [-1.569, -17.932], [0, -18], [1.569, -17.932], [3.126, -17.727], [4.659, -17.387], [6.156, -16.914], [7.607, -16.314], [9, -15.588], [10.324, -14.745], [11.57, -13.789], [12.728, -12.728], [13.789, -11.57], [14.745, -10.324], [15.588, -9], [16.314, -7.607], [16.914, -6.156], [17.387, -4.659], [17.727, -3.126], [17.932, -1.569]];

difference() {
  union() {
    linear_extrude(height = cam_t) polygon(cam_profile);
    /* hub, proud of the cam plate on both sides */
    translate([0, 0, -6]) cylinder(h = hub_h, d = hub_d);
  }
  /* bore through the hub, 2.5 mm clear on both faces */
  translate([0, 0, -8.5]) cylinder(h = hub_h + 5, d = bore_d);
  /* keyway, milled through the whole hub */
  translate([4.75, -3, -8.5]) cube([4.1, 6, 25]);
