cam_profile = [[24, 0], [23.909, 2.092], [23.635, 4.168], [23.182, 6.212], [22.553, 8.208], [21.751, 10.143], [20.785, 12], [19.747, 13.827], [18.708, 15.698], [17.634, 17.634], [16.48, 19.64], [15.2, 21.708], [13.75, 23.816], [12.089, 25.926], [10.187, 27.988], [8.023, 29.944], [5.594, 31.726], [2.91, 33.267], [0, 34.5], [-3.094, 35.364], [-6.314, 35.81], [-9.592, 35.799], [-12.852, 35.312], [-16.015, 34.343], [-19, 32.909], [-21.735, 31.041], [-24.155, 28.786], [-26.207, 26.207], [-27.855, 23.373], [-29.079, 20.362], [-29.878, 17.25], [-30.265, 14.113], [-30.273, 11.018], [-29.944, 8.023], [-29.332, 5.172], [-28.497, 2.493], [-27.5, 0], [-26.4, -2.31], [-25.248, -4.452], [-24.088, -6.454], [-22.949, -8.353], [-21.848, -10.188], [-20.785, -12], [-19.66, -13.766], [-18.385, -15.427], [-16.971, -16.971], [-15.427, -18.385], [-13.766, -19.66], [-12, -20.785], [-10.143, -21.751], [-8.208, -22.553], [-6.212, -23.182], [-4.168, -23.635], [-2.092, -23.909], [0, -24], [2.092, -23.909], [4.168, -23.635], [6.212, -23.182], [8.208, -22.553], [10.143, -21.751], [12, -20.785], [13.766, -19.66], [15.427, -18.385], [16.971, -16.971], [18.385, -15.427], [19.66, -13.766], [20.785, -12], [21.751, -10.143], [22.553, -8.208], [23.182, -6.212], [23.635, -4.168], [23.909, -2.092]];

difference() {
  union() {
    linear_extrude(height = cam_t) polygon(cam_profile);
    /* hub, proud of the cam plate on both sides */
    translate([0, 0, -6]) cylinder(h = hub_h, d = hub_d);
