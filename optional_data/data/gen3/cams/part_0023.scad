cam_profile = [[22, 0], [21.916, 1.917], [21.666, 3.82], [21.25, 5.694], [20.673, 7.524], [19.939, 9.298], [19.053, 11], [18.021, 12.619], [16.853, 14.141], [15.556, 15.556], [14.18, 16.9], [12.757, 18.219], [11.268, 19.517], [9.693, 20.787], [8.013, 22.016], [6.212, 23.182], [4.277, 24.258], [2.206, 25.209], [0, 26], [-2.327, 26.593], [-4.752, 26.952], [-7.247, 27.046], [-9.772, 26.848], [-12.283, 26.341], [-14.732, 25.517], [-17.069, 24.377], [-19.245, 22.935], [-21.213, 21.213], [-22.935, 19.245], [-24.377, 17.069], [-25.517, 14.732], [-26.341, 12.283], [-26.848, 9.772], [-27.046, 7.247], [-26.952, 4.752], [-26.593, 2.327], [-26, 0], [-25.209, -2.206], [-24.258, -4.277], [-23.182, -6.212], [-22.016, -8.013], [-20.787, -9.693], [-19.517, -11.268], [-18.219, -12.757], [-16.9, -14.18], [-15.556, -15.556], [-14.141, -16.853], [-12.619, -18.021], [-11, -19.053], [-9.298, -19.939], [-7.524, -20.673], [-5.694, -21.25], [-3.82, -21.666], [-1.917, -21.916], [0, -22], [1.917, -21.916], [3.82, -21.666], [5.694, -21.25], [7.524, -20.673], [9.298, -19.939], [11, -19.053], [12.619, -18.021], [14.141, -16.853], [15.556, -15.556], [16.853, -14.141], [18.021, -12.619], [19.053, -11], [19.939, -9.298], [20.673, -7.524], [21.25, -5.694], [21.666, -3.82], [21.916, -1.917]];

difference() {
  union() {
    linear_extrude(height = cam_t) polygon(cam_profile);
    /* hub, proud of the cam plate on both sides */
    translate([0, 0, -4]) cylinder(h = hub_h, d = hub_d);
