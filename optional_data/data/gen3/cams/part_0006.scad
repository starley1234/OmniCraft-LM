cam_profile = [[18, 0], [17.932, 1.569], [17.727, 3.126], [17.387, 4.659], [16.914, 6.156], [16.314, 7.607], [15.588, 9], [14.87, 10.412], [14.252, 11.959], [13.673, 13.673], [13.059, 15.563], [12.332, 17.612], [11.418, 19.777], [10.256, 21.995], [8.801, 24.18], [7.03, 26.238], [4.949, 28.067], [2.587, 29.571], [0, 30.663], [-2.736, 31.275], [-5.53, 31.363], [-8.282, 30.91], [-10.892, 29.926], [-13.268, 28.453], [-15.332, 26.555], [-17.026, 24.316], [-18.319, 21.832], [-19.207, 19.207], [-19.712, 16.54], [-19.879, 13.92], [-19.777, 11.418], [-19.486, 9.086], [-19.091, 6.949], [-18.678, 5.005], [-18.323, 3.231], [-18.084, 1.582], [-18, 0], [-17.932, -1.569], [-17.727, -3.126], [-17.387, -4.659], [-16.914, -6.156], [-16.314, -7.607], [-15.588, -9], [-14.745, -10.324], [-13.789, -11.57], [-12.728, -12.728], [-11.57, -13.789], [-10.324, -14.745], [-9, -15.588], [-7.607, -16.314], [-6.156, -16.914], [-4.659, -17.387], [-3.126, -17.727], [-1.569, -17.932], [0, -18], [1.569, -17.932], [3.126, -17.727], [4.659, -17.387], [6.156, -16.914], [7.607, -16.314], [9, -15.588], [10.324, -14.745], [11.57, -13.789], [12.728, -12.728], [13.789, -11.57], [14.745, -10.324], [15.588, -9], [16.314, -7.607], [16.914, -6.156], [17.387, -4.659], [17.727, -3.126], [17.932, -1.569]];

difference() {
  union() {
    linear_extrude(height = cam_t) polygon(cam_profile);
    /* hub, proud of the cam plate on both sides */
    translate([0, 0, -6]) cylinder(h = hub_h, d = hub_d);
