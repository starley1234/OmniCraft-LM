$fn = 32;

// ----------------------------------------------------------------------
// Cam: base radius 18 mm with a 14 mm lift over 150 degrees
// ----------------------------------------------------------------------

// --- parameters (mm) ---
base_r = 18;              // base radius
lift = 14;                // lift height above the base radius
