$fn = 32;

// ----------------------------------------------------------------------
// Cam: base radius 26 mm with a 10 mm lift over 150 degrees
// ----------------------------------------------------------------------

// --- parameters (mm) ---
base_r = 26;              // base radius
lift = 10;                // lift height above the base radius
