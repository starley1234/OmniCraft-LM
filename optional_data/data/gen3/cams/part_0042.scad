cam_profile = [[26, 0], [25.901, 2.266], [25.605, 4.515], [25.114, 6.729], [24.432, 8.893], [23.564, 10.988], [22.517, 13], [21.298, 14.913], [19.917, 16.712], [18.385, 18.385], [16.712, 19.917], [14.913, 21.298], [13, 22.517], [10.988, 23.564], [8.893, 24.432], [6.729, 25.114], [4.515, 25.605], [2.266, 25.901], [0, 26], [-2.285, 26.122], [-4.666, 26.461], [-7.217, 26.932], [-9.978, 27.414], [-12.943, 27.757], [-16.056, 27.81], [-19.215, 27.442], [-22.282, 26.555], [-25.106, 25.106], [-27.535, 23.104], [-29.489, 20.649], [-31.177, 18], [-32.627, 15.214], [-33.829, 12.313], [-34.773, 9.317], [-35.453, 6.251], [-35.863, 3.138], [-36, 0], [-35.863, -3.138], [-35.398, -6.242], [-34.295, -9.189], [-32.575, -11.856], [-30.361, -14.158], [-27.81, -16.056], [-25.088, -17.567], [-22.348, -18.752], [-19.716, -19.716], [-17.271, -20.583], [-15.04, -21.48], [-13, -22.517], [-10.988, -23.564], [-8.893, -24.432], [-6.729, -25.114], [-4.515, -25.605], [-2.266, -25.901], [0, -26], [2.266, -25.901], [4.515, -25.605], [6.729, -25.114], [8.893, -24.432], [10.988, -23.564], [13, -22.517], [14.913, -21.298], [16.712, -19.917], [18.385, -18.385], [19.917, -16.712], [21.298, -14.913], [22.517, -13], [23.564, -10.988], [24.432, -8.893], [25.114, -6.729], [25.605, -4.515], [25.901, -2.266]];

difference() {
  union() {
    linear_extrude(height = cam_t) polygon(cam_profile);
    /* hub, proud of the cam plate on both sides */
    translate([0, 0, -5]) cylinder(h = hub_h, d = hub_d);
