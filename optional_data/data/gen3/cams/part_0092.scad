$fn = 32;

// ----------------------------------------------------------------------
// Cam: base radius 20 mm with a 12 mm lift over 150 degrees
// ----------------------------------------------------------------------

// --- parameters (mm) ---
base_r = 20;              // base radius
lift = 12;                // lift height above the base radius
lift_span = 150;          // angular width of the lift
lift_start = 30;          // angle where the lift starts
cam_t = 8;                // cam plate thickness
hub_d = 17;               // hub diameter
hub_h = 16;               // hub height
bore_d = 12.7;            // bore
key_w = 6;                // keyway width
key_depth = 1.6;          // keyway depth

cam_profile = [[20, 0], [19.924, 1.743], [19.696, 3.473], [19.319, 5.176], [18.794, 6.84], [18.126, 8.452], [17.321, 10], [16.49, 11.547], [15.718, 13.189], [14.952, 14.952], [14.132, 16.842], [13.192, 18.84], [12.073, 20.911], [10.723, 22.996], [9.107, 25.021], [7.209, 26.905], [5.036, 28.559], [2.616, 29.901], [0, 30.854], [-2.744, 31.361], [-5.534, 31.385], [-8.282, 30.91], [-10.9, 29.947], [-13.305, 28.532], [-15.427, 26.72], [-17.216, 24.587], [-18.641, 22.215], [-19.696, 19.696], [-20.398, 17.116], [-20.784, 14.553], [-20.911, 12.073], [-20.845, 9.72], [-20.659, 7.519], [-20.425, 5.473], [-20.207, 3.563], [-20.055, 1.755], [-20, 0], [-19.924, -1.743], [-19.696, -3.473], [-19.319, -5.176], [-18.794, -6.84], [-18.126, -8.452], [-17.321, -10], [-16.383, -11.472], [-15.321, -12.856], [-14.142, -14.142], [-12.856, -15.321], [-11.472, -16.383], [-10, -17.321], [-8.452, -18.126], [-6.84, -18.794], [-5.176, -19.319], [-3.473, -19.696], [-1.743, -19.924], [0, -20], [1.743, -19.924], [3.473, -19.696], [5.176, -19.319], [6.84, -18.794], [8.452, -18.126], [10, -17.321], [11.472, -16.383], [12.856, -15.321], [14.142, -14.142], [15.321, -12.856], [16.383, -11.472], [17.321, -10], [18.126, -8.452], [18.794, -6.84], [19.319, -5.176], [19.696, -3.473], [19.924, -1.743]];

difference() {
  union() {
    linear_extrude(height = cam_t) polygon(cam_profile);
    /* hub, proud of the cam plate on both sides */
    translate([0, 0, -4]) cylinder(h = hub_h, d = hub_d);
  }
  /* bore through the hub, 2.5 mm clear on both faces */
  translate([0, 0, -6.5]) cylinder(h = hub_h + 5, d = bore_d);
  /* keyway, milled through the whole hub */
  translate([4.75, -3, -6.5]) cube([4.1, 6, 21]);
}
