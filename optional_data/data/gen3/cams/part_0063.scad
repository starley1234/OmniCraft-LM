cam_profile = [[18, 0], [18.007, 1.575], [18.023, 3.178], [18.034, 4.832], [18.014, 6.556], [17.932, 8.362], [17.754, 10.25], [17.44, 12.211], [16.954, 14.226], [16.263, 16.263], [15.342, 18.284], [14.173, 20.241], [12.75, 22.084], [11.078, 23.758], [9.176, 25.212], [7.074, 26.399], [4.81, 27.278], [2.434, 27.818], [0, 28], [-2.434, 27.818], [-4.81, 27.278], [-7.074, 26.399], [-9.176, 25.212], [-11.078, 23.758], [-12.75, 22.084], [-14.173, 20.241], [-15.342, 18.284], [-16.263, 16.263], [-16.954, 14.226], [-17.44, 12.211], [-17.754, 10.25], [-17.932, 8.362], [-18.014, 6.556], [-18.034, 4.832], [-18.023, 3.178], [-18.007, 1.575], [-18, 0], [-17.932, -1.569], [-17.727, -3.126], [-17.387, -4.659], [-16.914, -6.156], [-16.314, -7.607], [-15.588, -9], [-14.745, -10.324], [-13.789, -11.57], [-12.728, -12.728], [-11.57, -13.789], [-10.324, -14.745], [-9, -15.588], [-7.607, -16.314], [-6.156, -16.914], [-4.659, -17.387], [-3.126, -17.727], [-1.569, -17.932], [0, -18], [1.569, -17.932], [3.126, -17.727], [4.659, -17.387], [6.156, -16.914], [7.607, -16.314], [9, -15.588], [10.324, -14.745], [11.57, -13.789], [12.728, -12.728], [13.789, -11.57], [14.745, -10.324], [15.588, -9], [16.314, -7.607], [16.914, -6.156], [17.387, -4.659], [17.727, -3.126], [17.932, -1.569]];

difference() {
  union() {
    linear_extrude(height = cam_t) polygon(cam_profile);
    /* hub, proud of the cam plate on both sides */
    translate([0, 0, -5]) cylinder(h = hub_h, d = hub_d);
  }
  /* bore through the hub, 2.5 mm clear on both faces */
  translate([0, 0, -7.5]) cylinder(h = hub_h + 5, d = bore_d);
  /* keyway, milled through the whole hub */
  translate([4.75, -3, -7.5]) cube([4.1, 6, 27]);
