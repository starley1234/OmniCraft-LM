$fn = 32;

// ----------------------------------------------------------------------
// Cam: base radius 18 mm with a 10 mm lift over 180 degrees
// ----------------------------------------------------------------------

// --- parameters (mm) ---
base_r = 18;              // base radius
lift = 10;                // lift height above the base radius
lift_span = 180;          // angular width of the lift
lift_start = 0;           // angle where the lift starts
cam_t = 12;               // cam plate thickness
hub_d = 15.3;             // hub diameter
hub_h = 22;               // hub height
bore_d = 12.7;            // bore
key_w = 6;                // keyway width
