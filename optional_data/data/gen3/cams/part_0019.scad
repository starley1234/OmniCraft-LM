cam_profile = [[18, 0], [17.932, 1.569], [17.727, 3.126], [17.387, 4.659], [16.914, 6.156], [16.314, 7.607], [15.588, 9], [14.816, 10.375], [14.054, 11.792], [13.268, 13.268], [12.421, 14.803], [11.472, 16.383], [10.382, 17.982], [9.121, 19.56], [7.667, 21.066], [6.014, 22.444], [4.168, 23.635], [2.151, 24.583], [0, 25.236], [-2.236, 25.557], [-4.5, 25.519], [-6.729, 25.114], [-8.863, 24.35], [-10.842, 23.251], [-12.618, 21.855], [-14.154, 20.214], [-15.427, 18.385], [-16.43, 16.43], [-17.173, 14.41], [-17.679, 12.379], [-17.982, 10.382], [-18.126, 8.452], [-18.158, 6.609], [-18.125, 4.856], [-18.067, 3.186], [-18.019, 1.576], [-18, 0], [-17.932, -1.569], [-17.727, -3.126], [-17.387, -4.659], [-16.914, -6.156], [-16.314, -7.607], [-15.588, -9], [-14.745, -10.324], [-13.789, -11.57], [-12.728, -12.728], [-11.57, -13.789], [-10.324, -14.745], [-9, -15.588], [-7.607, -16.314], [-6.156, -16.914], [-4.659, -17.387], [-3.126, -17.727], [-1.569, -17.932], [0, -18], [1.569, -17.932], [3.126, -17.727], [4.659, -17.387], [6.156, -16.914], [7.607, -16.314], [9, -15.588], [10.324, -14.745], [11.57, -13.789], [12.728, -12.728], [13.789, -11.57], [14.745, -10.324], [15.588, -9], [16.314, -7.607], [16.914, -6.156], [17.387, -4.659], [17.727, -3.126], [17.932, -1.569]];

difference() {
  union() {
    linear_extrude(height = cam_t) polygon(cam_profile);
    /* hub, proud of the cam plate on both sides */
    translate([0, 0, -5]) cylinder(h = hub_h, d = hub_d);
