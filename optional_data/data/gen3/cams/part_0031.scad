cam_profile = [[18, 0], [17.932, 1.569], [17.727, 3.126], [17.387, 4.659], [16.914, 6.156], [16.314, 7.607], [15.588, 9], [14.745, 10.324], [13.789, 11.57], [12.728, 12.728], [11.57, 13.789], [10.324, 14.745], [9, 15.588], [7.607, 16.314], [6.156, 16.914], [4.659, 17.387], [3.126, 17.727], [1.569, 17.932], [0, 18], [-1.594, 18.217], [-3.318, 18.815], [-5.264, 19.645], [-7.459, 20.494], [-9.851, 21.124], [-12.31, 21.321], [-14.658, 20.934], [-16.701, 19.903], [-18.27, 18.27], [-19.262, 16.162], [-19.66, 13.766], [-19.546, 11.285], [-19.084, 8.899], [-18.493, 6.731], [-18, 4.823], [-17.798, 3.138], [-17.932, 1.569], [-18, 0], [-17.932, -1.569], [-17.727, -3.126], [-17.387, -4.659], [-16.914, -6.156], [-16.314, -7.607], [-15.588, -9], [-14.745, -10.324], [-13.789, -11.57], [-12.728, -12.728], [-11.57, -13.789], [-10.324, -14.745], [-9, -15.588], [-7.607, -16.314], [-6.156, -16.914], [-4.659, -17.387], [-3.126, -17.727], [-1.569, -17.932], [0, -18], [1.594, -18.217], [3.318, -18.815], [5.264, -19.645], [7.459, -20.494], [9.851, -21.124], [12.31, -21.321], [14.658, -20.934], [16.701, -19.903], [18.27, -18.27], [19.262, -16.162], [19.66, -13.766], [19.546, -11.285], [19.084, -8.899], [18.493, -6.731], [18, -4.823], [17.798, -3.138], [17.932, -1.569]];

difference() {
  union() {
    linear_extrude(height = cam_t) polygon(cam_profile);
    /* hub, proud of the cam plate on both sides */
    translate([0, 0, -5]) cylinder(h = hub_h, d = hub_d);
