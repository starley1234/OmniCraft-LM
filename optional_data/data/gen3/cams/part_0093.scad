cam_profile = [[24, 0], [23.909, 2.092], [23.635, 4.168], [23.182, 6.212], [22.553, 8.208], [21.751, 10.143], [20.785, 12], [19.799, 13.864], [18.898, 15.857], [18.006, 18.006], [17.034, 20.3], [15.891, 22.695], [14.5, 25.115], [12.803, 27.456], [10.774, 29.6], [8.421, 31.427], [5.788, 32.824], [2.948, 33.701], [0, 34], [-2.948, 33.701], [-5.788, 32.824], [-8.421, 31.427], [-10.774, 29.6], [-12.803, 27.456], [-14.5, 25.115], [-15.891, 22.695], [-17.034, 20.3], [-18.006, 18.006], [-18.898, 15.857], [-19.799, 13.864], [-20.785, 12], [-21.751, 10.143], [-22.553, 8.208], [-23.182, 6.212], [-23.635, 4.168], [-23.909, 2.092], [-24, 0], [-23.909, -2.092], [-23.635, -4.168], [-23.182, -6.212], [-22.553, -8.208], [-21.751, -10.143], [-20.785, -12], [-19.66, -13.766], [-18.385, -15.427], [-16.971, -16.971], [-15.427, -18.385], [-13.766, -19.66], [-12, -20.785], [-10.143, -21.751], [-8.208, -22.553], [-6.212, -23.182], [-4.168, -23.635], [-2.092, -23.909], [0, -24], [2.092, -23.909], [4.168, -23.635], [6.212, -23.182], [8.208, -22.553], [10.143, -21.751], [12, -20.785], [13.766, -19.66], [15.427, -18.385], [16.971, -16.971], [18.385, -15.427], [19.66, -13.766], [20.785, -12], [21.751, -10.143], [22.553, -8.208], [23.182, -6.212], [23.635, -4.168], [23.909, -2.092]];

difference() {
  union() {
    linear_extrude(height = cam_t) polygon(cam_profile);
    /* hub, proud of the cam plate on both sides */
    translate([0, 0, -6]) cylinder(h = hub_h, d = hub_d);
