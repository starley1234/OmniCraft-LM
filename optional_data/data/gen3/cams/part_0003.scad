$fn = 32;

// ----------------------------------------------------------------------
// Cam: base radius 20 mm with a 8 mm lift over 120 degrees
// ----------------------------------------------------------------------

// --- parameters (mm) ---
base_r = 20;              // base radius
lift = 8;                 // lift height above the base radius
lift_span = 120;          // angular width of the lift
lift_start = 0;           // angle where the lift starts
cam_t = 10;               // cam plate thickness
hub_d = 17;               // hub diameter
hub_h = 18;               // hub height
bore_d = 12.7;            // bore
key_w = 5;                // keyway width
key_depth = 1.6;          // keyway depth

cam_profile = [[20, 0], [20.06, 1.755], [20.224, 3.566], [20.45, 5.48], [20.673, 7.524], [20.813, 9.705], [20.785, 12], [20.508, 14.36], [19.917, 16.712], [18.971, 18.971], [17.654, 21.039], [15.982, 22.825], [14, 24.249], [11.776, 25.253], [9.393, 25.808], [6.944, 25.914], [4.515, 25.605], [2.182, 24.94], [0, 24], [-2.002, 22.877], [-3.82, 21.666], [-5.48, 20.45], [-7.024, 19.297], [-8.51, 18.25], [-10, 17.321], [-11.472, 16.383], [-12.856, 15.321], [-14.142, 14.142], [-15.321, 12.856], [-16.383, 11.472], [-17.321, 10], [-18.126, 8.452], [-18.794, 6.84], [-19.319, 5.176], [-19.696, 3.473], [-19.924, 1.743], [-20, 0], [-19.924, -1.743], [-19.696, -3.473], [-19.319, -5.176], [-18.794, -6.84], [-18.126, -8.452], [-17.321, -10], [-16.383, -11.472], [-15.321, -12.856], [-14.142, -14.142], [-12.856, -15.321], [-11.472, -16.383], [-10, -17.321], [-8.452, -18.126], [-6.84, -18.794], [-5.176, -19.319], [-3.473, -19.696], [-1.743, -19.924], [0, -20], [1.743, -19.924], [3.473, -19.696], [5.176, -19.319], [6.84, -18.794], [8.452, -18.126], [10, -17.321], [11.472, -16.383], [12.856, -15.321], [14.142, -14.142], [15.321, -12.856], [16.383, -11.472], [17.321, -10], [18.126, -8.452], [18.794, -6.84], [19.319, -5.176], [19.696, -3.473], [19.924, -1.743]];

difference() {
  union() {
    linear_extrude(height = cam_t) polygon(cam_profile);
    /* hub, proud of the cam plate on both sides */
    translate([0, 0, -4]) cylinder(h = hub_h, d = hub_d);
  }
  /* bore through the hub, 2.5 mm clear on both faces */
  translate([0, 0, -6.5]) cylinder(h = hub_h + 5, d = bore_d);
  /* keyway, milled through the whole hub */
  translate([4.75, -2.5, -6.5]) cube([4.1, 5, 23]);
}
