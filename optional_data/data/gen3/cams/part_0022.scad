$fn = 32;

// ----------------------------------------------------------------------
// Cam: base radius 26 mm with a 8 mm lift over 180 degrees
// ----------------------------------------------------------------------

// --- parameters (mm) ---
base_r = 26;              // base radius
lift = 8;                 // lift height above the base radius
lift_span = 180;          // angular width of the lift
lift_start = 45;          // angle where the lift starts
cam_t = 12;               // cam plate thickness
hub_d = 22.1;             // hub diameter
hub_h = 20;               // hub height
bore_d = 12.7;            // bore
key_w = 4;                // keyway width
key_depth = 2;            // keyway depth

cam_profile = [[26, 0], [25.901, 2.266], [25.605, 4.515], [25.114, 6.729], [24.432, 8.893], [23.564, 10.988], [22.517, 13], [21.298, 14.913], [19.917, 16.712], [18.385, 18.385], [16.752, 19.964], [15.051, 21.496], [13.268, 22.981], [11.384, 24.412], [9.381, 25.775], [7.247, 27.046], [4.972, 28.197], [2.554, 29.194], [0, 30], [-2.675, 30.578], [-5.447, 30.892], [-8.282, 30.91], [-11.14, 30.607], [-13.974, 29.966], [-16.732, 28.981], [-19.363, 27.654], [-21.816, 25.999], [-24.042, 24.042], [-25.999, 21.816], [-27.654, 19.363], [-28.981, 16.732], [-29.966, 13.974], [-30.607, 11.14], [-30.91, 8.282], [-30.892, 5.447], [-30.578, 2.675], [-30, 0], [-29.194, -2.554], [-28.197, -4.972], [-27.046, -7.247], [-25.775, -9.381], [-24.412, -11.384], [-22.981, -13.268], [-21.496, -15.051], [-19.964, -16.752], [-18.385, -18.385], [-16.712, -19.917], [-14.913, -21.298], [-13, -22.517], [-10.988, -23.564], [-8.893, -24.432], [-6.729, -25.114], [-4.515, -25.605], [-2.266, -25.901], [0, -26], [2.266, -25.901], [4.515, -25.605], [6.729, -25.114], [8.893, -24.432], [10.988, -23.564], [13, -22.517], [14.913, -21.298], [16.712, -19.917], [18.385, -18.385], [19.917, -16.712], [21.298, -14.913], [22.517, -13], [23.564, -10.988], [24.432, -8.893], [25.114, -6.729], [25.605, -4.515], [25.901, -2.266]];

difference() {
  union() {
    linear_extrude(height = cam_t) polygon(cam_profile);
    /* hub, proud of the cam plate on both sides */
    translate([0, 0, -4]) cylinder(h = hub_h, d = hub_d);
  }
  /* bore through the hub, 2.5 mm clear on both faces */
  translate([0, 0, -6.5]) cylinder(h = hub_h + 5, d = bore_d);
  /* keyway, milled through the whole hub */
  translate([4.35, -2, -6.5]) cube([4.5, 4, 25]);
}
