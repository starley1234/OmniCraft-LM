cam_profile = [[26, 0], [26.199, 2.292], [26.756, 4.718], [27.548, 7.381], [28.396, 10.335], [29.088, 13.564], [29.412, 16.981], [29.189, 20.439], [28.299, 23.746], [26.698, 26.698], [24.424, 29.107], [21.588, 30.831], [18.358, 31.797], [14.928, 32.014], [11.491, 31.573], [8.208, 30.634], [5.185, 29.405], [2.459, 28.109], [0, 26.952], [-2.283, 26.093], [-4.515, 25.605], [-6.729, 25.114], [-8.893, 24.432], [-10.988, 23.564], [-13, 22.517], [-14.913, 21.298], [-16.712, 19.917], [-18.385, 18.385], [-19.917, 16.712], [-21.298, 14.913], [-22.517, 13], [-23.564, 10.988], [-24.432, 8.893], [-25.114, 6.729], [-25.605, 4.515], [-25.901, 2.266], [-26, 0], [-26.199, -2.292], [-26.756, -4.718], [-27.548, -7.381], [-28.396, -10.335], [-29.088, -13.564], [-29.412, -16.981], [-29.189, -20.439], [-28.299, -23.746], [-26.698, -26.698], [-24.424, -29.107], [-21.588, -30.831], [-18.358, -31.797], [-14.928, -32.014], [-11.491, -31.573], [-8.208, -30.634], [-5.185, -29.405], [-2.459, -28.109], [0, -26.952], [2.283, -26.093], [4.515, -25.605], [6.729, -25.114], [8.893, -24.432], [10.988, -23.564], [13, -22.517], [14.913, -21.298], [16.712, -19.917], [18.385, -18.385], [19.917, -16.712], [21.298, -14.913], [22.517, -13], [23.564, -10.988], [24.432, -8.893], [25.114, -6.729], [25.605, -4.515], [25.901, -2.266]];

difference() {
  union() {
    linear_extrude(height = cam_t) polygon(cam_profile);
    /* hub, proud of the cam plate on both sides */
    translate([0, 0, -4]) cylinder(h = hub_h, d = hub_d);
  }
  /* bore through the hub, 2.5 mm clear on both faces */
  translate([0, 0, -6.5]) cylinder(h = hub_h + 5, d = bore_d);
  /* keyway, milled through the whole hub */
  translate([4.35, -2, -6.5]) cube([4.5, 4, 23]);
}
