$fn = 32;

// ----------------------------------------------------------------------
// Cam: base radius 24 mm with a 12 mm lift over 180 degrees
// ----------------------------------------------------------------------

// --- parameters (mm) ---
base_r = 24;              // base radius
lift = 12;                // lift height above the base radius
