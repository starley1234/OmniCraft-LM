cam_profile = [[24, 0], [23.909, 2.092], [23.635, 4.168], [23.182, 6.212], [22.553, 8.208], [21.751, 10.143], [20.785, 12], [19.66, 13.766], [18.385, 15.427], [16.971, 16.971], [15.485, 18.455], [13.973, 19.956], [12.402, 21.481], [10.736, 23.024], [8.942, 24.567], [6.988, 26.08], [4.853, 27.523], [2.524, 28.848], [0, 30], [-2.705, 30.924], [-5.566, 31.565], [-8.541, 31.876], [-11.58, 31.815], [-14.621, 31.355], [-17.598, 30.481], [-20.441, 29.193], [-23.082, 27.508], [-25.456, 25.456], [-27.508, 23.082], [-29.193, 20.441], [-30.481, 17.598], [-31.355, 14.621], [-31.815, 11.58], [-31.876, 8.541], [-31.565, 5.566], [-30.924, 2.705], [-30, 0], [-28.848, -2.524], [-27.523, -4.853], [-26.08, -6.988], [-24.567, -8.942], [-23.024, -10.736], [-21.481, -12.402], [-19.956, -13.973], [-18.455, -15.485], [-16.971, -16.971], [-15.427, -18.385], [-13.766, -19.66], [-12, -20.785], [-10.143, -21.751], [-8.208, -22.553], [-6.212, -23.182], [-4.168, -23.635], [-2.092, -23.909], [0, -24], [2.092, -23.909], [4.168, -23.635], [6.212, -23.182], [8.208, -22.553], [10.143, -21.751], [12, -20.785], [13.766, -19.66], [15.427, -18.385], [16.971, -16.971], [18.385, -15.427], [19.66, -13.766], [20.785, -12], [21.751, -10.143], [22.553, -8.208], [23.182, -6.212], [23.635, -4.168], [23.909, -2.092]];

difference() {
  union() {
    linear_extrude(height = cam_t) polygon(cam_profile);
    /* hub, proud of the cam plate on both sides */
    translate([0, 0, -5]) cylinder(h = hub_h, d = hub_d);
