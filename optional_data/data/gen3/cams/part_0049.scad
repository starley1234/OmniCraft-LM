cam_profile = [[18, 0], [17.932, 1.569], [17.727, 3.126], [17.387, 4.659], [16.914, 6.156], [16.314, 7.607], [15.588, 9], [14.745, 10.324], [13.789, 11.57], [12.728, 12.728], [11.723, 13.972], [10.862, 15.513], [10.025, 17.364], [9.086, 19.486], [7.931, 21.79], [6.47, 24.148], [4.656, 26.404], [2.484, 28.392], [0, 29.95], [-2.707, 30.944], [-5.515, 31.279], [-8.282, 30.91], [-10.863, 29.846], [-13.127, 28.152], [-14.975, 25.937], [-16.347, 23.346], [-17.234, 20.539], [-17.678, 17.678], [-17.763, 14.905], [-17.612, 12.332], [-17.364, 10.025], [-17.163, 8.003], [-17.139, 6.238], [-17.387, 4.659], [-17.727, 3.126], [-17.932, 1.569], [-18, 0], [-17.932, -1.569], [-17.727, -3.126], [-17.387, -4.659], [-16.914, -6.156], [-16.314, -7.607], [-15.588, -9], [-14.745, -10.324], [-13.789, -11.57], [-12.728, -12.728], [-11.57, -13.789], [-10.324, -14.745], [-9, -15.588], [-7.607, -16.314], [-6.156, -16.914], [-4.659, -17.387], [-3.126, -17.727], [-1.569, -17.932], [0, -18], [1.569, -17.932], [3.126, -17.727], [4.659, -17.387], [6.156, -16.914], [7.607, -16.314], [9, -15.588], [10.324, -14.745], [11.57, -13.789], [12.728, -12.728], [13.789, -11.57], [14.745, -10.324], [15.588, -9], [16.314, -7.607], [16.914, -6.156], [17.387, -4.659], [17.727, -3.126], [17.932, -1.569]];

difference() {
  union() {
    linear_extrude(height = cam_t) polygon(cam_profile);
    /* hub, proud of the cam plate on both sides */
    translate([0, 0, -6]) cylinder(h = hub_h, d = hub_d);
  }
  /* bore through the hub, 2.5 mm clear on both faces */
  translate([0, 0, -8.5]) cylinder(h = hub_h + 5, d = bore_d);
