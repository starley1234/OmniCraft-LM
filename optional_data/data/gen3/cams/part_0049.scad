$fn = 32;

// ----------------------------------------------------------------------
// Cam: base radius 18 mm with a 14 mm lift over 120 degrees
// ----------------------------------------------------------------------

// --- parameters (mm) ---
base_r = 18;              // base radius
lift = 14;                // lift height above the base radius
lift_span = 120;          // angular width of the lift
