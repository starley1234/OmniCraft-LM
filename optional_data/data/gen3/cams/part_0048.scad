$fn = 32;

// ----------------------------------------------------------------------
// Cam: base radius 24 mm with a 14 mm lift over 120 degrees
// ----------------------------------------------------------------------

// --- parameters (mm) ---
base_r = 24;              // base radius
lift = 14;                // lift height above the base radius
lift_span = 120;          // angular width of the lift
lift_start = 45;          // angle where the lift starts
cam_t = 8;                // cam plate thickness
hub_d = 20.4;             // hub diameter
hub_h = 18;               // hub height
bore_d = 12.7;            // bore
key_w = 5;                // keyway width
key_depth = 1.85;         // keyway depth

cam_profile = [[24, 0], [23.909, 2.092], [23.635, 4.168], [23.182, 6.212], [22.553, 8.208], [21.751, 10.143], [20.785, 12], [19.66, 13.766], [18.385, 15.427], [16.971, 16.971], [15.58, 18.568], [14.304, 20.428], [13.025, 22.56], [11.622, 24.923], [9.983, 27.428], [8.023, 29.944], [5.698, 32.313], [3.007, 34.369], [0, 35.95], [-3.23, 36.921], [-6.557, 37.188], [-9.835, 36.705], [-12.915, 35.484], [-15.663, 33.59], [-17.975, 31.133], [-19.788, 28.261], [-21.091, 25.135], [-21.92, 21.92], [-22.36, 18.762], [-22.527, 15.773], [-22.56, 13.025], [-22.601, 10.539], [-22.777, 8.29], [-23.182, 6.212], [-23.635, 4.168], [-23.909, 2.092], [-24, 0], [-23.909, -2.092], [-23.635, -4.168], [-23.182, -6.212], [-22.553, -8.208], [-21.751, -10.143], [-20.785, -12], [-19.66, -13.766], [-18.385, -15.427], [-16.971, -16.971], [-15.427, -18.385], [-13.766, -19.66], [-12, -20.785], [-10.143, -21.751], [-8.208, -22.553], [-6.212, -23.182], [-4.168, -23.635], [-2.092, -23.909], [0, -24], [2.092, -23.909], [4.168, -23.635], [6.212, -23.182], [8.208, -22.553], [10.143, -21.751], [12, -20.785], [13.766, -19.66], [15.427, -18.385], [16.971, -16.971], [18.385, -15.427], [19.66, -13.766], [20.785, -12], [21.751, -10.143], [22.553, -8.208], [23.182, -6.212], [23.635, -4.168], [23.909, -2.092]];

difference() {
  union() {
    linear_extrude(height = cam_t) polygon(cam_profile);
    /* hub, proud of the cam plate on both sides */
    translate([0, 0, -5]) cylinder(h = hub_h, d = hub_d);
  }
  /* bore through the hub, 2.5 mm clear on both faces */
  translate([0, 0, -7.5]) cylinder(h = hub_h + 5, d = bore_d);
  /* keyway, milled through the whole hub */
  translate([4.5, -2.5, -7.5]) cube([4.35, 5, 23]);
}
