$fn = 32;

// ----------------------------------------------------------------------
// Cam: base radius 20 mm with a 14 mm lift over 180 degrees
// ----------------------------------------------------------------------

// --- parameters (mm) ---
base_r = 20;              // base radius
lift = 14;                // lift height above the base radius
lift_span = 180;          // angular width of the lift
lift_start = 45;          // angle where the lift starts
cam_t = 10;               // cam plate thickness
hub_d = 19;               // hub diameter
hub_h = 22;               // hub height
bore_d = 9.53;            // bore
key_w = 4;                // keyway width
key_depth = 2;            // keyway depth

cam_profile = [[20, 0], [19.924, 1.743], [19.696, 3.473], [19.319, 5.176], [18.794, 6.84], [18.126, 8.452], [17.321, 10], [16.383, 11.472], [15.321, 12.856], [14.142, 14.142], [12.924, 15.402], [11.714, 16.729], [10.469, 18.133], [9.144, 19.61], [7.696, 21.144], [6.082, 22.699], [4.273, 24.232], [2.247, 25.686], [0, 27], [-2.459, 28.108], [-5.104, 28.948], [-7.894, 29.461], [-10.773, 29.6], [-13.677, 29.33], [-16.531, 28.633], [-19.259, 27.505], [-21.786, 25.964], [-24.042, 24.042], [-25.964, 21.786], [-27.505, 19.259], [-28.633, 16.531], [-29.33, 13.677], [-29.6, 10.773], [-29.461, 7.894], [-28.948, 5.104], [-28.108, 2.459], [-27, 0], [-25.686, -2.247], [-24.232, -4.273], [-22.699, -6.082], [-21.144, -7.696], [-19.61, -9.144], [-18.133, -10.469], [-16.729, -11.714], [-15.402, -12.924], [-14.142, -14.142], [-12.856, -15.321], [-11.472, -16.383], [-10, -17.321], [-8.452, -18.126], [-6.84, -18.794], [-5.176, -19.319], [-3.473, -19.696], [-1.743, -19.924], [0, -20], [1.743, -19.924], [3.473, -19.696], [5.176, -19.319], [6.84, -18.794], [8.452, -18.126], [10, -17.321], [11.472, -16.383], [12.856, -15.321], [14.142, -14.142], [15.321, -12.856], [16.383, -11.472], [17.321, -10], [18.126, -8.452], [18.794, -6.84], [19.319, -5.176], [19.696, -3.473], [19.924, -1.743]];

difference() {
  union() {
    linear_extrude(height = cam_t) polygon(cam_profile);
    /* hub, proud of the cam plate on both sides */
    translate([0, 0, -6]) cylinder(h = hub_h, d = hub_d);
  }
  /* bore through the hub, 2.5 mm clear on both faces */
  translate([0, 0, -8.5]) cylinder(h = hub_h + 5, d = bore_d);
  /* keyway, milled through the whole hub */
  translate([2.763, -2, -8.5]) cube([4.5, 4, 27]);
}
