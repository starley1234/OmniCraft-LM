$fn = 32;

// ----------------------------------------------------------------------
// Cam: base radius 20 mm with a 10 mm lift over 180 degrees
// ----------------------------------------------------------------------

// --- parameters (mm) ---
base_r = 20;              // base radius
lift = 10;                // lift height above the base radius
lift_span = 180;          // angular width of the lift
lift_start = 45;          // angle where the lift starts
cam_t = 12;               // cam plate thickness
hub_d = 17;               // hub diameter
hub_h = 24;               // hub height
bore_d = 12.7;            // bore
key_w = 5;                // keyway width
key_depth = 1.6;          // keyway depth

cam_profile = [[20, 0], [19.924, 1.743], [19.696, 3.473], [19.319, 5.176], [18.794, 6.84], [18.126, 8.452], [17.321, 10], [16.383, 11.472], [15.321, 12.856], [14.142, 14.142], [12.905, 15.379], [11.644, 16.63], [10.335, 17.901], [8.947, 19.186], [7.451, 20.472], [5.823, 21.733], [4.044, 22.936], [2.103, 24.04], [0, 25], [-2.255, 25.77], [-4.638, 26.304], [-7.118, 26.563], [-9.65, 26.512], [-12.184, 26.129], [-14.665, 25.401], [-17.034, 24.328], [-19.235, 22.923], [-21.213, 21.213], [-22.923, 19.235], [-24.328, 17.034], [-25.401, 14.665], [-26.129, 12.184], [-26.512, 9.65], [-26.563, 7.118], [-26.304, 4.638], [-25.77, 2.255], [-25, 0], [-24.04, -2.103], [-22.936, -4.044], [-21.733, -5.823], [-20.472, -7.451], [-19.186, -8.947], [-17.901, -10.335], [-16.63, -11.644], [-15.379, -12.905], [-14.142, -14.142], [-12.856, -15.321], [-11.472, -16.383], [-10, -17.321], [-8.452, -18.126], [-6.84, -18.794], [-5.176, -19.319], [-3.473, -19.696], [-1.743, -19.924], [0, -20], [1.743, -19.924], [3.473, -19.696], [5.176, -19.319], [6.84, -18.794], [8.452, -18.126], [10, -17.321], [11.472, -16.383], [12.856, -15.321], [14.142, -14.142], [15.321, -12.856], [16.383, -11.472], [17.321, -10], [18.126, -8.452], [18.794, -6.84], [19.319, -5.176], [19.696, -3.473], [19.924, -1.743]];

difference() {
  union() {
    linear_extrude(height = cam_t) polygon(cam_profile);
    /* hub, proud of the cam plate on both sides */
    translate([0, 0, -6]) cylinder(h = hub_h, d = hub_d);
  }
  /* bore through the hub, 2.5 mm clear on both faces */
  translate([0, 0, -8.5]) cylinder(h = hub_h + 5, d = bore_d);
  /* keyway, milled through the whole hub */
  translate([4.75, -2.5, -8.5]) cube([4.1, 5, 29]);
}
