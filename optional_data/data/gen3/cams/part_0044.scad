$fn = 32;

// ----------------------------------------------------------------------
// Cam: base radius 20 mm with a 12 mm lift over 180 degrees
// ----------------------------------------------------------------------

// --- parameters (mm) ---
base_r = 20;              // base radius
lift = 12;                // lift height above the base radius
lift_span = 180;          // angular width of the lift
lift_start = 45;          // angle where the lift starts
cam_t = 8;                // cam plate thickness
hub_d = 19;               // hub diameter
hub_h = 20;               // hub height
bore_d = 12.7;            // bore
key_w = 6;                // keyway width
key_depth = 1.6;          // keyway depth

cam_profile = [[20, 0], [19.924, 1.743], [19.696, 3.473], [19.319, 5.176], [18.794, 6.84], [18.126, 8.452], [17.321, 10], [16.383, 11.472], [15.321, 12.856], [14.142, 14.142], [12.914, 15.391], [11.679, 16.679], [10.402, 18.017], [9.046, 19.398], [7.573, 20.808], [5.953, 22.216], [4.159, 23.584], [2.175, 24.863], [0, 26], [-2.357, 26.939], [-4.871, 27.626], [-7.506, 28.012], [-10.212, 28.056], [-12.931, 27.73], [-15.598, 27.017], [-18.147, 25.916], [-20.511, 24.444], [-22.627, 22.627], [-24.444, 20.511], [-25.916, 18.147], [-27.017, 15.598], [-27.73, 12.931], [-28.056, 10.212], [-28.012, 7.506], [-27.626, 4.871], [-26.939, 2.357], [-26, 0], [-24.863, -2.175], [-23.584, -4.159], [-22.216, -5.953], [-20.808, -7.573], [-19.398, -9.046], [-18.017, -10.402], [-16.679, -11.679], [-15.391, -12.914], [-14.142, -14.142], [-12.856, -15.321], [-11.472, -16.383], [-10, -17.321], [-8.452, -18.126], [-6.84, -18.794], [-5.176, -19.319], [-3.473, -19.696], [-1.743, -19.924], [0, -20], [1.743, -19.924], [3.473, -19.696], [5.176, -19.319], [6.84, -18.794], [8.452, -18.126], [10, -17.321], [11.472, -16.383], [12.856, -15.321], [14.142, -14.142], [15.321, -12.856], [16.383, -11.472], [17.321, -10], [18.126, -8.452], [18.794, -6.84], [19.319, -5.176], [19.696, -3.473], [19.924, -1.743]];

difference() {
  union() {
    linear_extrude(height = cam_t) polygon(cam_profile);
    /* hub, proud of the cam plate on both sides */
    translate([0, 0, -6]) cylinder(h = hub_h, d = hub_d);
  }
  /* bore through the hub, 2.5 mm clear on both faces */
  translate([0, 0, -8.5]) cylinder(h = hub_h + 5, d = bore_d);
  /* keyway, milled through the whole hub */
  translate([4.75, -3, -8.5]) cube([4.1, 6, 25]);
}
