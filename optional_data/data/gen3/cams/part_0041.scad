cam_profile = [[23.111, 0], [22.14, 1.937], [21.666, 3.82], [21.25, 5.694], [20.673, 7.524], [19.939, 9.298], [19.053, 11], [18.021, 12.619], [16.853, 14.141], [15.556, 15.556], [14.141, 16.853], [12.619, 18.021], [11, 19.053], [9.298, 19.939], [7.524, 20.673], [5.694, 21.25], [3.82, 21.666], [1.917, 21.916], [0, 22], [-1.948, 22.264], [-4.057, 23.008], [-6.455, 24.09], [-9.208, 25.298], [-12.303, 26.384], [-15.645, 27.097], [-19.065, 27.228], [-22.347, 26.632], [-25.255, 25.255], [-27.575, 23.138], [-29.144, 20.407], [-29.88, 17.251], [-29.797, 13.895], [-29.004, 10.557], [-27.69, 7.42], [-26.099, 4.602], [-24.493, 2.143], [-23.111, 0], [-22.14, -1.937], [-21.666, -3.82], [-21.25, -5.694], [-20.673, -7.524], [-19.939, -9.298], [-19.053, -11], [-18.021, -12.619], [-16.853, -14.141], [-15.556, -15.556], [-14.141, -16.853], [-12.619, -18.021], [-11, -19.053], [-9.298, -19.939], [-7.524, -20.673], [-5.694, -21.25], [-3.82, -21.666], [-1.917, -21.916], [0, -22], [1.948, -22.264], [4.057, -23.008], [6.455, -24.09], [9.208, -25.298], [12.303, -26.384], [15.645, -27.097], [19.065, -27.228], [22.347, -26.632], [25.255, -25.255], [27.575, -23.138], [29.144, -20.407], [29.88, -17.251], [29.797, -13.895], [29.004, -10.557], [27.69, -7.42], [26.099, -4.602], [24.493, -2.143]];

difference() {
  union() {
    linear_extrude(height = cam_t) polygon(cam_profile);
    /* hub, proud of the cam plate on both sides */
    translate([0, 0, -4]) cylinder(h = hub_h, d = hub_d);
  }
  /* bore through the hub, 2.5 mm clear on both faces */
  translate([0, 0, -6.5]) cylinder(h = hub_h + 5, d = bore_d);
  /* keyway, milled through the whole hub */
  translate([2.263, -2.5, -6.5]) cube([5, 5, 21]);
