$fn = 32;

// ----------------------------------------------------------------------
// Cam: base radius 22 mm with a 14 mm lift over 180 degrees
// ----------------------------------------------------------------------

// --- parameters (mm) ---
base_r = 22;              // base radius
lift = 14;                // lift height above the base radius
lift_span = 180;          // angular width of the lift
lift_start = 90;          // angle where the lift starts
cam_t = 8;                // cam plate thickness
hub_d = 18.7;             // hub diameter
hub_h = 16;               // hub height
bore_d = 9.53;            // bore
key_w = 5;                // keyway width
