$fn = 32;

// ----------------------------------------------------------------------
// Cam: base radius 20 mm with a 14 mm lift over 180 degrees
// ----------------------------------------------------------------------

// --- parameters (mm) ---
base_r = 20;              // base radius
lift = 14;                // lift height above the base radius
lift_span = 180;          // angular width of the lift
lift_start = 30;          // angle where the lift starts
cam_t = 10;               // cam plate thickness
hub_d = 19;               // hub diameter
hub_h = 22;               // hub height
bore_d = 9.53;            // bore
key_w = 4;                // keyway width
key_depth = 2;            // keyway depth

cam_profile = [[20, 0], [19.924, 1.743], [19.696, 3.473], [19.319, 5.176], [18.794, 6.84], [18.126, 8.452], [17.321, 10], [16.47, 11.533], [15.644, 13.127], [14.805, 14.805], [13.908, 16.575], [12.906, 18.431], [11.75, 20.352], [10.399, 22.3], [8.819, 24.229], [6.988, 26.08], [4.9, 27.787], [2.562, 29.282], [0, 30.5], [-2.745, 31.38], [-5.62, 31.871], [-8.557, 31.936], [-11.484, 31.553], [-14.324, 30.718], [-17, 29.445], [-19.441, 27.764], [-21.583, 25.722], [-23.378, 23.378], [-24.791, 20.802], [-25.803, 18.067], [-26.414, 15.25], [-26.64, 12.423], [-26.514, 9.65], [-26.08, 6.988], [-25.393, 4.477], [-24.512, 2.145], [-23.5, 0], [-22.415, -1.961], [-21.309, -3.757], [-20.224, -5.419], [-19.191, -6.985], [-18.223, -8.497], [-17.321, -10], [-16.383, -11.472], [-15.321, -12.856], [-14.142, -14.142], [-12.856, -15.321], [-11.472, -16.383], [-10, -17.321], [-8.452, -18.126], [-6.84, -18.794], [-5.176, -19.319], [-3.473, -19.696], [-1.743, -19.924], [0, -20], [1.743, -19.924], [3.473, -19.696], [5.176, -19.319], [6.84, -18.794], [8.452, -18.126], [10, -17.321], [11.472, -16.383], [12.856, -15.321], [14.142, -14.142], [15.321, -12.856], [16.383, -11.472], [17.321, -10], [18.126, -8.452], [18.794, -6.84], [19.319, -5.176], [19.696, -3.473], [19.924, -1.743]];

difference() {
  union() {
    linear_extrude(height = cam_t) polygon(cam_profile);
    /* hub, proud of the cam plate on both sides */
    translate([0, 0, -6]) cylinder(h = hub_h, d = hub_d);
  }
  /* bore through the hub, 2.5 mm clear on both faces */
  translate([0, 0, -8.5]) cylinder(h = hub_h + 5, d = bore_d);
  /* keyway, milled through the whole hub */
  translate([2.763, -2, -8.5]) cube([4.5, 4, 27]);
}
