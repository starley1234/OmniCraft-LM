$fn = 32;

// ----------------------------------------------------------------------
// Cam: base radius 26 mm with a 10 mm lift over 180 degrees
// ----------------------------------------------------------------------

// --- parameters (mm) ---
base_r = 26;              // base radius
lift = 10;                // lift height above the base radius
lift_span = 180;          // angular width of the lift
lift_start = 30;          // angle where the lift starts
cam_t = 12;               // cam plate thickness
hub_d = 22.1;             // hub diameter
hub_h = 22;               // hub height
bore_d = 9.53;            // bore
key_w = 4;                // keyway width
key_depth = 2;            // keyway depth

cam_profile = [[26, 0], [25.901, 2.266], [25.605, 4.515], [25.114, 6.729], [24.432, 8.893], [23.564, 10.988], [22.517, 13], [21.36, 14.957], [20.148, 16.906], [18.858, 18.858], [17.464, 20.813], [15.937, 22.761], [14.25, 24.682], [12.378, 26.546], [10.306, 28.315], [8.023, 29.944], [5.534, 31.384], [2.851, 32.586], [0, 33.5], [-2.982, 34.084], [-6.048, 34.301], [-9.144, 34.126], [-12.21, 33.546], [-15.182, 32.558], [-18, 31.177], [-20.605, 29.427], [-22.947, 27.347], [-24.982, 24.982], [-26.681, 22.388], [-28.026, 19.624], [-29.012, 16.75], [-29.645, 13.824], [-29.946, 10.9], [-29.944, 8.023], [-29.674, 5.232], [-29.178, 2.553], [-28.5, 0], [-27.68, -2.422], [-26.757, -4.718], [-25.761, -6.903], [-24.715, -8.996], [-23.633, -11.02], [-22.517, -13], [-21.298, -14.913], [-19.917, -16.712], [-18.385, -18.385], [-16.712, -19.917], [-14.913, -21.298], [-13, -22.517], [-10.988, -23.564], [-8.893, -24.432], [-6.729, -25.114], [-4.515, -25.605], [-2.266, -25.901], [0, -26], [2.266, -25.901], [4.515, -25.605], [6.729, -25.114], [8.893, -24.432], [10.988, -23.564], [13, -22.517], [14.913, -21.298], [16.712, -19.917], [18.385, -18.385], [19.917, -16.712], [21.298, -14.913], [22.517, -13], [23.564, -10.988], [24.432, -8.893], [25.114, -6.729], [25.605, -4.515], [25.901, -2.266]];

difference() {
  union() {
    linear_extrude(height = cam_t) polygon(cam_profile);
    /* hub, proud of the cam plate on both sides */
    translate([0, 0, -5]) cylinder(h = hub_h, d = hub_d);
  }
  /* bore through the hub, 2.5 mm clear on both faces */
  translate([0, 0, -7.5]) cylinder(h = hub_h + 5, d = bore_d);
  /* keyway, milled through the whole hub */
  translate([2.763, -2, -7.5]) cube([4.5, 4, 27]);
}
