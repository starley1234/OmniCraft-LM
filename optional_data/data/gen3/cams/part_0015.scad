$fn = 32;

// ----------------------------------------------------------------------
// Cam: base radius 20 mm with a 8 mm lift over 180 degrees
// ----------------------------------------------------------------------

// --- parameters (mm) ---
base_r = 20;              // base radius
lift = 8;                 // lift height above the base radius
lift_span = 180;          // angular width of the lift
lift_start = 90;          // angle where the lift starts
cam_t = 8;                // cam plate thickness
hub_d = 17;               // hub diameter
hub_h = 18;               // hub height
bore_d = 12.7;            // bore
key_w = 6;                // keyway width
key_depth = 1.6;          // keyway depth

cam_profile = [[20.635, 0], [20.052, 1.754], [19.696, 3.473], [19.319, 5.176], [18.794, 6.84], [18.126, 8.452], [17.321, 10], [16.383, 11.472], [15.321, 12.856], [14.142, 14.142], [12.856, 15.321], [11.472, 16.383], [10, 17.321], [8.452, 18.126], [6.84, 18.794], [5.176, 19.319], [3.473, 19.696], [1.743, 19.924], [0, 20], [-1.761, 20.123], [-3.608, 20.463], [-5.611, 20.941], [-7.802, 21.437], [-10.17, 21.809], [-12.654, 21.918], [-15.155, 21.644], [-17.545, 20.909], [-19.684, 19.684], [-21.448, 17.997], [-22.739, 15.922], [-23.508, 13.572], [-23.759, 11.079], [-23.554, 8.573], [-22.998, 6.162], [-22.23, 3.92], [-21.396, 1.872], [-20.635, 0], [-20.052, -1.754], [-19.696, -3.473], [-19.319, -5.176], [-18.794, -6.84], [-18.126, -8.452], [-17.321, -10], [-16.383, -11.472], [-15.321, -12.856], [-14.142, -14.142], [-12.856, -15.321], [-11.472, -16.383], [-10, -17.321], [-8.452, -18.126], [-6.84, -18.794], [-5.176, -19.319], [-3.473, -19.696], [-1.743, -19.924], [0, -20], [1.761, -20.123], [3.608, -20.463], [5.611, -20.941], [7.802, -21.437], [10.17, -21.809], [12.654, -21.918], [15.155, -21.644], [17.545, -20.909], [19.684, -19.684], [21.448, -17.997], [22.739, -15.922], [23.508, -13.572], [23.759, -11.079], [23.554, -8.573], [22.998, -6.162], [22.23, -3.92], [21.396, -1.872]];

difference() {
  union() {
    linear_extrude(height = cam_t) polygon(cam_profile);
    /* hub, proud of the cam plate on both sides */
    translate([0, 0, -5]) cylinder(h = hub_h, d = hub_d);
  }
  /* bore through the hub, 2.5 mm clear on both faces */
  translate([0, 0, -7.5]) cylinder(h = hub_h + 5, d = bore_d);
  /* keyway, milled through the whole hub */
  translate([4.75, -3, -7.5]) cube([4.1, 6, 23]);
}
