cam_profile = [[22, 0], [21.916, 1.917], [21.666, 3.82], [21.25, 5.694], [20.673, 7.524], [19.939, 9.298], [19.053, 11], [18.021, 12.619], [16.853, 14.141], [15.556, 15.556], [14.141, 16.853], [12.619, 18.021], [11, 19.053], [9.298, 19.939], [7.524, 20.673], [5.694, 21.25], [3.82, 21.666], [1.917, 21.916], [0, 22], [-1.949, 22.273], [-4.06, 23.026], [-6.451, 24.074], [-9.153, 25.148], [-12.102, 25.952], [-15.137, 26.218], [-18.036, 25.758], [-20.555, 24.496], [-22.484, 22.484], [-23.694, 19.882], [-24.165, 16.921], [-23.999, 13.856], [-23.402, 10.913], [-22.646, 8.243], [-22.017, 5.899], [-21.755, 3.836], [-21.916, 1.917], [-22, 0], [-21.916, -1.917], [-21.666, -3.82], [-21.25, -5.694], [-20.673, -7.524], [-19.939, -9.298], [-19.053, -11], [-18.021, -12.619], [-16.853, -14.141], [-15.556, -15.556], [-14.141, -16.853], [-12.619, -18.021], [-11, -19.053], [-9.298, -19.939], [-7.524, -20.673], [-5.694, -21.25], [-3.82, -21.666], [-1.917, -21.916], [0, -22], [1.949, -22.273], [4.06, -23.026], [6.451, -24.074], [9.153, -25.148], [12.102, -25.952], [15.137, -26.218], [18.036, -25.758], [20.555, -24.496], [22.484, -22.484], [23.694, -19.882], [24.165, -16.921], [23.999, -13.856], [23.402, -10.913], [22.646, -8.243], [22.017, -5.899], [21.755, -3.836], [21.916, -1.917]];

difference() {
  union() {
    linear_extrude(height = cam_t) polygon(cam_profile);
