$fn = 32;

// ----------------------------------------------------------------------
// Cam: base radius 20 mm with a 14 mm lift over 150 degrees
// ----------------------------------------------------------------------

// --- parameters (mm) ---
base_r = 20;              // base radius
lift = 14;                // lift height above the base radius
lift_span = 150;          // angular width of the lift
lift_start = 30;          // angle where the lift starts
cam_t = 12;               // cam plate thickness
hub_d = 17;               // hub diameter
hub_h = 22;               // hub height
bore_d = 9.53;            // bore
key_w = 5;                // keyway width
key_depth = 1.74;         // keyway depth

cam_profile = [[20, 0], [19.924, 1.743], [19.696, 3.473], [19.319, 5.176], [18.794, 6.84], [18.126, 8.452], [17.321, 10], [16.508, 11.559], [15.784, 13.245], [15.087, 15.087], [14.345, 17.095], [13.479, 19.25], [12.418, 21.509], [11.101, 23.807], [9.485, 26.059], [7.548, 28.169], [5.296, 30.037], [2.761, 31.563], [0, 32.663], [-2.911, 33.268], [-5.877, 33.333], [-8.8, 32.841], [-11.576, 31.806], [-14.113, 30.266], [-16.332, 28.287], [-18.173, 25.954], [-19.605, 23.364], [-20.621, 20.621], [-21.244, 17.826], [-21.518, 15.067], [-21.509, 12.418], [-21.298, 9.932], [-20.97, 7.633], [-20.61, 5.522], [-20.292, 3.578], [-20.076, 1.756], [-20, 0], [-19.924, -1.743], [-19.696, -3.473], [-19.319, -5.176], [-18.794, -6.84], [-18.126, -8.452], [-17.321, -10], [-16.383, -11.472], [-15.321, -12.856], [-14.142, -14.142], [-12.856, -15.321], [-11.472, -16.383], [-10, -17.321], [-8.452, -18.126], [-6.84, -18.794], [-5.176, -19.319], [-3.473, -19.696], [-1.743, -19.924], [0, -20], [1.743, -19.924], [3.473, -19.696], [5.176, -19.319], [6.84, -18.794], [8.452, -18.126], [10, -17.321], [11.472, -16.383], [12.856, -15.321], [14.142, -14.142], [15.321, -12.856], [16.383, -11.472], [17.321, -10], [18.126, -8.452], [18.794, -6.84], [19.319, -5.176], [19.696, -3.473], [19.924, -1.743]];

difference() {
  union() {
    linear_extrude(height = cam_t) polygon(cam_profile);
    /* hub, proud of the cam plate on both sides */
    translate([0, 0, -5]) cylinder(h = hub_h, d = hub_d);
  }
  /* bore through the hub, 2.5 mm clear on both faces */
  translate([0, 0, -7.5]) cylinder(h = hub_h + 5, d = bore_d);
  /* keyway, milled through the whole hub */
  translate([3.022, -2.5, -7.5]) cube([4.24, 5, 27]);
}
