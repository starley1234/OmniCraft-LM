cam_profile = [[26, 0], [25.901, 2.266], [25.605, 4.515], [25.114, 6.729], [24.432, 8.893], [23.564, 10.988], [22.517, 13], [21.298, 14.913], [19.917, 16.712], [18.385, 18.385], [16.897, 20.137], [15.547, 22.203], [14.169, 24.542], [12.598, 27.017], [10.708, 29.42], [8.443, 31.508], [5.827, 33.046], [2.962, 33.853], [0, 33.838], [-2.889, 33.018], [-5.557, 31.514], [-7.912, 29.528], [-9.938, 27.305], [-11.698, 25.086], [-13.317, 23.067], [-14.954, 21.357], [-16.712, 19.917], [-18.385, 18.385], [-19.917, 16.712], [-21.298, 14.913], [-22.517, 13], [-23.564, 10.988], [-24.432, 8.893], [-25.114, 6.729], [-25.605, 4.515], [-25.901, 2.266], [-26, 0], [-25.901, -2.266], [-25.605, -4.515], [-25.114, -6.729], [-24.432, -8.893], [-23.564, -10.988], [-22.517, -13], [-21.298, -14.913], [-19.917, -16.712], [-18.385, -18.385], [-16.897, -20.137], [-15.547, -22.203], [-14.169, -24.542], [-12.598, -27.017], [-10.708, -29.42], [-8.443, -31.508], [-5.827, -33.046], [-2.962, -33.853], [0, -33.838], [2.889, -33.018], [5.557, -31.514], [7.912, -29.528], [9.938, -27.305], [11.698, -25.086], [13.317, -23.067], [14.954, -21.357], [16.712, -19.917], [18.385, -18.385], [19.917, -16.712], [21.298, -14.913], [22.517, -13], [23.564, -10.988], [24.432, -8.893], [25.114, -6.729], [25.605, -4.515], [25.901, -2.266]];

difference() {
  union() {
    linear_extrude(height = cam_t) polygon(cam_profile);
    /* hub, proud of the cam plate on both sides */
    translate([0, 0, -6]) cylinder(h = hub_h, d = hub_d);
