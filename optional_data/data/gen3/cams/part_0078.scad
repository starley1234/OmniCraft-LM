$fn = 32;

// ----------------------------------------------------------------------
// Cam: base radius 26 mm with a 8 mm lift over 150 degrees
// ----------------------------------------------------------------------

// --- parameters (mm) ---
base_r = 26;              // base radius
lift = 8;                 // lift height above the base radius
lift_span = 150;          // angular width of the lift
lift_start = 45;          // angle where the lift starts
cam_t = 8;                // cam plate thickness
hub_d = 24.7;             // hub diameter
hub_h = 20;               // hub height
bore_d = 12.7;            // bore
