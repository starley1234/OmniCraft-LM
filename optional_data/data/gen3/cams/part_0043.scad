cam_profile = [[26, 0], [25.901, 2.266], [25.605, 4.515], [25.114, 6.729], [24.432, 8.893], [23.564, 10.988], [22.517, 13], [21.444, 15.015], [20.45, 17.159], [19.45, 19.45], [18.344, 21.862], [17.036, 24.33], [15.445, 26.752], [13.524, 29.002], [11.263, 30.946], [8.697, 32.459], [5.896, 33.439], [2.963, 33.871], [0, 34], [-2.963, 33.871], [-5.904, 33.483], [-8.8, 32.841], [-11.629, 31.95], [-14.369, 30.814], [-17, 29.445], [-19.502, 27.851], [-21.826, 26.011], [-23.762, 23.762], [-25.228, 21.168], [-26.213, 18.354], [-26.752, 15.445], [-26.918, 12.552], [-26.818, 9.761], [-26.569, 7.119], [-26.289, 4.636], [-26.078, 2.282], [-26, 0], [-25.901, -2.266], [-25.605, -4.515], [-25.114, -6.729], [-24.432, -8.893], [-23.564, -10.988], [-22.517, -13], [-21.298, -14.913], [-19.917, -16.712], [-18.385, -18.385], [-16.712, -19.917], [-14.913, -21.298], [-13, -22.517], [-10.988, -23.564], [-8.893, -24.432], [-6.729, -25.114], [-4.515, -25.605], [-2.266, -25.901], [0, -26], [2.266, -25.901], [4.515, -25.605], [6.729, -25.114], [8.893, -24.432], [10.988, -23.564], [13, -22.517], [14.913, -21.298], [16.712, -19.917], [18.385, -18.385], [19.917, -16.712], [21.298, -14.913], [22.517, -13], [23.564, -10.988], [24.432, -8.893], [25.114, -6.729], [25.605, -4.515], [25.901, -2.266]];

difference() {
  union() {
    linear_extrude(height = cam_t) polygon(cam_profile);
