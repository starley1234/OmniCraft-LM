$fn = 32;

// ----------------------------------------------------------------------
// Cam: base radius 22 mm with a 14 mm lift over 120 degrees
// ----------------------------------------------------------------------

// --- parameters (mm) ---
base_r = 22;              // base radius
lift = 14;                // lift height above the base radius
