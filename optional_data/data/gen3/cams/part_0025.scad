cam_profile = [[22, 0], [21.916, 1.917], [21.666, 3.82], [21.25, 5.694], [20.673, 7.524], [19.939, 9.298], [19.053, 11], [18.021, 12.619], [16.853, 14.141], [15.556, 15.556], [14.295, 17.036], [13.157, 18.79], [12.025, 20.828], [10.777, 23.111], [9.299, 25.549], [7.506, 28.012], [5.35, 30.344], [2.833, 32.376], [0, 33.95], [-3.056, 34.929], [-6.21, 35.218], [-9.317, 34.773], [-12.231, 33.605], [-14.818, 31.777], [-16.975, 29.401], [-18.641, 26.622], [-19.805, 23.603], [-20.506, 20.506], [-20.827, 17.476], [-20.888, 14.626], [-20.828, 12.025], [-20.789, 9.694], [-20.897, 7.606], [-21.25, 5.694], [-21.666, 3.82], [-21.916, 1.917], [-22, 0], [-21.916, -1.917], [-21.666, -3.82], [-21.25, -5.694], [-20.673, -7.524], [-19.939, -9.298], [-19.053, -11], [-18.021, -12.619], [-16.853, -14.141], [-15.556, -15.556], [-14.141, -16.853], [-12.619, -18.021], [-11, -19.053], [-9.298, -19.939], [-7.524, -20.673], [-5.694, -21.25], [-3.82, -21.666], [-1.917, -21.916], [0, -22], [1.917, -21.916], [3.82, -21.666], [5.694, -21.25], [7.524, -20.673], [9.298, -19.939], [11, -19.053], [12.619, -18.021], [14.141, -16.853], [15.556, -15.556], [16.853, -14.141], [18.021, -12.619], [19.053, -11], [19.939, -9.298], [20.673, -7.524], [21.25, -5.694], [21.666, -3.82], [21.916, -1.917]];

difference() {
  union() {
    linear_extrude(height = cam_t) polygon(cam_profile);
