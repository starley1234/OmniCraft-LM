cam_profile = [[24, 0], [23.909, 2.092], [23.635, 4.168], [23.182, 6.212], [22.553, 8.208], [21.751, 10.143], [20.785, 12], [19.66, 13.766], [18.385, 15.427], [16.971, 16.971], [15.466, 18.432], [13.904, 19.857], [12.268, 21.249], [10.538, 22.6], [8.697, 23.895], [6.729, 25.114], [4.625, 26.227], [2.38, 27.202], [0, 28], [-2.501, 28.585], [-5.1, 28.922], [-7.765, 28.978], [-10.456, 28.727], [-13.128, 28.154], [-15.732, 27.249], [-18.216, 26.015], [-20.53, 24.467], [-22.627, 22.627], [-24.467, 20.53], [-26.015, 18.216], [-27.249, 15.732], [-28.154, 13.128], [-28.727, 10.456], [-28.978, 7.765], [-28.922, 5.1], [-28.585, 2.501], [-28, 0], [-27.202, -2.38], [-26.227, -4.625], [-25.114, -6.729], [-23.895, -8.697], [-22.6, -10.538], [-21.249, -12.268], [-19.857, -13.904], [-18.432, -15.466], [-16.971, -16.971], [-15.427, -18.385], [-13.766, -19.66], [-12, -20.785], [-10.143, -21.751], [-8.208, -22.553], [-6.212, -23.182], [-4.168, -23.635], [-2.092, -23.909], [0, -24], [2.092, -23.909], [4.168, -23.635], [6.212, -23.182], [8.208, -22.553], [10.143, -21.751], [12, -20.785], [13.766, -19.66], [15.427, -18.385], [16.971, -16.971], [18.385, -15.427], [19.66, -13.766], [20.785, -12], [21.751, -10.143], [22.553, -8.208], [23.182, -6.212], [23.635, -4.168], [23.909, -2.092]];

difference() {
  union() {
    linear_extrude(height = cam_t) polygon(cam_profile);
    /* hub, proud of the cam plate on both sides */
    translate([0, 0, -4]) cylinder(h = hub_h, d = hub_d);
  }
  /* bore through the hub, 2.5 mm clear on both faces */
  translate([0, 0, -6.5]) cylinder(h = hub_h + 5, d = bore_d);
  /* keyway, milled through the whole hub */
  translate([1.763, -3, -6.5]) cube([5.5, 6, 21]);
