$fn = 32;

// ----------------------------------------------------------------------
// Cam: base radius 24 mm with a 10 mm lift over 120 degrees
// ----------------------------------------------------------------------

// --- parameters (mm) ---
base_r = 24;              // base radius
lift = 10;                // lift height above the base radius
lift_span = 120;          // angular width of the lift
lift_start = 45;          // angle where the lift starts
cam_t = 12;               // cam plate thickness
hub_d = 22.8;             // hub diameter
hub_h = 20;               // hub height
bore_d = 12.7;            // bore
key_w = 6;                // keyway width
key_depth = 3;            // keyway depth

cam_profile = [[24, 0], [23.909, 2.092], [23.635, 4.168], [23.182, 6.212], [22.553, 8.208], [21.751, 10.143], [20.785, 12], [19.66, 13.766], [18.385, 15.427], [16.971, 16.971], [15.536, 18.516], [14.15, 20.208], [12.732, 22.053], [11.199, 24.017], [9.476, 26.035], [7.506, 28.012], [5.261, 29.834], [2.745, 31.38], [0, 32.536], [-2.905, 33.203], [-5.874, 33.316], [-8.8, 32.841], [-11.57, 31.789], [-14.086, 30.207], [-16.268, 28.177], [-18.068, 25.803], [-19.473, 23.207], [-20.506, 20.506], [-21.224, 17.809], [-21.708, 15.2], [-22.053, 12.732], [-22.358, 10.426], [-22.713, 8.267], [-23.182, 6.212], [-23.635, 4.168], [-23.909, 2.092], [-24, 0], [-23.909, -2.092], [-23.635, -4.168], [-23.182, -6.212], [-22.553, -8.208], [-21.751, -10.143], [-20.785, -12], [-19.66, -13.766], [-18.385, -15.427], [-16.971, -16.971], [-15.427, -18.385], [-13.766, -19.66], [-12, -20.785], [-10.143, -21.751], [-8.208, -22.553], [-6.212, -23.182], [-4.168, -23.635], [-2.092, -23.909], [0, -24], [2.092, -23.909], [4.168, -23.635], [6.212, -23.182], [8.208, -22.553], [10.143, -21.751], [12, -20.785], [13.766, -19.66], [15.427, -18.385], [16.971, -16.971], [18.385, -15.427], [19.66, -13.766], [20.785, -12], [21.751, -10.143], [22.553, -8.208], [23.182, -6.212], [23.635, -4.168], [23.909, -2.092]];

difference() {
  union() {
    linear_extrude(height = cam_t) polygon(cam_profile);
    /* hub, proud of the cam plate on both sides */
    translate([0, 0, -4]) cylinder(h = hub_h, d = hub_d);
  }
  /* bore through the hub, 2.5 mm clear on both faces */
  translate([0, 0, -6.5]) cylinder(h = hub_h + 5, d = bore_d);
  /* keyway, milled through the whole hub */
  translate([3.35, -3, -6.5]) cube([5.5, 6, 25]);
}
