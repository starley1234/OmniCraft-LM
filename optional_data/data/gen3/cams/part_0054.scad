$fn = 32;

// ----------------------------------------------------------------------
// Cam: base radius 18 mm with a 8 mm lift over 180 degrees
// ----------------------------------------------------------------------

// --- parameters (mm) ---
base_r = 18;              // base radius
lift = 8;                 // lift height above the base radius
lift_span = 180;          // angular width of the lift
lift_start = 45;          // angle where the lift starts
cam_t = 8;                // cam plate thickness
hub_d = 17.1;             // hub diameter
hub_h = 18;               // hub height
bore_d = 12.7;            // bore
key_w = 4;                // keyway width
key_depth = 1.6;          // keyway depth

cam_profile = [[18, 0], [17.932, 1.569], [17.727, 3.126], [17.387, 4.659], [16.914, 6.156], [16.314, 7.607], [15.588, 9], [14.745, 10.324], [13.789, 11.57], [12.728, 12.728], [11.699, 13.942], [10.771, 15.383], [9.84, 17.043], [8.796, 18.862], [7.546, 20.733], [6.033, 22.514], [4.241, 24.051], [2.205, 25.198], [0, 25.838], [-2.266, 25.899], [-4.473, 25.367], [-6.508, 24.287], [-8.282, 22.755], [-9.748, 20.905], [-10.905, 18.888], [-11.8, 16.852], [-12.52, 14.921], [-13.177, 13.177], [-13.887, 11.653], [-14.745, 10.324], [-15.588, 9], [-16.314, 7.607], [-16.914, 6.156], [-17.387, 4.659], [-17.727, 3.126], [-17.932, 1.569], [-18, 0], [-17.932, -1.569], [-17.727, -3.126], [-17.387, -4.659], [-16.914, -6.156], [-16.314, -7.607], [-15.588, -9], [-14.745, -10.324], [-13.789, -11.57], [-12.728, -12.728], [-11.699, -13.942], [-10.771, -15.383], [-9.84, -17.043], [-8.796, -18.862], [-7.546, -20.733], [-6.033, -22.514], [-4.241, -24.051], [-2.205, -25.198], [0, -25.838], [2.266, -25.899], [4.473, -25.367], [6.508, -24.287], [8.282, -22.755], [9.748, -20.905], [10.905, -18.888], [11.8, -16.852], [12.52, -14.921], [13.177, -13.177], [13.887, -11.653], [14.745, -10.324], [15.588, -9], [16.314, -7.607], [16.914, -6.156], [17.387, -4.659], [17.727, -3.126], [17.932, -1.569]];

difference() {
  union() {
    linear_extrude(height = cam_t) polygon(cam_profile);
    /* hub, proud of the cam plate on both sides */
    translate([0, 0, -5]) cylinder(h = hub_h, d = hub_d);
  }
  /* bore through the hub, 2.5 mm clear on both faces */
  translate([0, 0, -7.5]) cylinder(h = hub_h + 5, d = bore_d);
  /* keyway, milled through the whole hub */
  translate([4.75, -2, -7.5]) cube([4.1, 4, 23]);
}
