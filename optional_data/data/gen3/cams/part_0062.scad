$fn = 32;

// ----------------------------------------------------------------------
// Cam: base radius 24 mm with a 8 mm lift over 180 degrees
// ----------------------------------------------------------------------

// --- parameters (mm) ---
base_r = 24;              // base radius
lift = 8;                 // lift height above the base radius
lift_span = 180;          // angular width of the lift
lift_start = 0;           // angle where the lift starts
cam_t = 12;               // cam plate thickness
hub_d = 22.8;             // hub diameter
hub_h = 24;               // hub height
bore_d = 12.7;            // bore
key_w = 4;                // keyway width
key_depth = 2;            // keyway depth

cam_profile = [[24, 0], [24.108, 2.109], [24.402, 4.303], [24.805, 6.646], [25.195, 9.17], [25.434, 11.86], [25.382, 14.654], [24.921, 17.45], [23.973, 20.116], [22.513, 22.513], [20.568, 24.512], [18.216, 26.015], [15.572, 26.972], [12.77, 27.385], [9.941, 27.313], [7.198, 26.862], [4.614, 26.169], [2.221, 25.381], [0, 24.635], [-2.103, 24.036], [-4.168, 23.635], [-6.212, 23.182], [-8.208, 22.553], [-10.143, 21.751], [-12, 20.785], [-13.766, 19.66], [-15.427, 18.385], [-16.971, 16.971], [-18.385, 15.427], [-19.66, 13.766], [-20.785, 12], [-21.751, 10.143], [-22.553, 8.208], [-23.182, 6.212], [-23.635, 4.168], [-23.909, 2.092], [-24, 0], [-24.108, -2.109], [-24.402, -4.303], [-24.805, -6.646], [-25.195, -9.17], [-25.434, -11.86], [-25.382, -14.654], [-24.921, -17.45], [-23.973, -20.116], [-22.513, -22.513], [-20.568, -24.512], [-18.216, -26.015], [-15.572, -26.972], [-12.77, -27.385], [-9.941, -27.313], [-7.198, -26.862], [-4.614, -26.169], [-2.221, -25.381], [0, -24.635], [2.103, -24.036], [4.168, -23.635], [6.212, -23.182], [8.208, -22.553], [10.143, -21.751], [12, -20.785], [13.766, -19.66], [15.427, -18.385], [16.971, -16.971], [18.385, -15.427], [19.66, -13.766], [20.785, -12], [21.751, -10.143], [22.553, -8.208], [23.182, -6.212], [23.635, -4.168], [23.909, -2.092]];

difference() {
  union() {
    linear_extrude(height = cam_t) polygon(cam_profile);
    /* hub, proud of the cam plate on both sides */
    translate([0, 0, -6]) cylinder(h = hub_h, d = hub_d);
  }
  /* bore through the hub, 2.5 mm clear on both faces */
  translate([0, 0, -8.5]) cylinder(h = hub_h + 5, d = bore_d);
  /* keyway, milled through the whole hub */
  translate([4.35, -2, -8.5]) cube([4.5, 4, 29]);
}
