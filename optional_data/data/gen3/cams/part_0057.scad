$fn = 32;

// ----------------------------------------------------------------------
// Cam: base radius 18 mm with a 10 mm lift over 180 degrees
// ----------------------------------------------------------------------

// --- parameters (mm) ---
base_r = 18;              // base radius
lift = 10;                // lift height above the base radius
lift_span = 180;          // angular width of the lift
lift_start = 90;          // angle where the lift starts
cam_t = 12;               // cam plate thickness
hub_d = 15.3;             // hub diameter
hub_h = 20;               // hub height
bore_d = 12.7;            // bore
key_w = 5;                // keyway width
key_depth = 1.6;          // keyway depth

cam_profile = [[18, 0], [17.932, 1.569], [17.727, 3.126], [17.387, 4.659], [16.914, 6.156], [16.314, 7.607], [15.588, 9], [14.745, 10.324], [13.789, 11.57], [12.728, 12.728], [11.57, 13.789], [10.324, 14.745], [9, 15.588], [7.607, 16.314], [6.156, 16.914], [4.659, 17.387], [3.126, 17.727], [1.569, 17.932], [0, 18], [-1.575, 18.007], [-3.178, 18.023], [-4.832, 18.034], [-6.556, 18.014], [-8.362, 17.932], [-10.25, 17.754], [-12.211, 17.44], [-14.226, 16.954], [-16.263, 16.263], [-18.284, 15.342], [-20.241, 14.173], [-22.084, 12.75], [-23.758, 11.078], [-25.212, 9.176], [-26.399, 7.074], [-27.278, 4.81], [-27.818, 2.434], [-28, 0], [-27.818, -2.434], [-27.278, -4.81], [-26.399, -7.074], [-25.212, -9.176], [-23.758, -11.078], [-22.084, -12.75], [-20.241, -14.173], [-18.284, -15.342], [-16.263, -16.263], [-14.226, -16.954], [-12.211, -17.44], [-10.25, -17.754], [-8.362, -17.932], [-6.556, -18.014], [-4.832, -18.034], [-3.178, -18.023], [-1.575, -18.007], [0, -18], [1.569, -17.932], [3.126, -17.727], [4.659, -17.387], [6.156, -16.914], [7.607, -16.314], [9, -15.588], [10.324, -14.745], [11.57, -13.789], [12.728, -12.728], [13.789, -11.57], [14.745, -10.324], [15.588, -9], [16.314, -7.607], [16.914, -6.156], [17.387, -4.659], [17.727, -3.126], [17.932, -1.569]];

difference() {
  union() {
    linear_extrude(height = cam_t) polygon(cam_profile);
    /* hub, proud of the cam plate on both sides */
    translate([0, 0, -4]) cylinder(h = hub_h, d = hub_d);
  }
  /* bore through the hub, 2.5 mm clear on both faces */
  translate([0, 0, -6.5]) cylinder(h = hub_h + 5, d = bore_d);
  /* keyway, milled through the whole hub */
  translate([4.75, -2.5, -6.5]) cube([4.1, 5, 25]);
}
