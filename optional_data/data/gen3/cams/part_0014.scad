$fn = 32;

// ----------------------------------------------------------------------
// Cam: base radius 26 mm with a 10 mm lift over 120 degrees
// ----------------------------------------------------------------------

// --- parameters (mm) ---
base_r = 26;              // base radius
lift = 10;                // lift height above the base radius
lift_span = 120;          // angular width of the lift
lift_start = 90;          // angle where the lift starts
cam_t = 10;               // cam plate thickness
hub_d = 24.7;             // hub diameter
hub_h = 20;               // hub height
bore_d = 9.53;            // bore
key_w = 6;                // keyway width
key_depth = 3;            // keyway depth

cam_profile = [[26, 0], [25.901, 2.266], [25.605, 4.515], [25.114, 6.729], [24.432, 8.893], [23.564, 10.988], [22.517, 13], [21.298, 14.913], [19.917, 16.712], [18.385, 18.385], [16.712, 19.917], [14.913, 21.298], [13, 22.517], [10.988, 23.564], [8.893, 24.432], [6.729, 25.114], [4.515, 25.605], [2.266, 25.901], [0, 26], [-2.314, 26.455], [-4.879, 27.673], [-7.839, 29.256], [-11.162, 30.667], [-14.63, 31.375], [-17.899, 31.002], [-20.597, 29.415], [-22.453, 26.758], [-23.389, 23.389], [-23.565, 19.773], [-23.346, 16.347], [-23.204, 13.397], [-23.585, 10.998], [-24.432, 8.893], [-25.114, 6.729], [-25.605, 4.515], [-25.901, 2.266], [-26, 0], [-25.901, -2.266], [-25.605, -4.515], [-25.114, -6.729], [-24.432, -8.893], [-23.564, -10.988], [-22.517, -13], [-21.298, -14.913], [-19.917, -16.712], [-18.385, -18.385], [-16.712, -19.917], [-14.913, -21.298], [-13, -22.517], [-10.988, -23.564], [-8.893, -24.432], [-6.729, -25.114], [-4.515, -25.605], [-2.266, -25.901], [0, -26], [2.314, -26.455], [4.879, -27.673], [7.839, -29.256], [11.162, -30.667], [14.63, -31.375], [17.899, -31.002], [20.597, -29.415], [22.453, -26.758], [23.389, -23.389], [23.565, -19.773], [23.346, -16.347], [23.204, -13.397], [23.585, -10.998], [24.432, -8.893], [25.114, -6.729], [25.605, -4.515], [25.901, -2.266]];

difference() {
  union() {
    linear_extrude(height = cam_t) polygon(cam_profile);
    /* hub, proud of the cam plate on both sides */
    translate([0, 0, -5]) cylinder(h = hub_h, d = hub_d);
  }
  /* bore through the hub, 2.5 mm clear on both faces */
  translate([0, 0, -7.5]) cylinder(h = hub_h + 5, d = bore_d);
  /* keyway, milled through the whole hub */
  translate([1.763, -3, -7.5]) cube([5.5, 6, 25]);
}
