$fn = 32;

// ----------------------------------------------------------------------
// Cam: base radius 20 mm with a 8 mm lift over 150 degrees
// ----------------------------------------------------------------------

// --- parameters (mm) ---
base_r = 20;              // base radius
lift = 8;                 // lift height above the base radius
lift_span = 150;          // angular width of the lift
lift_start = 90;          // angle where the lift starts
cam_t = 10;               // cam plate thickness
hub_d = 17;               // hub diameter
hub_h = 22;               // hub height
bore_d = 12.7;            // bore
key_w = 4;                // keyway width
key_depth = 1.6;          // keyway depth

cam_profile = [[20, 0], [19.924, 1.743], [19.696, 3.473], [19.319, 5.176], [18.794, 6.84], [18.126, 8.452], [17.321, 10], [16.383, 11.472], [15.321, 12.856], [14.142, 14.142], [12.856, 15.321], [11.472, 16.383], [10, 17.321], [8.452, 18.126], [6.84, 18.794], [5.176, 19.319], [3.473, 19.696], [1.743, 19.924], [0, 20], [-1.751, 20.011], [-3.533, 20.037], [-5.374, 20.056], [-7.293, 20.038], [-9.298, 19.939], [-11.382, 19.714], [-13.526, 19.317], [-15.696, 18.705], [-17.845, 17.845], [-19.917, 16.712], [-21.852, 15.301], [-23.587, 13.618], [-25.063, 11.687], [-26.229, 9.547], [-27.046, 7.247], [-27.489, 4.847], [-27.549, 2.41], [-27.236, 0], [-26.575, -2.325], [-25.605, -4.515], [-24.376, -6.532], [-22.946, -8.351], [-21.372, -9.966], [-19.714, -11.382], [-18.021, -12.619], [-16.335, -13.706], [-14.682, -14.682], [-13.078, -15.586], [-11.522, -16.455], [-10, -17.321], [-8.452, -18.126], [-6.84, -18.794], [-5.176, -19.319], [-3.473, -19.696], [-1.743, -19.924], [0, -20], [1.743, -19.924], [3.473, -19.696], [5.176, -19.319], [6.84, -18.794], [8.452, -18.126], [10, -17.321], [11.472, -16.383], [12.856, -15.321], [14.142, -14.142], [15.321, -12.856], [16.383, -11.472], [17.321, -10], [18.126, -8.452], [18.794, -6.84], [19.319, -5.176], [19.696, -3.473], [19.924, -1.743]];

difference() {
  union() {
    linear_extrude(height = cam_t) polygon(cam_profile);
    /* hub, proud of the cam plate on both sides */
    translate([0, 0, -6]) cylinder(h = hub_h, d = hub_d);
  }
  /* bore through the hub, 2.5 mm clear on both faces */
  translate([0, 0, -8.5]) cylinder(h = hub_h + 5, d = bore_d);
  /* keyway, milled through the whole hub */
  translate([4.75, -2, -8.5]) cube([4.1, 4, 27]);
}
