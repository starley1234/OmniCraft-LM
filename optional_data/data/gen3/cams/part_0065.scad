$fn = 32;

// ----------------------------------------------------------------------
// Cam: base radius 22 mm with a 8 mm lift over 120 degrees
// ----------------------------------------------------------------------

// --- parameters (mm) ---
base_r = 22;              // base radius
lift = 8;                 // lift height above the base radius
lift_span = 120;          // angular width of the lift
lift_start = 90;          // angle where the lift starts
cam_t = 10;               // cam plate thickness
hub_d = 20.9;             // hub diameter
hub_h = 20;               // hub height
bore_d = 12.7;            // bore
key_w = 5;                // keyway width
key_depth = 2.1;          // keyway depth

cam_profile = [[22, 0], [21.916, 1.917], [21.666, 3.82], [21.25, 5.694], [20.673, 7.524], [19.939, 9.298], [19.053, 11], [18.021, 12.619], [16.853, 14.141], [15.556, 15.556], [14.141, 16.853], [12.619, 18.021], [11, 19.053], [9.298, 19.939], [7.524, 20.673], [5.694, 21.25], [3.82, 21.666], [1.917, 21.916], [0, 22], [-1.929, 22.052], [-3.913, 22.194], [-5.997, 22.382], [-8.208, 22.553], [-10.551, 22.626], [-13, 22.517], [-15.507, 22.146], [-17.998, 21.449], [-20.385, 20.385], [-22.571, 18.939], [-24.463, 17.129], [-25.981, 15], [-27.066, 12.621], [-27.687, 10.077], [-27.846, 7.461], [-27.575, 4.862], [-26.932, 2.356], [-26, 0], [-24.87, -2.176], [-23.635, -4.168], [-22.382, -5.997], [-21.177, -7.708], [-20.062, -9.355], [-19.053, -11], [-18.021, -12.619], [-16.853, -14.141], [-15.556, -15.556], [-14.141, -16.853], [-12.619, -18.021], [-11, -19.053], [-9.298, -19.939], [-7.524, -20.673], [-5.694, -21.25], [-3.82, -21.666], [-1.917, -21.916], [0, -22], [1.917, -21.916], [3.82, -21.666], [5.694, -21.25], [7.524, -20.673], [9.298, -19.939], [11, -19.053], [12.619, -18.021], [14.141, -16.853], [15.556, -15.556], [16.853, -14.141], [18.021, -12.619], [19.053, -11], [19.939, -9.298], [20.673, -7.524], [21.25, -5.694], [21.666, -3.82], [21.916, -1.917]];

difference() {
  union() {
    linear_extrude(height = cam_t) polygon(cam_profile);
    /* hub, proud of the cam plate on both sides */
    translate([0, 0, -5]) cylinder(h = hub_h, d = hub_d);
  }
  /* bore through the hub, 2.5 mm clear on both faces */
  translate([0, 0, -7.5]) cylinder(h = hub_h + 5, d = bore_d);
  /* keyway, milled through the whole hub */
  translate([4.25, -2.5, -7.5]) cube([4.6, 5, 25]);
}
