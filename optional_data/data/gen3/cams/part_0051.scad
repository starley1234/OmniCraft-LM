cam_profile = [[24, 0], [24.044, 2.104], [24.163, 4.261], [24.314, 6.515], [24.432, 8.893], [24.438, 11.396], [24.249, 14], [23.784, 16.654], [22.981, 19.284], [21.799, 21.799], [20.225, 24.103], [18.276, 26.101], [16, 27.713], [13.466, 28.878], [10.761, 29.567], [7.979, 29.778], [5.209, 29.544], [2.531, 28.925], [0, 28], [-2.35, 26.862], [-4.515, 25.605], [-6.515, 24.314], [-8.392, 23.056], [-10.2, 21.875], [-12, 20.785], [-13.766, 19.66], [-15.427, 18.385], [-16.971, 16.971], [-18.385, 15.427], [-19.66, 13.766], [-20.785, 12], [-21.751, 10.143], [-22.553, 8.208], [-23.182, 6.212], [-23.635, 4.168], [-23.909, 2.092], [-24, 0], [-23.909, -2.092], [-23.635, -4.168], [-23.182, -6.212], [-22.553, -8.208], [-21.751, -10.143], [-20.785, -12], [-19.66, -13.766], [-18.385, -15.427], [-16.971, -16.971], [-15.427, -18.385], [-13.766, -19.66], [-12, -20.785], [-10.143, -21.751], [-8.208, -22.553], [-6.212, -23.182], [-4.168, -23.635], [-2.092, -23.909], [0, -24], [2.092, -23.909], [4.168, -23.635], [6.212, -23.182], [8.208, -22.553], [10.143, -21.751], [12, -20.785], [13.766, -19.66], [15.427, -18.385], [16.971, -16.971], [18.385, -15.427], [19.66, -13.766], [20.785, -12], [21.751, -10.143], [22.553, -8.208], [23.182, -6.212], [23.635, -4.168], [23.909, -2.092]];

difference() {
  union() {
    linear_extrude(height = cam_t) polygon(cam_profile);
    /* hub, proud of the cam plate on both sides */
    translate([0, 0, -4]) cylinder(h = hub_h, d = hub_d);
  }
  /* bore through the hub, 2.5 mm clear on both faces */
  translate([0, 0, -6.5]) cylinder(h = hub_h + 5, d = bore_d);
  /* keyway, milled through the whole hub */
  translate([4.5, -2.5, -6.5]) cube([4.35, 5, 25]);
