$fn = 32;

// ----------------------------------------------------------------------
// Cam: base radius 24 mm with a 8 mm lift over 120 degrees
// ----------------------------------------------------------------------

// --- parameters (mm) ---
base_r = 24;              // base radius
lift = 8;                 // lift height above the base radius
lift_span = 120;          // angular width of the lift
lift_start = 0;           // angle where the lift starts
cam_t = 12;               // cam plate thickness
hub_d = 20.4;             // hub diameter
hub_h = 20;               // hub height
bore_d = 12.7;            // bore
key_w = 5;                // keyway width
