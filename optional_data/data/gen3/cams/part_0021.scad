$fn = 32;

// ----------------------------------------------------------------------
// Cam: base radius 20 mm with a 8 mm lift over 150 degrees
// ----------------------------------------------------------------------

// --- parameters (mm) ---
base_r = 20;              // base radius
lift = 8;                 // lift height above the base radius
lift_span = 150;          // angular width of the lift
lift_start = 30;          // angle where the lift starts
cam_t = 12;               // cam plate thickness
hub_d = 17;               // hub diameter
hub_h = 22;               // hub height
bore_d = 9.53;            // bore
key_w = 5;                // keyway width
key_depth = 1.74;         // keyway depth

cam_profile = [[20, 0], [19.924, 1.743], [19.696, 3.473], [19.319, 5.176], [18.794, 6.84], [18.126, 8.452], [17.321, 10], [16.618, 11.636], [16.167, 13.566], [15.796, 15.796], [15.305, 18.239], [14.516, 20.731], [13.31, 23.053], [11.645, 24.974], [9.57, 26.294], [7.205, 26.889], [4.714, 26.732], [2.266, 25.901], [0, 24.569], [-2.01, 22.969], [-3.765, 21.35], [-5.341, 19.932], [-6.865, 18.862], [-8.452, 18.126], [-10, 17.321], [-11.472, 16.383], [-12.856, 15.321], [-14.142, 14.142], [-15.321, 12.856], [-16.383, 11.472], [-17.321, 10], [-18.126, 8.452], [-18.794, 6.84], [-19.319, 5.176], [-19.696, 3.473], [-19.924, 1.743], [-20, 0], [-19.924, -1.743], [-19.696, -3.473], [-19.319, -5.176], [-18.794, -6.84], [-18.126, -8.452], [-17.321, -10], [-16.618, -11.636], [-16.167, -13.566], [-15.796, -15.796], [-15.305, -18.239], [-14.516, -20.731], [-13.31, -23.053], [-11.645, -24.974], [-9.57, -26.294], [-7.205, -26.889], [-4.714, -26.732], [-2.266, -25.901], [0, -24.569], [2.01, -22.969], [3.765, -21.35], [5.341, -19.932], [6.865, -18.862], [8.452, -18.126], [10, -17.321], [11.472, -16.383], [12.856, -15.321], [14.142, -14.142], [15.321, -12.856], [16.383, -11.472], [17.321, -10], [18.126, -8.452], [18.794, -6.84], [19.319, -5.176], [19.696, -3.473], [19.924, -1.743]];

difference() {
  union() {
    linear_extrude(height = cam_t) polygon(cam_profile);
    /* hub, proud of the cam plate on both sides */
    translate([0, 0, -5]) cylinder(h = hub_h, d = hub_d);
  }
  /* bore through the hub, 2.5 mm clear on both faces */
  translate([0, 0, -7.5]) cylinder(h = hub_h + 5, d = bore_d);
  /* keyway, milled through the whole hub */
  translate([3.022, -2.5, -7.5]) cube([4.24, 5, 27]);
}
