cam_profile = [[18, 0], [18.022, 1.577], [18.083, 3.189], [18.163, 4.867], [18.234, 6.636], [18.256, 8.513], [18.187, 10.5], [17.979, 12.589], [17.587, 14.757], [16.971, 16.971], [16.097, 19.183], [14.943, 21.341], [13.5, 23.383], [11.773, 25.247], [9.78, 26.872], [7.557, 28.201], [5.147, 29.188], [2.607, 29.795], [0, 30], [-2.607, 29.795], [-5.147, 29.188], [-7.557, 28.201], [-9.78, 26.872], [-11.773, 25.247], [-13.5, 23.383], [-14.943, 21.341], [-16.097, 19.183], [-16.971, 16.971], [-17.587, 14.757], [-17.979, 12.589], [-18.187, 10.5], [-18.256, 8.513], [-18.234, 6.636], [-18.163, 4.867], [-18.083, 3.189], [-18.022, 1.577], [-18, 0], [-17.932, -1.569], [-17.727, -3.126], [-17.387, -4.659], [-16.914, -6.156], [-16.314, -7.607], [-15.588, -9], [-14.745, -10.324], [-13.789, -11.57], [-12.728, -12.728], [-11.57, -13.789], [-10.324, -14.745], [-9, -15.588], [-7.607, -16.314], [-6.156, -16.914], [-4.659, -17.387], [-3.126, -17.727], [-1.569, -17.932], [0, -18], [1.569, -17.932], [3.126, -17.727], [4.659, -17.387], [6.156, -16.914], [7.607, -16.314], [9, -15.588], [10.324, -14.745], [11.57, -13.789], [12.728, -12.728], [13.789, -11.57], [14.745, -10.324], [15.588, -9], [16.314, -7.607], [16.914, -6.156], [17.387, -4.659], [17.727, -3.126], [17.932, -1.569]];

difference() {
  union() {
    linear_extrude(height = cam_t) polygon(cam_profile);
    /* hub, proud of the cam plate on both sides */
    translate([0, 0, -4]) cylinder(h = hub_h, d = hub_d);
