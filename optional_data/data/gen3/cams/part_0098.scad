$fn = 32;

// ----------------------------------------------------------------------
// Cam: base radius 18 mm with a 8 mm lift over 120 degrees
// ----------------------------------------------------------------------

// --- parameters (mm) ---
base_r = 18;              // base radius
lift = 8;                 // lift height above the base radius
lift_span = 120;          // angular width of the lift
lift_start = 0;           // angle where the lift starts
cam_t = 10;               // cam plate thickness
hub_d = 17.1;             // hub diameter
hub_h = 18;               // hub height
bore_d = 12.7;            // bore
key_w = 6;                // keyway width
