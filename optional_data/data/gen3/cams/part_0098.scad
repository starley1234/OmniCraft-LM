cam_profile = [[18, 0], [18.067, 1.581], [18.254, 3.219], [18.518, 4.962], [18.794, 6.84], [19, 8.86], [19.053, 11], [18.869, 13.212], [18.385, 15.427], [17.556, 17.556], [16.368, 19.507], [14.835, 21.186], [13, 22.517], [10.93, 23.44], [8.709, 23.928], [6.426, 23.982], [4.168, 23.635], [2.008, 22.948], [0, 22], [-1.827, 20.885], [-3.473, 19.696], [-4.962, 18.518], [-6.34, 17.418], [-7.665, 16.437], [-9, 15.588], [-10.324, 14.745], [-11.57, 13.789], [-12.728, 12.728], [-13.789, 11.57], [-14.745, 10.324], [-15.588, 9], [-16.314, 7.607], [-16.914, 6.156], [-17.387, 4.659], [-17.727, 3.126], [-17.932, 1.569], [-18, 0], [-17.932, -1.569], [-17.727, -3.126], [-17.387, -4.659], [-16.914, -6.156], [-16.314, -7.607], [-15.588, -9], [-14.745, -10.324], [-13.789, -11.57], [-12.728, -12.728], [-11.57, -13.789], [-10.324, -14.745], [-9, -15.588], [-7.607, -16.314], [-6.156, -16.914], [-4.659, -17.387], [-3.126, -17.727], [-1.569, -17.932], [0, -18], [1.569, -17.932], [3.126, -17.727], [4.659, -17.387], [6.156, -16.914], [7.607, -16.314], [9, -15.588], [10.324, -14.745], [11.57, -13.789], [12.728, -12.728], [13.789, -11.57], [14.745, -10.324], [15.588, -9], [16.314, -7.607], [16.914, -6.156], [17.387, -4.659], [17.727, -3.126], [17.932, -1.569]];

difference() {
  union() {
    linear_extrude(height = cam_t) polygon(cam_profile);
    /* hub, proud of the cam plate on both sides */
    translate([0, 0, -4]) cylinder(h = hub_h, d = hub_d);
  }
  /* bore through the hub, 2.5 mm clear on both faces */
  translate([0, 0, -6.5]) cylinder(h = hub_h + 5, d = bore_d);
  /* keyway, milled through the whole hub */
  translate([4.75, -3, -6.5]) cube([4.1, 6, 23]);
}
