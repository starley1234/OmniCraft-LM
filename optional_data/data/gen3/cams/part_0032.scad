$fn = 32;

// ----------------------------------------------------------------------
// Cam: base radius 24 mm with a 10 mm lift over 150 degrees
// ----------------------------------------------------------------------

// --- parameters (mm) ---
base_r = 24;              // base radius
lift = 10;                // lift height above the base radius
lift_span = 150;          // angular width of the lift
