cam_profile = [[24, 0], [24.265, 2.123], [24.996, 4.407], [26.006, 6.968], [27.028, 9.837], [27.765, 12.947], [27.95, 16.137], [27.396, 19.183], [26.028, 21.84], [23.898, 23.898], [21.167, 25.226], [18.068, 25.803], [14.856, 25.731], [11.758, 25.215], [8.927, 24.526], [6.417, 23.949], [4.183, 23.724], [2.092, 23.909], [0, 24], [-2.092, 23.909], [-4.168, 23.635], [-6.212, 23.182], [-8.208, 22.553], [-10.143, 21.751], [-12, 20.785], [-13.766, 19.66], [-15.427, 18.385], [-16.971, 16.971], [-18.385, 15.427], [-19.66, 13.766], [-20.785, 12], [-21.751, 10.143], [-22.553, 8.208], [-23.182, 6.212], [-23.635, 4.168], [-23.909, 2.092], [-24, 0], [-24.265, -2.123], [-24.996, -4.407], [-26.006, -6.968], [-27.028, -9.837], [-27.765, -12.947], [-27.95, -16.137], [-27.396, -19.183], [-26.028, -21.84], [-23.898, -23.898], [-21.167, -25.226], [-18.068, -25.803], [-14.856, -25.731], [-11.758, -25.215], [-8.927, -24.526], [-6.417, -23.949], [-4.183, -23.724], [-2.092, -23.909], [0, -24], [2.092, -23.909], [4.168, -23.635], [6.212, -23.182], [8.208, -22.553], [10.143, -21.751], [12, -20.785], [13.766, -19.66], [15.427, -18.385], [16.971, -16.971], [18.385, -15.427], [19.66, -13.766], [20.785, -12], [21.751, -10.143], [22.553, -8.208], [23.182, -6.212], [23.635, -4.168], [23.909, -2.092]];

difference() {
  union() {
    linear_extrude(height = cam_t) polygon(cam_profile);
    /* hub, proud of the cam plate on both sides */
    translate([0, 0, -6]) cylinder(h = hub_h, d = hub_d);
