$fn = 32;

// ----------------------------------------------------------------------
// Cam: base radius 20 mm with a 8 mm lift over 120 degrees
// ----------------------------------------------------------------------

// --- parameters (mm) ---
base_r = 20;              // base radius
lift = 8;                 // lift height above the base radius
lift_span = 120;          // angular width of the lift
lift_start = 30;          // angle where the lift starts
cam_t = 10;               // cam plate thickness
hub_d = 19;               // hub diameter
hub_h = 22;               // hub height
bore_d = 9.53;            // bore
key_w = 4;                // keyway width
key_depth = 2;            // keyway depth

cam_profile = [[20, 0], [19.924, 1.743], [19.696, 3.473], [19.319, 5.176], [18.794, 6.84], [18.126, 8.452], [17.321, 10], [16.61, 11.63], [16.139, 13.542], [15.743, 15.743], [15.235, 18.156], [14.442, 20.625], [13.247, 22.944], [11.607, 24.891], [9.561, 26.269], [7.247, 27.046], [4.862, 27.575], [2.44, 27.893], [0, 28], [-2.44, 27.893], [-4.862, 27.575], [-7.247, 27.046], [-9.561, 26.269], [-11.607, 24.891], [-13.247, 22.944], [-14.442, 20.625], [-15.235, 18.156], [-15.743, 15.743], [-16.139, 13.542], [-16.61, 11.63], [-17.321, 10], [-18.126, 8.452], [-18.794, 6.84], [-19.319, 5.176], [-19.696, 3.473], [-19.924, 1.743], [-20, 0], [-19.924, -1.743], [-19.696, -3.473], [-19.319, -5.176], [-18.794, -6.84], [-18.126, -8.452], [-17.321, -10], [-16.383, -11.472], [-15.321, -12.856], [-14.142, -14.142], [-12.856, -15.321], [-11.472, -16.383], [-10, -17.321], [-8.452, -18.126], [-6.84, -18.794], [-5.176, -19.319], [-3.473, -19.696], [-1.743, -19.924], [0, -20], [1.743, -19.924], [3.473, -19.696], [5.176, -19.319], [6.84, -18.794], [8.452, -18.126], [10, -17.321], [11.472, -16.383], [12.856, -15.321], [14.142, -14.142], [15.321, -12.856], [16.383, -11.472], [17.321, -10], [18.126, -8.452], [18.794, -6.84], [19.319, -5.176], [19.696, -3.473], [19.924, -1.743]];

difference() {
  union() {
    linear_extrude(height = cam_t) polygon(cam_profile);
    /* hub, proud of the cam plate on both sides */
    translate([0, 0, -6]) cylinder(h = hub_h, d = hub_d);
  }
  /* bore through the hub, 2.5 mm clear on both faces */
  translate([0, 0, -8.5]) cylinder(h = hub_h + 5, d = bore_d);
  /* keyway, milled through the whole hub */
  translate([2.763, -2, -8.5]) cube([4.5, 4, 27]);
