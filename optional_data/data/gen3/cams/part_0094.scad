cam_profile = [[20, 0], [19.924, 1.743], [19.696, 3.473], [19.319, 5.176], [18.794, 6.84], [18.126, 8.452], [17.321, 10], [16.455, 11.522], [15.586, 13.078], [14.682, 14.682], [13.706, 16.335], [12.619, 18.021], [11.382, 19.714], [9.966, 21.372], [8.351, 22.946], [6.532, 24.376], [4.515, 25.605], [2.325, 26.575], [0, 27.236], [-2.41, 27.549], [-4.847, 27.489], [-7.247, 27.046], [-9.547, 26.229], [-11.687, 25.063], [-13.618, 23.587], [-15.301, 21.852], [-16.712, 19.917], [-17.845, 17.845], [-18.705, 15.696], [-19.317, 13.526], [-19.714, 11.382], [-19.939, 9.298], [-20.038, 7.293], [-20.056, 5.374], [-20.037, 3.533], [-20.011, 1.751], [-20, 0], [-19.924, -1.743], [-19.696, -3.473], [-19.319, -5.176], [-18.794, -6.84], [-18.126, -8.452], [-17.321, -10], [-16.383, -11.472], [-15.321, -12.856], [-14.142, -14.142], [-12.856, -15.321], [-11.472, -16.383], [-10, -17.321], [-8.452, -18.126], [-6.84, -18.794], [-5.176, -19.319], [-3.473, -19.696], [-1.743, -19.924], [0, -20], [1.743, -19.924], [3.473, -19.696], [5.176, -19.319], [6.84, -18.794], [8.452, -18.126], [10, -17.321], [11.472, -16.383], [12.856, -15.321], [14.142, -14.142], [15.321, -12.856], [16.383, -11.472], [17.321, -10], [18.126, -8.452], [18.794, -6.84], [19.319, -5.176], [19.696, -3.473], [19.924, -1.743]];

difference() {
  union() {
    linear_extrude(height = cam_t) polygon(cam_profile);
    /* hub, proud of the cam plate on both sides */
    translate([0, 0, -6]) cylinder(h = hub_h, d = hub_d);
