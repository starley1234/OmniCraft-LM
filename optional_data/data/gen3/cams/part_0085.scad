$fn = 32;

// ----------------------------------------------------------------------
// Cam: base radius 20 mm with a 12 mm lift over 180 degrees
// ----------------------------------------------------------------------

// --- parameters (mm) ---
base_r = 20;              // base radius
lift = 12;                // lift height above the base radius
lift_span = 180;          // angular width of the lift
lift_start = 90;          // angle where the lift starts
cam_t = 10;               // cam plate thickness
hub_d = 17;               // hub diameter
hub_h = 18;               // hub height
bore_d = 9.53;            // bore
key_w = 5;                // keyway width
key_depth = 1.74;         // keyway depth

cam_profile = [[20, 0], [19.924, 1.743], [19.696, 3.473], [19.319, 5.176], [18.794, 6.84], [18.126, 8.452], [17.321, 10], [16.383, 11.472], [15.321, 12.856], [14.142, 14.142], [12.856, 15.321], [11.472, 16.383], [10, 17.321], [8.452, 18.126], [6.84, 18.794], [5.176, 19.319], [3.473, 19.696], [1.743, 19.924], [0, 20], [-1.751, 20.015], [-3.536, 20.053], [-5.384, 20.095], [-7.321, 20.113], [-9.358, 20.069], [-11.5, 19.919], [-13.736, 19.617], [-16.043, 19.119], [-18.385, 18.385], [-20.715, 17.382], [-22.979, 16.09], [-25.115, 14.5], [-27.059, 12.618], [-28.751, 10.465], [-30.133, 8.074], [-31.158, 5.494], [-31.787, 2.781], [-32, 0], [-31.787, -2.781], [-31.158, -5.494], [-30.133, -8.074], [-28.751, -10.465], [-27.059, -12.618], [-25.115, -14.5], [-22.979, -16.09], [-20.715, -17.382], [-18.385, -18.385], [-16.043, -19.119], [-13.736, -19.617], [-11.5, -19.919], [-9.358, -20.069], [-7.321, -20.113], [-5.384, -20.095], [-3.536, -20.053], [-1.751, -20.015], [0, -20], [1.743, -19.924], [3.473, -19.696], [5.176, -19.319], [6.84, -18.794], [8.452, -18.126], [10, -17.321], [11.472, -16.383], [12.856, -15.321], [14.142, -14.142], [15.321, -12.856], [16.383, -11.472], [17.321, -10], [18.126, -8.452], [18.794, -6.84], [19.319, -5.176], [19.696, -3.473], [19.924, -1.743]];

difference() {
  union() {
    linear_extrude(height = cam_t) polygon(cam_profile);
    /* hub, proud of the cam plate on both sides */
    translate([0, 0, -4]) cylinder(h = hub_h, d = hub_d);
  }
  /* bore through the hub, 2.5 mm clear on both faces */
  translate([0, 0, -6.5]) cylinder(h = hub_h + 5, d = bore_d);
  /* keyway, milled through the whole hub */
  translate([3.022, -2.5, -6.5]) cube([4.24, 5, 23]);
}
