cam_profile = [[22, 0], [22.003, 1.925], [22.006, 3.88], [21.988, 5.892], [21.917, 7.977], [21.751, 10.143], [21.446, 12.382], [20.955, 14.673], [20.237, 16.981], [19.259, 19.259], [17.998, 21.449], [16.448, 23.49], [14.618, 25.319], [12.532, 26.876], [10.231, 28.109], [7.765, 28.978], [5.194, 29.458], [2.585, 29.541], [0, 29.236], [-2.499, 28.567], [-4.862, 27.575], [-7.049, 26.308], [-9.036, 24.825], [-10.811, 23.185], [-12.382, 21.446], [-13.766, 19.66], [-14.992, 17.867], [-16.097, 16.097], [-17.118, 14.364], [-18.093, 12.669], [-19.053, 11], [-19.939, 9.298], [-20.673, 7.524], [-21.25, 5.694], [-21.666, 3.82], [-21.916, 1.917], [-22, 0], [-21.916, -1.917], [-21.666, -3.82], [-21.25, -5.694], [-20.673, -7.524], [-19.939, -9.298], [-19.053, -11], [-18.021, -12.619], [-16.853, -14.141], [-15.556, -15.556], [-14.141, -16.853], [-12.619, -18.021], [-11, -19.053], [-9.298, -19.939], [-7.524, -20.673], [-5.694, -21.25], [-3.82, -21.666], [-1.917, -21.916], [0, -22], [1.917, -21.916], [3.82, -21.666], [5.694, -21.25], [7.524, -20.673], [9.298, -19.939], [11, -19.053], [12.619, -18.021], [14.141, -16.853], [15.556, -15.556], [16.853, -14.141], [18.021, -12.619], [19.053, -11], [19.939, -9.298], [20.673, -7.524], [21.25, -5.694], [21.666, -3.82], [21.916, -1.917]];

difference() {
  union() {
    linear_extrude(height = cam_t) polygon(cam_profile);
    /* hub, proud of the cam plate on both sides */
    translate([0, 0, -5]) cylinder(h = hub_h, d = hub_d);
