$fn = 32;

// ----------------------------------------------------------------------
// Cam: base radius 22 mm with a 8 mm lift over 150 degrees
// ----------------------------------------------------------------------

// --- parameters (mm) ---
base_r = 22;              // base radius
lift = 8;                 // lift height above the base radius
