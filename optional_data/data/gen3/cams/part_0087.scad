$fn = 32;

// ----------------------------------------------------------------------
// Cam: base radius 26 mm with a 8 mm lift over 180 degrees
// ----------------------------------------------------------------------

// --- parameters (mm) ---
base_r = 26;              // base radius
lift = 8;                 // lift height above the base radius
lift_span = 180;          // angular width of the lift
lift_start = 90;          // angle where the lift starts
cam_t = 12;               // cam plate thickness
hub_d = 24.7;             // hub diameter
hub_h = 20;               // hub height
bore_d = 12.7;            // bore
key_w = 5;                // keyway width
key_depth = 2.5;          // keyway depth

cam_profile = [[26, 0], [25.901, 2.266], [25.605, 4.515], [25.114, 6.729], [24.432, 8.893], [23.564, 10.988], [22.517, 13], [21.298, 14.913], [19.917, 16.712], [18.385, 18.385], [16.712, 19.917], [14.913, 21.298], [13, 22.517], [10.988, 23.564], [8.893, 24.432], [6.729, 25.114], [4.515, 25.605], [2.266, 25.901], [0, 26], [-2.271, 25.962], [-4.557, 25.843], [-6.868, 25.632], [-9.213, 25.311], [-11.592, 24.859], [-14, 24.249], [-16.423, 23.454], [-18.837, 22.449], [-21.213, 21.213], [-23.513, 19.73], [-25.695, 17.992], [-27.713, 16], [-29.519, 13.765], [-31.07, 11.309], [-32.324, 8.661], [-33.246, 5.862], [-33.81, 2.958], [-34, 0], [-33.81, -2.958], [-33.246, -5.862], [-32.324, -8.661], [-31.07, -11.309], [-29.519, -13.765], [-27.713, -16], [-25.695, -17.992], [-23.513, -19.73], [-21.213, -21.213], [-18.837, -22.449], [-16.423, -23.454], [-14, -24.249], [-11.592, -24.859], [-9.213, -25.311], [-6.868, -25.632], [-4.557, -25.843], [-2.271, -25.962], [0, -26], [2.266, -25.901], [4.515, -25.605], [6.729, -25.114], [8.893, -24.432], [10.988, -23.564], [13, -22.517], [14.913, -21.298], [16.712, -19.917], [18.385, -18.385], [19.917, -16.712], [21.298, -14.913], [22.517, -13], [23.564, -10.988], [24.432, -8.893], [25.114, -6.729], [25.605, -4.515], [25.901, -2.266]];

difference() {
  union() {
    linear_extrude(height = cam_t) polygon(cam_profile);
    /* hub, proud of the cam plate on both sides */
    translate([0, 0, -4]) cylinder(h = hub_h, d = hub_d);
  }
  /* bore through the hub, 2.5 mm clear on both faces */
  translate([0, 0, -6.5]) cylinder(h = hub_h + 5, d = bore_d);
  /* keyway, milled through the whole hub */
  translate([3.85, -2.5, -6.5]) cube([5, 5, 25]);
}
