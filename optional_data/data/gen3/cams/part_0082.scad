cam_profile = [[24, 0], [23.909, 2.092], [23.635, 4.168], [23.182, 6.212], [22.553, 8.208], [21.751, 10.143], [20.785, 12], [19.66, 13.766], [18.385, 15.427], [16.971, 16.971], [15.483, 18.452], [13.964, 19.943], [12.382, 21.446], [10.702, 22.951], [8.893, 24.432], [6.927, 25.852], [4.79, 27.163], [2.477, 28.31], [0, 29.236], [-2.615, 29.886], [-5.327, 30.21], [-8.084, 30.172], [-10.826, 29.745], [-13.487, 28.923], [-16, 27.713], [-18.304, 26.141], [-20.347, 24.249], [-22.087, 22.087], [-23.5, 19.718], [-24.575, 17.207], [-25.319, 14.618], [-25.756, 12.01], [-25.918, 9.434], [-25.852, 6.927], [-25.605, 4.515], [-25.227, 2.207], [-24.764, 0], [-24.253, -2.122], [-23.721, -4.183], [-23.182, -6.212], [-22.553, -8.208], [-21.751, -10.143], [-20.785, -12], [-19.66, -13.766], [-18.385, -15.427], [-16.971, -16.971], [-15.427, -18.385], [-13.766, -19.66], [-12, -20.785], [-10.143, -21.751], [-8.208, -22.553], [-6.212, -23.182], [-4.168, -23.635], [-2.092, -23.909], [0, -24], [2.092, -23.909], [4.168, -23.635], [6.212, -23.182], [8.208, -22.553], [10.143, -21.751], [12, -20.785], [13.766, -19.66], [15.427, -18.385], [16.971, -16.971], [18.385, -15.427], [19.66, -13.766], [20.785, -12], [21.751, -10.143], [22.553, -8.208], [23.182, -6.212], [23.635, -4.168], [23.909, -2.092]];

difference() {
  union() {
    linear_extrude(height = cam_t) polygon(cam_profile);
    /* hub, proud of the cam plate on both sides */
    translate([0, 0, -4]) cylinder(h = hub_h, d = hub_d);
