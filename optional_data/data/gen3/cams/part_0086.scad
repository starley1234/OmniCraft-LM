$fn = 32;

// ----------------------------------------------------------------------
// Cam: base radius 18 mm with a 12 mm lift over 180 degrees
// ----------------------------------------------------------------------

// --- parameters (mm) ---
base_r = 18;              // base radius
lift = 12;                // lift height above the base radius
lift_span = 180;          // angular width of the lift
lift_start = 90;          // angle where the lift starts
cam_t = 10;               // cam plate thickness
hub_d = 15.3;             // hub diameter
hub_h = 20;               // hub height
bore_d = 12.7;            // bore
key_w = 5;                // keyway width
key_depth = 1.6;          // keyway depth

cam_profile = [[18, 0], [17.932, 1.569], [17.727, 3.126], [17.387, 4.659], [16.914, 6.156], [16.314, 7.607], [15.588, 9], [14.745, 10.324], [13.789, 11.57], [12.728, 12.728], [11.57, 13.789], [10.324, 14.745], [9, 15.588], [7.607, 16.314], [6.156, 16.914], [4.659, 17.387], [3.126, 17.727], [1.569, 17.932], [0, 18], [-1.577, 18.022], [-3.189, 18.083], [-4.867, 18.163], [-6.636, 18.234], [-8.513, 18.256], [-10.5, 18.187], [-12.589, 17.979], [-14.757, 17.587], [-16.971, 16.971], [-19.183, 16.097], [-21.341, 14.943], [-23.383, 13.5], [-25.247, 11.773], [-26.872, 9.78], [-28.201, 7.557], [-29.188, 5.147], [-29.795, 2.607], [-30, 0], [-29.795, -2.607], [-29.188, -5.147], [-28.201, -7.557], [-26.872, -9.78], [-25.247, -11.773], [-23.383, -13.5], [-21.341, -14.943], [-19.183, -16.097], [-16.971, -16.971], [-14.757, -17.587], [-12.589, -17.979], [-10.5, -18.187], [-8.513, -18.256], [-6.636, -18.234], [-4.867, -18.163], [-3.189, -18.083], [-1.577, -18.022], [0, -18], [1.569, -17.932], [3.126, -17.727], [4.659, -17.387], [6.156, -16.914], [7.607, -16.314], [9, -15.588], [10.324, -14.745], [11.57, -13.789], [12.728, -12.728], [13.789, -11.57], [14.745, -10.324], [15.588, -9], [16.314, -7.607], [16.914, -6.156], [17.387, -4.659], [17.727, -3.126], [17.932, -1.569]];

difference() {
  union() {
    linear_extrude(height = cam_t) polygon(cam_profile);
    /* hub, proud of the cam plate on both sides */
    translate([0, 0, -5]) cylinder(h = hub_h, d = hub_d);
  }
  /* bore through the hub, 2.5 mm clear on both faces */
  translate([0, 0, -7.5]) cylinder(h = hub_h + 5, d = bore_d);
  /* keyway, milled through the whole hub */
  translate([4.75, -2.5, -7.5]) cube([4.1, 5, 25]);
}
