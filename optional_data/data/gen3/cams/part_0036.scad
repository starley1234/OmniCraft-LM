$fn = 32;

// ----------------------------------------------------------------------
// Cam: base radius 20 mm with a 14 mm lift over 150 degrees
// ----------------------------------------------------------------------

// --- parameters (mm) ---
base_r = 20;              // base radius
lift = 14;                // lift height above the base radius
lift_span = 150;          // angular width of the lift
lift_start = 90;          // angle where the lift starts
cam_t = 10;               // cam plate thickness
hub_d = 19;               // hub diameter
hub_h = 18;               // hub height
bore_d = 9.53;            // bore
key_w = 4;                // keyway width
key_depth = 2;            // keyway depth

cam_profile = [[20, 0], [19.924, 1.743], [19.696, 3.473], [19.319, 5.176], [18.794, 6.84], [18.126, 8.452], [17.321, 10], [16.383, 11.472], [15.321, 12.856], [14.142, 14.142], [12.856, 15.321], [11.472, 16.383], [10, 17.321], [8.452, 18.126], [6.84, 18.794], [5.176, 19.319], [3.473, 19.696], [1.743, 19.924], [0, 20], [-1.77, 20.234], [-3.684, 20.894], [-5.859, 21.864], [-8.36, 22.969], [-11.19, 23.996], [-14.279, 24.732], [-17.494, 24.984], [-20.654, 24.614], [-23.551, 23.551], [-25.986, 21.805], [-27.851, 19.502], [-29.445, 17], [-30.814, 14.369], [-31.95, 11.629], [-32.841, 8.8], [-33.483, 5.904], [-33.871, 2.963], [-34, 0], [-33.871, -2.963], [-33.406, -5.89], [-32.172, -8.62], [-30.194, -10.99], [-27.642, -12.89], [-24.732, -14.279], [-21.689, -15.187], [-18.724, -15.711], [-16.006, -16.006], [-13.638, -16.253], [-11.65, -16.638], [-10, -17.321], [-8.452, -18.126], [-6.84, -18.794], [-5.176, -19.319], [-3.473, -19.696], [-1.743, -19.924], [0, -20], [1.743, -19.924], [3.473, -19.696], [5.176, -19.319], [6.84, -18.794], [8.452, -18.126], [10, -17.321], [11.472, -16.383], [12.856, -15.321], [14.142, -14.142], [15.321, -12.856], [16.383, -11.472], [17.321, -10], [18.126, -8.452], [18.794, -6.84], [19.319, -5.176], [19.696, -3.473], [19.924, -1.743]];

difference() {
  union() {
    linear_extrude(height = cam_t) polygon(cam_profile);
    /* hub, proud of the cam plate on both sides */
    translate([0, 0, -4]) cylinder(h = hub_h, d = hub_d);
  }
  /* bore through the hub, 2.5 mm clear on both faces */
  translate([0, 0, -6.5]) cylinder(h = hub_h + 5, d = bore_d);
  /* keyway, milled through the whole hub */
  translate([2.763, -2, -6.5]) cube([4.5, 4, 23]);
}
