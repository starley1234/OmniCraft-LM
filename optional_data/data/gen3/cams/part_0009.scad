cam_profile = [[24, 0], [24.462, 2.14], [25.703, 4.532], [27.325, 7.322], [28.788, 10.478], [29.563, 13.785], [29.269, 16.899], [27.777, 19.45], [25.226, 21.167], [21.975, 21.975], [18.488, 22.033], [15.2, 21.708], [12.397, 21.472], [10.152, 21.772], [8.208, 22.553], [6.212, 23.182], [4.168, 23.635], [2.092, 23.909], [0, 24], [-2.092, 23.909], [-4.168, 23.635], [-6.212, 23.182], [-8.208, 22.553], [-10.143, 21.751], [-12, 20.785], [-13.766, 19.66], [-15.427, 18.385], [-16.971, 16.971], [-18.385, 15.427], [-19.66, 13.766], [-20.785, 12], [-21.751, 10.143], [-22.553, 8.208], [-23.182, 6.212], [-23.635, 4.168], [-23.909, 2.092], [-24, 0], [-24.462, -2.14], [-25.703, -4.532], [-27.325, -7.322], [-28.788, -10.478], [-29.563, -13.785], [-29.269, -16.899], [-27.777, -19.45], [-25.226, -21.167], [-21.975, -21.975], [-18.488, -22.033], [-15.2, -21.708], [-12.397, -21.472], [-10.152, -21.772], [-8.208, -22.553], [-6.212, -23.182], [-4.168, -23.635], [-2.092, -23.909], [0, -24], [2.092, -23.909], [4.168, -23.635], [6.212, -23.182], [8.208, -22.553], [10.143, -21.751], [12, -20.785], [13.766, -19.66], [15.427, -18.385], [16.971, -16.971], [18.385, -15.427], [19.66, -13.766], [20.785, -12], [21.751, -10.143], [22.553, -8.208], [23.182, -6.212], [23.635, -4.168], [23.909, -2.092]];

difference() {
  union() {
    linear_extrude(height = cam_t) polygon(cam_profile);
    /* hub, proud of the cam plate on both sides */
    translate([0, 0, -6]) cylinder(h = hub_h, d = hub_d);
  }
  /* bore through the hub, 2.5 mm clear on both faces */
  translate([0, 0, -8.5]) cylinder(h = hub_h + 5, d = bore_d);
  /* keyway, milled through the whole hub */
  translate([3.35, -3, -8.5]) cube([5.5, 6, 27]);
