$fn = 32;

// ----------------------------------------------------------------------
// Cam: base radius 26 mm with a 14 mm lift over 180 degrees
// ----------------------------------------------------------------------

// --- parameters (mm) ---
base_r = 26;              // base radius
lift = 14;                // lift height above the base radius
lift_span = 180;          // angular width of the lift
lift_start = 45;          // angle where the lift starts
cam_t = 8;                // cam plate thickness
hub_d = 24.7;             // hub diameter
hub_h = 20;               // hub height
bore_d = 12.7;            // bore
key_w = 5;                // keyway width
