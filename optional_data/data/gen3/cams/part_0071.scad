cam_profile = [[26, 0], [25.901, 2.266], [25.605, 4.515], [25.114, 6.729], [24.432, 8.893], [23.564, 10.988], [22.517, 13], [21.298, 14.913], [19.917, 16.712], [18.385, 18.385], [16.781, 19.999], [15.155, 21.644], [13.469, 23.329], [11.68, 25.048], [9.748, 26.782], [7.635, 28.495], [5.315, 30.141], [2.77, 31.664], [0, 33], [-2.982, 34.085], [-6.146, 34.856], [-9.447, 35.256], [-12.826, 35.238], [-16.213, 34.768], [-19.531, 33.829], [-22.701, 32.42], [-25.643, 30.56], [-28.284, 28.284], [-30.56, 25.643], [-32.42, 22.701], [-33.829, 19.531], [-34.768, 16.213], [-35.238, 12.826], [-35.256, 9.447], [-34.856, 6.146], [-34.085, 2.982], [-33, 0], [-31.664, -2.77], [-30.141, -5.315], [-28.495, -7.635], [-26.782, -9.748], [-25.048, -11.68], [-23.329, -13.469], [-21.644, -15.155], [-19.999, -16.781], [-18.385, -18.385], [-16.712, -19.917], [-14.913, -21.298], [-13, -22.517], [-10.988, -23.564], [-8.893, -24.432], [-6.729, -25.114], [-4.515, -25.605], [-2.266, -25.901], [0, -26], [2.266, -25.901], [4.515, -25.605], [6.729, -25.114], [8.893, -24.432], [10.988, -23.564], [13, -22.517], [14.913, -21.298], [16.712, -19.917], [18.385, -18.385], [19.917, -16.712], [21.298, -14.913], [22.517, -13], [23.564, -10.988], [24.432, -8.893], [25.114, -6.729], [25.605, -4.515], [25.901, -2.266]];

difference() {
  union() {
    linear_extrude(height = cam_t) polygon(cam_profile);
    /* hub, proud of the cam plate on both sides */
    translate([0, 0, -6]) cylinder(h = hub_h, d = hub_d);
  }
  /* bore through the hub, 2.5 mm clear on both faces */
  translate([0, 0, -8.5]) cylinder(h = hub_h + 5, d = bore_d);
  /* keyway, milled through the whole hub */
  translate([3.85, -2.5, -8.5]) cube([5, 5, 25]);
