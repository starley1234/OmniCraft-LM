$fn = 32;

// ----------------------------------------------------------------------
// Thumb nut: 5 lobe grip, 16 mm tall, M6.35 thread
// ----------------------------------------------------------------------

// --- parameters (mm) ---
base_r = 16;              // grip base radius
lobe_amp = 2.5;           // lobe height above the base radius
lobes = 5;                // number of grip lobes
grip_h = 12;              // grip height
boss_d = 12.35;           // threaded boss diameter
boss_h = 4;               // boss height
bore_d = 6.35;            // thread core diameter
pitch = 1.75;             // thread pitch
thread_d = 1.05;          // thread depth

grip = [[18.5, 0], [17.83, 2.347], [16.08, 4.309], [13.898, 5.757], [11.981, 6.917], [10.727, 8.231], [10.064, 10.064], [9.542, 12.435], [8.625, 14.939], [7.007, 16.916], [4.766, 17.787], [2.287, 17.372], [0, 16], [-1.89, 14.354], [-3.516, 13.122], [-5.239, 12.648], [-7.375, 12.774], [-9.939, 12.953], [-12.564, 12.564], [-14.66, 11.249], [-15.731, 9.083], [-15.666, 6.489], [-14.83, 3.974], [-13.897, 1.83], [-13.5, 0], [-13.897, -1.83], [-14.83, -3.974], [-15.666, -6.489], [-15.731, -9.083], [-14.66, -11.249], [-12.564, -12.564], [-9.939, -12.953], [-7.375, -12.774], [-5.239, -12.648], [-3.516, -13.122], [-1.89, -14.354], [0, -16], [2.287, -17.372], [4.766, -17.787], [7.007, -16.916], [8.625, -14.939], [9.542, -12.435], [10.064, -10.064], [10.727, -8.231], [11.981, -6.917], [13.898, -5.757], [16.08, -4.309], [17.83, -2.347]];

difference() {
  union() {
    /* grip outline extruded straight up */
    linear_extrude(height = grip_h) polygon(grip);
    /* boss sunk half a millimetre into the grip */
    translate([0, 0, grip_h - 0.5]) cylinder(h = boss_h + 0.5, d = boss_d);
  }
  /* threaded bore through grip and boss */
  translate([0, 0, -2.5]) cylinder(h = grip_h + boss_h + 5, d = bore_d);
  translate([0, 0, 2.0]) rotate_extrude() polygon([[2.175, 0], [2.175, 12], [2.675, 12], [4.225, 11.125], [2.675, 10.25], [4.225, 9.375], [2.675, 8.5], [4.225, 7.625], [2.675, 6.75], [4.225, 5.875], [2.675, 5], [4.225, 4.125], [2.675, 3.25], [4.225, 2.375], [2.675, 0], [2.175, 0]]);
}
