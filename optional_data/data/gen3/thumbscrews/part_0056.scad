$fn = 32;

// ----------------------------------------------------------------------
// Thumb nut: 8 lobe grip, 20 mm tall, M6.35 thread
// ----------------------------------------------------------------------

// --- parameters (mm) ---
base_r = 18;              // grip base radius
lobe_amp = 1.2;           // lobe height above the base radius
lobes = 8;                // number of grip lobes
grip_h = 16;              // grip height
boss_d = 14.35;           // threaded boss diameter
boss_h = 4;               // boss height
bore_d = 6.35;            // thread core diameter
pitch = 1.75;             // thread pitch
thread_d = 1.05;          // thread depth

grip = [[19.2, 0], [18.441, 2.428], [16.807, 4.503], [15.521, 6.429], [15.069, 8.7], [14.756, 11.323], [13.576, 13.576], [11.323, 14.756], [8.7, 15.069], [6.429, 15.521], [4.503, 16.807], [2.428, 18.441], [0, 19.2], [-2.428, 18.441], [-4.503, 16.807], [-6.429, 15.521], [-8.7, 15.069], [-11.323, 14.756], [-13.576, 13.576], [-14.756, 11.323], [-15.069, 8.7], [-15.521, 6.429], [-16.807, 4.503], [-18.441, 2.428], [-19.2, 0], [-18.441, -2.428], [-16.807, -4.503], [-15.521, -6.429], [-15.069, -8.7], [-14.756, -11.323], [-13.576, -13.576], [-11.323, -14.756], [-8.7, -15.069], [-6.429, -15.521], [-4.503, -16.807], [-2.428, -18.441], [0, -19.2], [2.428, -18.441], [4.503, -16.807], [6.429, -15.521], [8.7, -15.069], [11.323, -14.756], [13.576, -13.576], [14.756, -11.323], [15.069, -8.7], [15.521, -6.429], [16.807, -4.503], [18.441, -2.428]];

difference() {
  union() {
    /* grip outline extruded straight up */
    linear_extrude(height = grip_h) polygon(grip);
    /* boss sunk half a millimetre into the grip */
    translate([0, 0, grip_h - 0.5]) cylinder(h = boss_h + 0.5, d = boss_d);
  }
  /* threaded bore through grip and boss */
  translate([0, 0, -2.5]) cylinder(h = grip_h + boss_h + 5, d = bore_d);
  translate([0, 0, 2.0]) rotate_extrude() polygon([[2.175, 0], [2.175, 16], [2.675, 16], [4.225, 15.125], [2.675, 14.25], [4.225, 13.375], [2.675, 12.5], [4.225, 11.625], [2.675, 10.75], [4.225, 9.875], [2.675, 9], [4.225, 8.125], [2.675, 7.25], [4.225, 6.375], [2.675, 5.5], [4.225, 4.625], [2.675, 3.75], [4.225, 2.875], [2.675, 0], [2.175, 0]]);
}
