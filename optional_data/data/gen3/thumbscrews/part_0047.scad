$fn = 32;

// ----------------------------------------------------------------------
// Thumb nut: 7 lobe grip, 20 mm tall, M9.53 thread
// ----------------------------------------------------------------------

// --- parameters (mm) ---
base_r = 22;              // grip base radius
lobe_amp = 2;             // lobe height above the base radius
lobes = 7;                // number of grip lobes
grip_h = 14;              // grip height
boss_d = 15.53;           // threaded boss diameter
boss_h = 6;               // boss height
bore_d = 9.53;            // thread core diameter
pitch = 1.75;             // thread pitch
thread_d = 1.05;          // thread depth

grip = [[24, 0], [23.019, 3.03], [20.75, 5.56], [18.618, 7.712], [17.553, 10.134], [17.247, 13.234], [16.556, 16.556], [14.6, 19.027], [11.5, 19.919], [8.126, 19.618], [5.194, 19.384], [2.664, 20.239], [0, 22], [-3.079, 23.385], [-6.194, 23.116], [-8.712, 21.032], [-10.5, 18.187], [-12.186, 15.881], [-14.556, 14.556], [-17.661, 13.552], [-20.553, 11.866], [-22.032, 9.126], [-21.75, 5.828], [-20.605, 2.713], [-20, 0], [-20.605, -2.713], [-21.75, -5.828], [-22.032, -9.126], [-20.553, -11.866], [-17.661, -13.552], [-14.556, -14.556], [-12.186, -15.881], [-10.5, -18.187], [-8.712, -21.032], [-6.194, -23.116], [-3.079, -23.385], [0, -22], [2.664, -20.239], [5.194, -19.384], [8.126, -19.618], [11.5, -19.919], [14.6, -19.027], [16.556, -16.556], [17.247, -13.234], [17.553, -10.134], [18.618, -7.712], [20.75, -5.56], [23.019, -3.03]];

difference() {
  union() {
    /* grip outline extruded straight up */
    linear_extrude(height = grip_h) polygon(grip);
    /* boss sunk half a millimetre into the grip */
    translate([0, 0, grip_h - 0.5]) cylinder(h = boss_h + 0.5, d = boss_d);
  }
  /* threaded bore through grip and boss */
  translate([0, 0, -2.5]) cylinder(h = grip_h + boss_h + 5, d = bore_d);
  translate([0, 0, 2.0]) rotate_extrude() polygon([[3.763, 0], [3.763, 16], [4.263, 16], [5.812, 15.125], [4.263, 14.25], [5.812, 13.375], [4.263, 12.5], [5.812, 11.625], [4.263, 10.75], [5.812, 9.875], [4.263, 9], [5.812, 8.125], [4.263, 7.25], [5.812, 6.375], [4.263, 5.5], [5.812, 4.625], [4.263, 3.75], [5.812, 2.875], [4.263, 0], [3.763, 0]]);
