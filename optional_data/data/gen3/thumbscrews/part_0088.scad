$fn = 32;

// ----------------------------------------------------------------------
// Thumb nut: 4 lobe grip, 20 mm tall, M6.35 thread
// ----------------------------------------------------------------------

// --- parameters (mm) ---
base_r = 20;              // grip base radius
lobe_amp = 2.5;           // lobe height above the base radius
lobes = 4;                // number of grip lobes
grip_h = 12;              // grip height
boss_d = 16.35;           // threaded boss diameter
boss_h = 8;               // boss height
bore_d = 6.35;            // thread core diameter
pitch = 1.75;             // thread pitch
thread_d = 1.05;          // thread depth

grip = [[22.5, 0], [21.975, 2.893], [20.526, 5.5], [18.478, 7.654], [16.238, 9.375], [14.149, 10.857], [12.374, 12.374], [10.857, 14.149], [9.375, 16.238], [7.654, 18.478], [5.5, 20.526], [2.893, 21.975], [0, 22.5], [-2.893, 21.975], [-5.5, 20.526], [-7.654, 18.478], [-9.375, 16.238], [-10.857, 14.149], [-12.374, 12.374], [-14.149, 10.857], [-16.238, 9.375], [-18.478, 7.654], [-20.526, 5.5], [-21.975, 2.893], [-22.5, 0], [-21.975, -2.893], [-20.526, -5.5], [-18.478, -7.654], [-16.238, -9.375], [-14.149, -10.857], [-12.374, -12.374], [-10.857, -14.149], [-9.375, -16.238], [-7.654, -18.478], [-5.5, -20.526], [-2.893, -21.975], [0, -22.5], [2.893, -21.975], [5.5, -20.526], [7.654, -18.478], [9.375, -16.238], [10.857, -14.149], [12.374, -12.374], [14.149, -10.857], [16.238, -9.375], [18.478, -7.654], [20.526, -5.5], [21.975, -2.893]];

difference() {
  union() {
    /* grip outline extruded straight up */
    linear_extrude(height = grip_h) polygon(grip);
    /* boss sunk half a millimetre into the grip */
    translate([0, 0, grip_h - 0.5]) cylinder(h = boss_h + 0.5, d = boss_d);
  }
  /* threaded bore through grip and boss */
  translate([0, 0, -2.5]) cylinder(h = grip_h + boss_h + 5, d = bore_d);
  translate([0, 0, 2.0]) rotate_extrude() polygon([[2.175, 0], [2.175, 16], [2.675, 16], [4.225, 15.125], [2.675, 14.25], [4.225, 13.375], [2.675, 12.5], [4.225, 11.625], [2.675, 10.75], [4.225, 9.875], [2.675, 9], [4.225, 8.125], [2.675, 7.25], [4.225, 6.375], [2.675, 5.5], [4.225, 4.625], [2.675, 3.75], [4.225, 2.875], [2.675, 0], [2.175, 0]]);
}
