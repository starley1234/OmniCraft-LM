$fn = 32;

// ----------------------------------------------------------------------
// Thumb nut: 6 lobe grip, 18 mm tall, M6.35 thread
// ----------------------------------------------------------------------

// --- parameters (mm) ---
base_r = 14;              // grip base radius
lobe_amp = 2;             // lobe height above the base radius
lobes = 6;                // number of grip lobes
grip_h = 12;              // grip height
boss_d = 14.35;           // threaded boss diameter
boss_h = 6;               // boss height
bore_d = 6.35;            // thread core diameter
pitch = 1.75;             // thread pitch
thread_d = 1.05;          // thread depth

grip = [[16, 0], [15.282, 2.012], [13.523, 3.623], [11.628, 4.816], [10.392, 6], [9.985, 7.662], [9.899, 9.899], [9.384, 12.229], [8, 13.856], [5.899, 14.241], [3.623, 13.523], [1.643, 12.478], [0, 12], [-1.643, 12.478], [-3.623, 13.523], [-5.899, 14.241], [-8, 13.856], [-9.384, 12.229], [-9.899, 9.899], [-9.985, 7.662], [-10.392, 6], [-11.628, 4.816], [-13.523, 3.623], [-15.282, 2.012], [-16, 0], [-15.282, -2.012], [-13.523, -3.623], [-11.628, -4.816], [-10.392, -6], [-9.985, -7.662], [-9.899, -9.899], [-9.384, -12.229], [-8, -13.856], [-5.899, -14.241], [-3.623, -13.523], [-1.643, -12.478], [0, -12], [1.643, -12.478], [3.623, -13.523], [5.899, -14.241], [8, -13.856], [9.384, -12.229], [9.899, -9.899], [9.985, -7.662], [10.392, -6], [11.628, -4.816], [13.523, -3.623], [15.282, -2.012]];

difference() {
  union() {
    /* grip outline extruded straight up */
    linear_extrude(height = grip_h) polygon(grip);
    /* boss sunk half a millimetre into the grip */
    translate([0, 0, grip_h - 0.5]) cylinder(h = boss_h + 0.5, d = boss_d);
  }
  /* threaded bore through grip and boss */
  translate([0, 0, -2.5]) cylinder(h = grip_h + boss_h + 5, d = bore_d);
  translate([0, 0, 2.0]) rotate_extrude() polygon([[2.175, 0], [2.175, 14], [2.675, 14], [4.225, 13.125], [2.675, 12.25], [4.225, 11.375], [2.675, 10.5], [4.225, 9.625], [2.675, 8.75], [4.225, 7.875], [2.675, 7], [4.225, 6.125], [2.675, 5.25], [4.225, 4.375], [2.675, 3.5], [4.225, 2.625], [2.675, 0], [2.175, 0]]);
}
