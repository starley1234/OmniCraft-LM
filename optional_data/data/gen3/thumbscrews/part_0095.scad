$fn = 32;

// ----------------------------------------------------------------------
// Thumb nut: 5 lobe grip, 20 mm tall, M12.7 thread
// ----------------------------------------------------------------------

// --- parameters (mm) ---
base_r = 22;              // grip base radius
lobe_amp = 2.5;           // lobe height above the base radius
lobes = 5;                // number of grip lobes
grip_h = 14;              // grip height
boss_d = 22.7;            // threaded boss diameter
boss_h = 6;               // boss height
bore_d = 12.7;            // thread core diameter
pitch = 1.75;             // thread pitch
thread_d = 1.05;          // thread depth

grip = [[24.5, 0], [23.778, 3.13], [21.875, 5.861], [19.441, 8.053], [17.178, 9.917], [15.487, 11.884], [14.306, 14.306], [13.194, 17.195], [11.625, 20.135], [9.303, 22.459], [6.319, 23.583], [3.07, 23.321], [0, 22], [-2.673, 20.303], [-5.069, 18.918], [-7.535, 18.191], [-10.375, 17.97], [-13.591, 17.713], [-16.806, 16.806], [-19.42, 14.902], [-20.928, 12.083], [-21.209, 8.785], [-20.625, 5.527], [-19.845, 2.613], [-19.5, 0], [-19.845, -2.613], [-20.625, -5.527], [-21.209, -8.785], [-20.928, -12.083], [-19.42, -14.902], [-16.806, -16.806], [-13.591, -17.713], [-10.375, -17.97], [-7.535, -18.191], [-5.069, -18.918], [-2.673, -20.303], [0, -22], [3.07, -23.321], [6.319, -23.583], [9.303, -22.459], [11.625, -20.135], [13.194, -17.195], [14.306, -14.306], [15.487, -11.884], [17.178, -9.917], [19.441, -8.053], [21.875, -5.861], [23.778, -3.13]];

difference() {
  union() {
    /* grip outline extruded straight up */
    linear_extrude(height = grip_h) polygon(grip);
    /* boss sunk half a millimetre into the grip */
    translate([0, 0, grip_h - 0.5]) cylinder(h = boss_h + 0.5, d = boss_d);
  }
  /* threaded bore through grip and boss */
  translate([0, 0, -2.5]) cylinder(h = grip_h + boss_h + 5, d = bore_d);
  translate([0, 0, 2.0]) rotate_extrude() polygon([[5.35, 0], [5.35, 16], [5.85, 16], [7.4, 15.125], [5.85, 14.25], [7.4, 13.375], [5.85, 12.5], [7.4, 11.625], [5.85, 10.75], [7.4, 9.875], [5.85, 9], [7.4, 8.125], [5.85, 7.25], [7.4, 6.375], [5.85, 5.5], [7.4, 4.625], [5.85, 3.75], [7.4, 2.875], [5.85, 0], [5.35, 0]]);
}
