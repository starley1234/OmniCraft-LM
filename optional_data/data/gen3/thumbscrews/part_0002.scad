$fn = 32;

// ----------------------------------------------------------------------
// Thumb nut: 6 lobe grip, 14 mm tall, M7.94 thread
// ----------------------------------------------------------------------

// --- parameters (mm) ---
base_r = 20;              // grip base radius
lobe_amp = 2;             // lobe height above the base radius
lobes = 6;                // number of grip lobes
grip_h = 10;              // grip height
boss_d = 13.94;           // threaded boss diameter
boss_h = 4;               // boss height
bore_d = 7.94;            // thread core diameter
pitch = 1.75;             // thread pitch
thread_d = 1.05;          // thread depth

grip = [[22, 0], [21.231, 2.795], [19.319, 5.176], [17.171, 7.112], [15.588, 9], [14.745, 11.314], [14.142, 14.142], [13.036, 16.989], [11, 19.053], [8.195, 19.784], [5.176, 19.319], [2.426, 18.427], [0, 18], [-2.426, 18.427], [-5.176, 19.319], [-8.195, 19.784], [-11, 19.053], [-13.036, 16.989], [-14.142, 14.142], [-14.745, 11.314], [-15.588, 9], [-17.171, 7.112], [-19.319, 5.176], [-21.231, 2.795], [-22, 0], [-21.231, -2.795], [-19.319, -5.176], [-17.171, -7.112], [-15.588, -9], [-14.745, -11.314], [-14.142, -14.142], [-13.036, -16.989], [-11, -19.053], [-8.195, -19.784], [-5.176, -19.319], [-2.426, -18.427], [0, -18], [2.426, -18.427], [5.176, -19.319], [8.195, -19.784], [11, -19.053], [13.036, -16.989], [14.142, -14.142], [14.745, -11.314], [15.588, -9], [17.171, -7.112], [19.319, -5.176], [21.231, -2.795]];

difference() {
  union() {
    /* grip outline extruded straight up */
    linear_extrude(height = grip_h) polygon(grip);
    /* boss sunk half a millimetre into the grip */
    translate([0, 0, grip_h - 0.5]) cylinder(h = boss_h + 0.5, d = boss_d);
  }
  /* threaded bore through grip and boss */
  translate([0, 0, -2.5]) cylinder(h = grip_h + boss_h + 5, d = bore_d);
  translate([0, 0, 2.0]) rotate_extrude() polygon([[2.969, 0], [2.969, 10], [3.469, 10], [5.019, 9.125], [3.469, 8.25], [5.019, 7.375], [3.469, 6.5], [5.019, 5.625], [3.469, 4.75], [5.019, 3.875], [3.469, 3], [5.019, 2.125], [3.469, 0], [2.969, 0]]);
}
