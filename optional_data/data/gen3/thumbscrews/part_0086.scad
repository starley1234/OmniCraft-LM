$fn = 32;

// ----------------------------------------------------------------------
// Thumb nut: 8 lobe grip, 18 mm tall, M6.35 thread
// ----------------------------------------------------------------------

// --- parameters (mm) ---
base_r = 16;              // grip base radius
lobe_amp = 2.5;           // lobe height above the base radius
lobes = 8;                // number of grip lobes
grip_h = 14;              // grip height
boss_d = 16.35;           // threaded boss diameter
boss_h = 4;               // boss height
bore_d = 6.35;            // thread core diameter
pitch = 1.75;             // thread pitch
thread_d = 1.05;          // thread depth

grip = [[18.5, 0], [17.102, 2.252], [14.247, 3.818], [12.472, 5.166], [12.774, 7.375], [13.685, 10.501], [13.081, 13.081], [10.501, 13.685], [7.375, 12.774], [5.166, 12.472], [3.818, 14.247], [2.252, 17.102], [0, 18.5], [-2.252, 17.102], [-3.818, 14.247], [-5.166, 12.472], [-7.375, 12.774], [-10.501, 13.685], [-13.081, 13.081], [-13.685, 10.501], [-12.774, 7.375], [-12.472, 5.166], [-14.247, 3.818], [-17.102, 2.252], [-18.5, 0], [-17.102, -2.252], [-14.247, -3.818], [-12.472, -5.166], [-12.774, -7.375], [-13.685, -10.501], [-13.081, -13.081], [-10.501, -13.685], [-7.375, -12.774], [-5.166, -12.472], [-3.818, -14.247], [-2.252, -17.102], [0, -18.5], [2.252, -17.102], [3.818, -14.247], [5.166, -12.472], [7.375, -12.774], [10.501, -13.685], [13.081, -13.081], [13.685, -10.501], [12.774, -7.375], [12.472, -5.166], [14.247, -3.818], [17.102, -2.252]];

difference() {
  union() {
    /* grip outline extruded straight up */
    linear_extrude(height = grip_h) polygon(grip);
    /* boss sunk half a millimetre into the grip */
    translate([0, 0, grip_h - 0.5]) cylinder(h = boss_h + 0.5, d = boss_d);
  }
  /* threaded bore through grip and boss */
  translate([0, 0, -2.5]) cylinder(h = grip_h + boss_h + 5, d = bore_d);
  translate([0, 0, 2.0]) rotate_extrude() polygon([[2.175, 0], [2.175, 14], [2.675, 14], [4.225, 13.125], [2.675, 12.25], [4.225, 11.375], [2.675, 10.5], [4.225, 9.625], [2.675, 8.75], [4.225, 7.875], [2.675, 7], [4.225, 6.125], [2.675, 5.25], [4.225, 4.375], [2.675, 3.5], [4.225, 2.625], [2.675, 0], [2.175, 0]]);
}
