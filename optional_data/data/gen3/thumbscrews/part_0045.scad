$fn = 32;

// ----------------------------------------------------------------------
// Thumb nut: 8 lobe grip, 20 mm tall, M9.53 thread
// ----------------------------------------------------------------------

// --- parameters (mm) ---
base_r = 22;              // grip base radius
lobe_amp = 1.2;           // lobe height above the base radius
lobes = 8;                // number of grip lobes
grip_h = 16;              // grip height
boss_d = 19.52;           // threaded boss diameter
boss_h = 4;               // boss height
bore_d = 9.53;            // thread core diameter
pitch = 1.75;             // thread pitch
thread_d = 1.05;          // thread depth

grip = [[23.2, 0], [22.407, 2.95], [20.671, 5.539], [19.217, 7.96], [18.533, 10.7], [17.93, 13.758], [16.405, 16.405], [13.758, 17.93], [10.7, 18.533], [7.96, 19.217], [5.539, 20.671], [2.95, 22.407], [0, 23.2], [-2.95, 22.407], [-5.539, 20.671], [-7.96, 19.217], [-10.7, 18.533], [-13.758, 17.93], [-16.405, 16.405], [-17.93, 13.758], [-18.533, 10.7], [-19.217, 7.96], [-20.671, 5.539], [-22.407, 2.95], [-23.2, 0], [-22.407, -2.95], [-20.671, -5.539], [-19.217, -7.96], [-18.533, -10.7], [-17.93, -13.758], [-16.405, -16.405], [-13.758, -17.93], [-10.7, -18.533], [-7.96, -19.217], [-5.539, -20.671], [-2.95, -22.407], [0, -23.2], [2.95, -22.407], [5.539, -20.671], [7.96, -19.217], [10.7, -18.533], [13.758, -17.93], [16.405, -16.405], [17.93, -13.758], [18.533, -10.7], [19.217, -7.96], [20.671, -5.539], [22.407, -2.95]];

difference() {
  union() {
    /* grip outline extruded straight up */
    linear_extrude(height = grip_h) polygon(grip);
    /* boss sunk half a millimetre into the grip */
    translate([0, 0, grip_h - 0.5]) cylinder(h = boss_h + 0.5, d = boss_d);
  }
  /* threaded bore through grip and boss */
  translate([0, 0, -2.5]) cylinder(h = grip_h + boss_h + 5, d = bore_d);
  translate([0, 0, 2.0]) rotate_extrude() polygon([[3.763, 0], [3.763, 16], [4.263, 16], [5.812, 15.125], [4.263, 14.25], [5.812, 13.375], [4.263, 12.5], [5.812, 11.625], [4.263, 10.75], [5.812, 9.875], [4.263, 9], [5.812, 8.125], [4.263, 7.25], [5.812, 6.375], [4.263, 5.5], [5.812, 4.625], [4.263, 3.75], [5.812, 2.875], [4.263, 0], [3.763, 0]]);
}
