$fn = 32;

// ----------------------------------------------------------------------
// Thumb nut: 5 lobe grip, 22 mm tall, M12.7 thread
// ----------------------------------------------------------------------

// --- parameters (mm) ---
base_r = 20;              // grip base radius
lobe_amp = 2.5;           // lobe height above the base radius
lobes = 5;                // number of grip lobes
grip_h = 14;              // grip height
boss_d = 22.7;            // threaded boss diameter
boss_h = 8;               // boss height
bore_d = 12.7;            // thread core diameter
pitch = 1.75;             // thread pitch
thread_d = 1.05;          // thread depth

grip = [[22.5, 0], [21.795, 2.869], [19.944, 5.344], [17.594, 7.288], [15.446, 8.917], [13.901, 10.666], [12.892, 12.892], [11.977, 15.608], [10.625, 18.403], [8.538, 20.611], [5.801, 21.651], [2.809, 21.338], [0, 20], [-2.412, 18.32], [-4.551, 16.986], [-6.77, 16.344], [-9.375, 16.238], [-12.374, 16.126], [-15.392, 15.392], [-17.833, 13.684], [-19.196, 11.083], [-19.361, 8.02], [-18.694, 5.009], [-17.862, 2.352], [-17.5, 0], [-17.862, -2.352], [-18.694, -5.009], [-19.361, -8.02], [-19.196, -11.083], [-17.833, -13.684], [-15.392, -15.392], [-12.374, -16.126], [-9.375, -16.238], [-6.77, -16.344], [-4.551, -16.986], [-2.412, -18.32], [0, -20], [2.809, -21.338], [5.801, -21.651], [8.538, -20.611], [10.625, -18.403], [11.977, -15.608], [12.892, -12.892], [13.901, -10.666], [15.446, -8.917], [17.594, -7.288], [19.944, -5.344], [21.795, -2.869]];

difference() {
  union() {
    /* grip outline extruded straight up */
    linear_extrude(height = grip_h) polygon(grip);
    /* boss sunk half a millimetre into the grip */
    translate([0, 0, grip_h - 0.5]) cylinder(h = boss_h + 0.5, d = boss_d);
  }
  /* threaded bore through grip and boss */
  translate([0, 0, -2.5]) cylinder(h = grip_h + boss_h + 5, d = bore_d);
  translate([0, 0, 2.0]) rotate_extrude() polygon([[5.35, 0], [5.35, 18], [5.85, 18], [7.4, 17.125], [5.85, 16.25], [7.4, 15.375], [5.85, 14.5], [7.4, 13.625], [5.85, 12.75], [7.4, 11.875], [5.85, 11], [7.4, 10.125], [5.85, 9.25], [7.4, 8.375], [5.85, 7.5], [7.4, 6.625], [5.85, 5.75], [7.4, 4.875], [5.85, 4], [7.4, 3.125], [5.85, 0], [5.35, 0]]);
