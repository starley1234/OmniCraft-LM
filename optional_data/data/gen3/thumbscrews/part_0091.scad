$fn = 32;

// ----------------------------------------------------------------------
// Thumb nut: 8 lobe grip, 20 mm tall, M9.53 thread
// ----------------------------------------------------------------------

// --- parameters (mm) ---
base_r = 20;              // grip base radius
lobe_amp = 2.5;           // lobe height above the base radius
lobes = 8;                // number of grip lobes
grip_h = 12;              // grip height
boss_d = 17.52;           // threaded boss diameter
boss_h = 8;               // boss height
bore_d = 9.53;            // thread core diameter
pitch = 1.75;             // thread pitch
thread_d = 1.05;          // thread depth

grip = [[22.5, 0], [21.068, 2.774], [18.111, 4.853], [16.168, 6.697], [16.238, 9.375], [16.859, 12.936], [15.91, 15.91], [12.936, 16.859], [9.375, 16.238], [6.697, 16.168], [4.853, 18.111], [2.774, 21.068], [0, 22.5], [-2.774, 21.068], [-4.853, 18.111], [-6.697, 16.168], [-9.375, 16.238], [-12.936, 16.859], [-15.91, 15.91], [-16.859, 12.936], [-16.238, 9.375], [-16.168, 6.697], [-18.111, 4.853], [-21.068, 2.774], [-22.5, 0], [-21.068, -2.774], [-18.111, -4.853], [-16.168, -6.697], [-16.238, -9.375], [-16.859, -12.936], [-15.91, -15.91], [-12.936, -16.859], [-9.375, -16.238], [-6.697, -16.168], [-4.853, -18.111], [-2.774, -21.068], [0, -22.5], [2.774, -21.068], [4.853, -18.111], [6.697, -16.168], [9.375, -16.238], [12.936, -16.859], [15.91, -15.91], [16.859, -12.936], [16.238, -9.375], [16.168, -6.697], [18.111, -4.853], [21.068, -2.774]];

difference() {
  union() {
    /* grip outline extruded straight up */
    linear_extrude(height = grip_h) polygon(grip);
    /* boss sunk half a millimetre into the grip */
    translate([0, 0, grip_h - 0.5]) cylinder(h = boss_h + 0.5, d = boss_d);
  }
  /* threaded bore through grip and boss */
  translate([0, 0, -2.5]) cylinder(h = grip_h + boss_h + 5, d = bore_d);
  translate([0, 0, 2.0]) rotate_extrude() polygon([[3.763, 0], [3.763, 16], [4.263, 16], [5.812, 15.125], [4.263, 14.25], [5.812, 13.375], [4.263, 12.5], [5.812, 11.625], [4.263, 10.75], [5.812, 9.875], [4.263, 9], [5.812, 8.125], [4.263, 7.25], [5.812, 6.375], [4.263, 5.5], [5.812, 4.625], [4.263, 3.75], [5.812, 2.875], [4.263, 0], [3.763, 0]]);
}
