$fn = 32;

// ----------------------------------------------------------------------
// Thumb nut: 6 lobe grip, 18 mm tall, M9.53 thread
// ----------------------------------------------------------------------

// --- parameters (mm) ---
base_r = 16;              // grip base radius
lobe_amp = 1.6;           // lobe height above the base radius
lobes = 6;                // number of grip lobes
grip_h = 12;              // grip height
boss_d = 17.52;           // threaded boss diameter
boss_h = 6;               // boss height
bore_d = 9.53;            // thread core diameter
pitch = 1.75;             // thread pitch
thread_d = 1.05;          // thread depth

grip = [[17.6, 0], [16.985, 2.236], [15.455, 4.141], [13.737, 5.69], [12.471, 7.2], [11.796, 9.051], [11.314, 11.314], [10.429, 13.591], [8.8, 15.242], [6.556, 15.827], [4.141, 15.455], [1.941, 14.741], [0, 14.4], [-1.941, 14.741], [-4.141, 15.455], [-6.556, 15.827], [-8.8, 15.242], [-10.429, 13.591], [-11.314, 11.314], [-11.796, 9.051], [-12.471, 7.2], [-13.737, 5.69], [-15.455, 4.141], [-16.985, 2.236], [-17.6, 0], [-16.985, -2.236], [-15.455, -4.141], [-13.737, -5.69], [-12.471, -7.2], [-11.796, -9.051], [-11.314, -11.314], [-10.429, -13.591], [-8.8, -15.242], [-6.556, -15.827], [-4.141, -15.455], [-1.941, -14.741], [0, -14.4], [1.941, -14.741], [4.141, -15.455], [6.556, -15.827], [8.8, -15.242], [10.429, -13.591], [11.314, -11.314], [11.796, -9.051], [12.471, -7.2], [13.737, -5.69], [15.455, -4.141], [16.985, -2.236]];

difference() {
  union() {
    /* grip outline extruded straight up */
    linear_extrude(height = grip_h) polygon(grip);
    /* boss sunk half a millimetre into the grip */
    translate([0, 0, grip_h - 0.5]) cylinder(h = boss_h + 0.5, d = boss_d);
  }
  /* threaded bore through grip and boss */
  translate([0, 0, -2.5]) cylinder(h = grip_h + boss_h + 5, d = bore_d);
  translate([0, 0, 2.0]) rotate_extrude() polygon([[3.763, 0], [3.763, 14], [4.263, 14], [5.812, 13.125], [4.263, 12.25], [5.812, 11.375], [4.263, 10.5], [5.812, 9.625], [4.263, 8.75], [5.812, 7.875], [4.263, 7], [5.812, 6.125], [4.263, 5.25], [5.812, 4.375], [4.263, 3.5], [5.812, 2.625], [4.263, 0], [3.763, 0]]);
}
