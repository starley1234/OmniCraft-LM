$fn = 32;

// ----------------------------------------------------------------------
// Thumb nut: 6 lobe grip, 14 mm tall, M6.35 thread
// ----------------------------------------------------------------------

// --- parameters (mm) ---
base_r = 20;              // grip base radius
lobe_amp = 1.6;           // lobe height above the base radius
lobes = 6;                // number of grip lobes
grip_h = 10;              // grip height
boss_d = 12.35;           // threaded boss diameter
boss_h = 4;               // boss height
bore_d = 6.35;            // thread core diameter
pitch = 1.75;             // thread pitch
thread_d = 1.05;          // thread depth

grip = [[21.6, 0], [20.951, 2.758], [19.319, 5.176], [17.432, 7.221], [15.935, 9.2], [14.969, 11.486], [14.142, 14.142], [12.864, 16.765], [10.8, 18.706], [8.087, 19.523], [5.176, 19.319], [2.463, 18.707], [0, 18.4], [-2.463, 18.707], [-5.176, 19.319], [-8.087, 19.523], [-10.8, 18.706], [-12.864, 16.765], [-14.142, 14.142], [-14.969, 11.486], [-15.935, 9.2], [-17.432, 7.221], [-19.319, 5.176], [-20.951, 2.758], [-21.6, 0], [-20.951, -2.758], [-19.319, -5.176], [-17.432, -7.221], [-15.935, -9.2], [-14.969, -11.486], [-14.142, -14.142], [-12.864, -16.765], [-10.8, -18.706], [-8.087, -19.523], [-5.176, -19.319], [-2.463, -18.707], [0, -18.4], [2.463, -18.707], [5.176, -19.319], [8.087, -19.523], [10.8, -18.706], [12.864, -16.765], [14.142, -14.142], [14.969, -11.486], [15.935, -9.2], [17.432, -7.221], [19.319, -5.176], [20.951, -2.758]];

difference() {
  union() {
    /* grip outline extruded straight up */
    linear_extrude(height = grip_h) polygon(grip);
    /* boss sunk half a millimetre into the grip */
    translate([0, 0, grip_h - 0.5]) cylinder(h = boss_h + 0.5, d = boss_d);
  }
  /* threaded bore through grip and boss */
  translate([0, 0, -2.5]) cylinder(h = grip_h + boss_h + 5, d = bore_d);
  translate([0, 0, 2.0]) rotate_extrude() polygon([[2.175, 0], [2.175, 10], [2.675, 10], [4.225, 9.125], [2.675, 8.25], [4.225, 7.375], [2.675, 6.5], [4.225, 5.625], [2.675, 4.75], [4.225, 3.875], [2.675, 3], [4.225, 2.125], [2.675, 0], [2.175, 0]]);
}
