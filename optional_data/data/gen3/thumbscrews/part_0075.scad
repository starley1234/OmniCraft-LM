$fn = 32;

// ----------------------------------------------------------------------
// Thumb nut: 7 lobe grip, 22 mm tall, M9.53 thread
// ----------------------------------------------------------------------

// --- parameters (mm) ---
base_r = 20;              // grip base radius
lobe_amp = 1.2;           // lobe height above the base radius
lobes = 7;                // number of grip lobes
grip_h = 14;              // grip height
boss_d = 17.52;           // threaded boss diameter
boss_h = 8;               // boss height
bore_d = 9.53;            // thread core diameter
pitch = 1.75;             // thread pitch
thread_d = 1.05;          // thread depth

grip = [[21.2, 0], [20.553, 2.706], [19.019, 5.096], [17.453, 7.229], [16.421, 9.48], [15.743, 12.08], [14.742, 14.742], [12.899, 16.811], [10.3, 17.84], [7.478, 18.053], [4.876, 18.199], [2.486, 18.885], [0, 20], [-2.735, 20.773], [-5.476, 20.438], [-7.829, 18.902], [-9.7, 16.801], [-11.451, 14.923], [-13.542, 13.542], [-15.991, 12.271], [-18.221, 10.52], [-19.502, 8.078], [-19.619, 5.257], [-19.105, 2.515], [-18.8, 0], [-19.105, -2.515], [-19.619, -5.257], [-19.502, -8.078], [-18.221, -10.52], [-15.991, -12.271], [-13.542, -13.542], [-11.451, -14.923], [-9.7, -16.801], [-7.829, -18.902], [-5.476, -20.438], [-2.735, -20.773], [0, -20], [2.486, -18.885], [4.876, -18.199], [7.478, -18.053], [10.3, -17.84], [12.899, -16.811], [14.742, -14.742], [15.743, -12.08], [16.421, -9.48], [17.453, -7.229], [19.019, -5.096], [20.553, -2.706]];

difference() {
  union() {
    /* grip outline extruded straight up */
    linear_extrude(height = grip_h) polygon(grip);
    /* boss sunk half a millimetre into the grip */
    translate([0, 0, grip_h - 0.5]) cylinder(h = boss_h + 0.5, d = boss_d);
  }
  /* threaded bore through grip and boss */
  translate([0, 0, -2.5]) cylinder(h = grip_h + boss_h + 5, d = bore_d);
  translate([0, 0, 2.0]) rotate_extrude() polygon([[3.763, 0], [3.763, 18], [4.263, 18], [5.812, 17.125], [4.263, 16.25], [5.812, 15.375], [4.263, 14.5], [5.812, 13.625], [4.263, 12.75], [5.812, 11.875], [4.263, 11], [5.812, 10.125], [4.263, 9.25], [5.812, 8.375], [4.263, 7.5], [5.812, 6.625], [4.263, 5.75], [5.812, 4.875], [4.263, 4], [5.812, 3.125], [4.263, 0], [3.763, 0]]);
