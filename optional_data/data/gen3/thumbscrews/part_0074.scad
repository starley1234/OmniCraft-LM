$fn = 32;

// ----------------------------------------------------------------------
// Thumb nut: 7 lobe grip, 20 mm tall, M6.35 thread
// ----------------------------------------------------------------------

// --- parameters (mm) ---
base_r = 18;              // grip base radius
lobe_amp = 1.6;           // lobe height above the base radius
lobes = 7;                // number of grip lobes
grip_h = 16;              // grip height
boss_d = 14.35;           // threaded boss diameter
boss_h = 4;               // boss height
bore_d = 6.35;            // thread core diameter
pitch = 1.75;             // thread pitch
thread_d = 1.05;          // thread depth

grip = [[19.6, 0], [18.812, 2.477], [16.987, 4.552], [15.264, 6.323], [14.388, 8.307], [14.115, 10.831], [13.528, 13.528], [11.923, 15.539], [9.4, 16.281], [6.654, 16.064], [4.259, 15.894], [2.184, 16.588], [0, 18], [-2.515, 19.105], [-5.059, 18.879], [-7.123, 17.196], [-8.6, 14.896], [-9.992, 13.022], [-11.928, 11.928], [-14.446, 11.085], [-16.788, 9.693], [-17.996, 7.454], [-17.787, 4.766], [-16.88, 2.222], [-16.4, 0], [-16.88, -2.222], [-17.787, -4.766], [-17.996, -7.454], [-16.788, -9.693], [-14.446, -11.085], [-11.928, -11.928], [-9.992, -13.022], [-8.6, -14.896], [-7.123, -17.196], [-5.059, -18.879], [-2.515, -19.105], [0, -18], [2.184, -16.588], [4.259, -15.894], [6.654, -16.064], [9.4, -16.281], [11.923, -15.539], [13.528, -13.528], [14.115, -10.831], [14.388, -8.307], [15.264, -6.323], [16.987, -4.552], [18.812, -2.477]];

difference() {
  union() {
    /* grip outline extruded straight up */
    linear_extrude(height = grip_h) polygon(grip);
    /* boss sunk half a millimetre into the grip */
    translate([0, 0, grip_h - 0.5]) cylinder(h = boss_h + 0.5, d = boss_d);
  }
  /* threaded bore through grip and boss */
  translate([0, 0, -2.5]) cylinder(h = grip_h + boss_h + 5, d = bore_d);
  translate([0, 0, 2.0]) rotate_extrude() polygon([[2.175, 0], [2.175, 16], [2.675, 16], [4.225, 15.125], [2.675, 14.25], [4.225, 13.375], [2.675, 12.5], [4.225, 11.625], [2.675, 10.75], [4.225, 9.875], [2.675, 9], [4.225, 8.125], [2.675, 7.25], [4.225, 6.375], [2.675, 5.5], [4.225, 4.625], [2.675, 3.75], [4.225, 2.875], [2.675, 0], [2.175, 0]]);
}
