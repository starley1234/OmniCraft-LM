$fn = 32;

// ----------------------------------------------------------------------
// Thumb nut: 4 lobe grip, 16 mm tall, M9.53 thread
// ----------------------------------------------------------------------

// --- parameters (mm) ---
base_r = 18;              // grip base radius
lobe_amp = 2.5;           // lobe height above the base radius
lobes = 4;                // number of grip lobes
grip_h = 10;              // grip height
boss_d = 19.52;           // threaded boss diameter
boss_h = 6;               // boss height
bore_d = 9.53;            // thread core diameter
pitch = 1.75;             // thread pitch
thread_d = 1.05;          // thread depth

grip = [[20.5, 0], [19.993, 2.632], [18.594, 4.982], [16.63, 6.888], [14.506, 8.375], [12.563, 9.64], [10.96, 10.96], [9.64, 12.563], [8.375, 14.506], [6.888, 16.63], [4.982, 18.594], [2.632, 19.993], [0, 20.5], [-2.632, 19.993], [-4.982, 18.594], [-6.888, 16.63], [-8.375, 14.506], [-9.64, 12.563], [-10.96, 10.96], [-12.563, 9.64], [-14.506, 8.375], [-16.63, 6.888], [-18.594, 4.982], [-19.993, 2.632], [-20.5, 0], [-19.993, -2.632], [-18.594, -4.982], [-16.63, -6.888], [-14.506, -8.375], [-12.563, -9.64], [-10.96, -10.96], [-9.64, -12.563], [-8.375, -14.506], [-6.888, -16.63], [-4.982, -18.594], [-2.632, -19.993], [0, -20.5], [2.632, -19.993], [4.982, -18.594], [6.888, -16.63], [8.375, -14.506], [9.64, -12.563], [10.96, -10.96], [12.563, -9.64], [14.506, -8.375], [16.63, -6.888], [18.594, -4.982], [19.993, -2.632]];

difference() {
  union() {
    /* grip outline extruded straight up */
    linear_extrude(height = grip_h) polygon(grip);
    /* boss sunk half a millimetre into the grip */
    translate([0, 0, grip_h - 0.5]) cylinder(h = boss_h + 0.5, d = boss_d);
  }
  /* threaded bore through grip and boss */
  translate([0, 0, -2.5]) cylinder(h = grip_h + boss_h + 5, d = bore_d);
  translate([0, 0, 2.0]) rotate_extrude() polygon([[3.763, 0], [3.763, 12], [4.263, 12], [5.812, 11.125], [4.263, 10.25], [5.812, 9.375], [4.263, 8.5], [5.812, 7.625], [4.263, 6.75], [5.812, 5.875], [4.263, 5], [5.812, 4.125], [4.263, 3.25], [5.812, 2.375], [4.263, 0], [3.763, 0]]);
}
