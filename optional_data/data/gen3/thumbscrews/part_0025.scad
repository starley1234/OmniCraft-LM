$fn = 32;

// ----------------------------------------------------------------------
// Thumb nut: 4 lobe grip, 24 mm tall, M12.7 thread
// ----------------------------------------------------------------------

// --- parameters (mm) ---
base_r = 18;              // grip base radius
lobe_amp = 1.6;           // lobe height above the base radius
lobes = 4;                // number of grip lobes
grip_h = 16;              // grip height
boss_d = 18.7;            // threaded boss diameter
boss_h = 8;               // boss height
bore_d = 12.7;            // thread core diameter
pitch = 1.75;             // thread pitch
thread_d = 1.05;          // thread depth

grip = [[19.6, 0], [19.22, 2.53], [18.159, 4.866], [16.63, 6.888], [14.896, 8.6], [13.181, 10.114], [11.597, 11.597], [10.114, 13.181], [8.6, 14.896], [6.888, 16.63], [4.866, 18.159], [2.53, 19.22], [0, 19.6], [-2.53, 19.22], [-4.866, 18.159], [-6.888, 16.63], [-8.6, 14.896], [-10.114, 13.181], [-11.597, 11.597], [-13.181, 10.114], [-14.896, 8.6], [-16.63, 6.888], [-18.159, 4.866], [-19.22, 2.53], [-19.6, 0], [-19.22, -2.53], [-18.159, -4.866], [-16.63, -6.888], [-14.896, -8.6], [-13.181, -10.114], [-11.597, -11.597], [-10.114, -13.181], [-8.6, -14.896], [-6.888, -16.63], [-4.866, -18.159], [-2.53, -19.22], [0, -19.6], [2.53, -19.22], [4.866, -18.159], [6.888, -16.63], [8.6, -14.896], [10.114, -13.181], [11.597, -11.597], [13.181, -10.114], [14.896, -8.6], [16.63, -6.888], [18.159, -4.866], [19.22, -2.53]];

difference() {
  union() {
    /* grip outline extruded straight up */
    linear_extrude(height = grip_h) polygon(grip);
    /* boss sunk half a millimetre into the grip */
    translate([0, 0, grip_h - 0.5]) cylinder(h = boss_h + 0.5, d = boss_d);
  }
  /* threaded bore through grip and boss */
  translate([0, 0, -2.5]) cylinder(h = grip_h + boss_h + 5, d = bore_d);
  translate([0, 0, 2.0]) rotate_extrude() polygon([[5.35, 0], [5.35, 20], [5.85, 20], [7.4, 19.125], [5.85, 18.25], [7.4, 17.375], [5.85, 16.5], [7.4, 15.625], [5.85, 14.75], [7.4, 13.875], [5.85, 13], [7.4, 12.125], [5.85, 11.25], [7.4, 10.375], [5.85, 9.5], [7.4, 8.625], [5.85, 7.75], [7.4, 6.875], [5.85, 6], [7.4, 5.125], [5.85, 4.25], [7.4, 3.375], [5.85, 2.5], [7.4, 1.625], [5.85, 0], [5.35, 0]]);
