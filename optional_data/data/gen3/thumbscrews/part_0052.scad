$fn = 32;

// ----------------------------------------------------------------------
// Thumb nut: 5 lobe grip, 18 mm tall, M9.53 thread
// ----------------------------------------------------------------------

// --- parameters (mm) ---
base_r = 18;              // grip base radius
lobe_amp = 1.2;           // lobe height above the base radius
lobes = 5;                // number of grip lobes
grip_h = 10;              // grip height
boss_d = 17.52;           // threaded boss diameter
boss_h = 8;               // boss height
bore_d = 9.53;            // thread core diameter
pitch = 1.75;             // thread pitch
thread_d = 1.05;          // thread depth

grip = [[19.2, 0], [18.79, 2.474], [17.687, 4.739], [16.206, 6.713], [14.688, 8.48], [13.336, 10.233], [12.128, 12.128], [10.862, 14.156], [9.3, 16.108], [7.313, 17.654], [4.959, 18.506], [2.445, 18.57], [0, 18], [-2.254, 17.122], [-4.359, 16.267], [-6.464, 15.606], [-8.7, 15.069], [-11.053, 14.405], [-13.328, 13.328], [-15.224, 11.682], [-16.488, 9.52], [-17.054, 7.064], [-17.087, 4.578], [-16.902, 2.225], [-16.8, 0], [-16.902, -2.225], [-17.087, -4.578], [-17.054, -7.064], [-16.488, -9.52], [-15.224, -11.682], [-13.328, -13.328], [-11.053, -14.405], [-8.7, -15.069], [-6.464, -15.606], [-4.359, -16.267], [-2.254, -17.122], [0, -18], [2.445, -18.57], [4.959, -18.506], [7.313, -17.654], [9.3, -16.108], [10.862, -14.156], [12.128, -12.128], [13.336, -10.233], [14.688, -8.48], [16.206, -6.713], [17.687, -4.739], [18.79, -2.474]];

difference() {
  union() {
    /* grip outline extruded straight up */
    linear_extrude(height = grip_h) polygon(grip);
    /* boss sunk half a millimetre into the grip */
    translate([0, 0, grip_h - 0.5]) cylinder(h = boss_h + 0.5, d = boss_d);
  }
  /* threaded bore through grip and boss */
  translate([0, 0, -2.5]) cylinder(h = grip_h + boss_h + 5, d = bore_d);
  translate([0, 0, 2.0]) rotate_extrude() polygon([[3.763, 0], [3.763, 14], [4.263, 14], [5.812, 13.125], [4.263, 12.25], [5.812, 11.375], [4.263, 10.5], [5.812, 9.625], [4.263, 8.75], [5.812, 7.875], [4.263, 7], [5.812, 6.125], [4.263, 5.25], [5.812, 4.375], [4.263, 3.5], [5.812, 2.625], [4.263, 0], [3.763, 0]]);
}
