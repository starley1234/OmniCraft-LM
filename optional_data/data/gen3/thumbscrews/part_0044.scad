$fn = 32;

// ----------------------------------------------------------------------
// Thumb nut: 4 lobe grip, 20 mm tall, M9.53 thread
// ----------------------------------------------------------------------

// --- parameters (mm) ---
base_r = 18;              // grip base radius
lobe_amp = 2;             // lobe height above the base radius
lobes = 4;                // number of grip lobes
grip_h = 12;              // grip height
boss_d = 15.53;           // threaded boss diameter
boss_h = 8;               // boss height
bore_d = 9.53;            // thread core diameter
pitch = 1.75;             // thread pitch
thread_d = 1.05;          // thread depth

grip = [[20, 0], [19.563, 2.576], [18.353, 4.918], [16.63, 6.888], [14.722, 8.5], [12.906, 9.903], [11.314, 11.314], [9.903, 12.906], [8.5, 14.722], [6.888, 16.63], [4.918, 18.353], [2.576, 19.563], [0, 20], [-2.576, 19.563], [-4.918, 18.353], [-6.888, 16.63], [-8.5, 14.722], [-9.903, 12.906], [-11.314, 11.314], [-12.906, 9.903], [-14.722, 8.5], [-16.63, 6.888], [-18.353, 4.918], [-19.563, 2.576], [-20, 0], [-19.563, -2.576], [-18.353, -4.918], [-16.63, -6.888], [-14.722, -8.5], [-12.906, -9.903], [-11.314, -11.314], [-9.903, -12.906], [-8.5, -14.722], [-6.888, -16.63], [-4.918, -18.353], [-2.576, -19.563], [0, -20], [2.576, -19.563], [4.918, -18.353], [6.888, -16.63], [8.5, -14.722], [9.903, -12.906], [11.314, -11.314], [12.906, -9.903], [14.722, -8.5], [16.63, -6.888], [18.353, -4.918], [19.563, -2.576]];

difference() {
  union() {
    /* grip outline extruded straight up */
    linear_extrude(height = grip_h) polygon(grip);
    /* boss sunk half a millimetre into the grip */
    translate([0, 0, grip_h - 0.5]) cylinder(h = boss_h + 0.5, d = boss_d);
  }
  /* threaded bore through grip and boss */
  translate([0, 0, -2.5]) cylinder(h = grip_h + boss_h + 5, d = bore_d);
  translate([0, 0, 2.0]) rotate_extrude() polygon([[3.763, 0], [3.763, 16], [4.263, 16], [5.812, 15.125], [4.263, 14.25], [5.812, 13.375], [4.263, 12.5], [5.812, 11.625], [4.263, 10.75], [5.812, 9.875], [4.263, 9], [5.812, 8.125], [4.263, 7.25], [5.812, 6.375], [4.263, 5.5], [5.812, 4.625], [4.263, 3.75], [5.812, 2.875], [4.263, 0], [3.763, 0]]);
}
