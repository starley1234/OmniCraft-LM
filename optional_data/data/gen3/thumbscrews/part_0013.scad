$fn = 32;

// ----------------------------------------------------------------------
// Thumb nut: 4 lobe grip, 14 mm tall, M12.7 thread
// ----------------------------------------------------------------------

// --- parameters (mm) ---
base_r = 20;              // grip base radius
lobe_amp = 2;             // lobe height above the base radius
lobes = 4;                // number of grip lobes
grip_h = 10;              // grip height
boss_d = 22.7;            // threaded boss diameter
boss_h = 4;               // boss height
bore_d = 12.7;            // thread core diameter
pitch = 1.75;             // thread pitch
thread_d = 1.05;          // thread depth

grip = [[22, 0], [21.546, 2.837], [20.284, 5.435], [18.478, 7.654], [16.454, 9.5], [14.493, 11.121], [12.728, 12.728], [11.121, 14.493], [9.5, 16.454], [7.654, 18.478], [5.435, 20.284], [2.837, 21.546], [0, 22], [-2.837, 21.546], [-5.435, 20.284], [-7.654, 18.478], [-9.5, 16.454], [-11.121, 14.493], [-12.728, 12.728], [-14.493, 11.121], [-16.454, 9.5], [-18.478, 7.654], [-20.284, 5.435], [-21.546, 2.837], [-22, 0], [-21.546, -2.837], [-20.284, -5.435], [-18.478, -7.654], [-16.454, -9.5], [-14.493, -11.121], [-12.728, -12.728], [-11.121, -14.493], [-9.5, -16.454], [-7.654, -18.478], [-5.435, -20.284], [-2.837, -21.546], [0, -22], [2.837, -21.546], [5.435, -20.284], [7.654, -18.478], [9.5, -16.454], [11.121, -14.493], [12.728, -12.728], [14.493, -11.121], [16.454, -9.5], [18.478, -7.654], [20.284, -5.435], [21.546, -2.837]];

difference() {
  union() {
    /* grip outline extruded straight up */
    linear_extrude(height = grip_h) polygon(grip);
    /* boss sunk half a millimetre into the grip */
    translate([0, 0, grip_h - 0.5]) cylinder(h = boss_h + 0.5, d = boss_d);
  }
  /* threaded bore through grip and boss */
  translate([0, 0, -2.5]) cylinder(h = grip_h + boss_h + 5, d = bore_d);
  translate([0, 0, 2.0]) rotate_extrude() polygon([[5.35, 0], [5.35, 10], [5.85, 10], [7.4, 9.125], [5.85, 8.25], [7.4, 7.375], [5.85, 6.5], [7.4, 5.625], [5.85, 4.75], [7.4, 3.875], [5.85, 3], [7.4, 2.125], [5.85, 0], [5.35, 0]]);
}
