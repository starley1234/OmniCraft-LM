$fn = 32;

// ----------------------------------------------------------------------
// Thumb nut: 4 lobe grip, 16 mm tall, M9.53 thread
// ----------------------------------------------------------------------

// --- parameters (mm) ---
base_r = 22;              // grip base radius
lobe_amp = 1.6;           // lobe height above the base radius
lobes = 4;                // number of grip lobes
grip_h = 12;              // grip height
boss_d = 15.53;           // threaded boss diameter
boss_h = 4;               // boss height
bore_d = 9.53;            // thread core diameter
pitch = 1.75;             // thread pitch
thread_d = 1.05;          // thread depth

grip = [[23.6, 0], [23.186, 3.052], [22.023, 5.901], [20.325, 8.419], [18.36, 10.6], [16.354, 12.549], [14.425, 14.425], [12.549, 16.354], [10.6, 18.36], [8.419, 20.325], [5.901, 22.023], [3.052, 23.186], [0, 23.6], [-3.052, 23.186], [-5.901, 22.023], [-8.419, 20.325], [-10.6, 18.36], [-12.549, 16.354], [-14.425, 14.425], [-16.354, 12.549], [-18.36, 10.6], [-20.325, 8.419], [-22.023, 5.901], [-23.186, 3.052], [-23.6, 0], [-23.186, -3.052], [-22.023, -5.901], [-20.325, -8.419], [-18.36, -10.6], [-16.354, -12.549], [-14.425, -14.425], [-12.549, -16.354], [-10.6, -18.36], [-8.419, -20.325], [-5.901, -22.023], [-3.052, -23.186], [0, -23.6], [3.052, -23.186], [5.901, -22.023], [8.419, -20.325], [10.6, -18.36], [12.549, -16.354], [14.425, -14.425], [16.354, -12.549], [18.36, -10.6], [20.325, -8.419], [22.023, -5.901], [23.186, -3.052]];

difference() {
  union() {
    /* grip outline extruded straight up */
    linear_extrude(height = grip_h) polygon(grip);
    /* boss sunk half a millimetre into the grip */
    translate([0, 0, grip_h - 0.5]) cylinder(h = boss_h + 0.5, d = boss_d);
  }
  /* threaded bore through grip and boss */
  translate([0, 0, -2.5]) cylinder(h = grip_h + boss_h + 5, d = bore_d);
  translate([0, 0, 2.0]) rotate_extrude() polygon([[3.763, 0], [3.763, 12], [4.263, 12], [5.812, 11.125], [4.263, 10.25], [5.812, 9.375], [4.263, 8.5], [5.812, 7.625], [4.263, 6.75], [5.812, 5.875], [4.263, 5], [5.812, 4.125], [4.263, 3.25], [5.812, 2.375], [4.263, 0], [3.763, 0]]);
}
