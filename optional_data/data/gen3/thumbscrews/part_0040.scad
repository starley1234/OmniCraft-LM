$fn = 32;

// ----------------------------------------------------------------------
// Thumb nut: 7 lobe grip, 24 mm tall, M12.7 thread
// ----------------------------------------------------------------------

// --- parameters (mm) ---
base_r = 18;              // grip base radius
lobe_amp = 2;             // lobe height above the base radius
lobes = 7;                // number of grip lobes
grip_h = 16;              // grip height
boss_d = 20.7;            // threaded boss diameter
boss_h = 8;               // boss height
bore_d = 12.7;            // thread core diameter
pitch = 1.75;             // thread pitch
thread_d = 1.05;          // thread depth

grip = [[20, 0], [19.053, 2.508], [16.887, 4.525], [14.923, 6.181], [14.088, 8.134], [14.073, 10.799], [13.728, 13.728], [12.165, 15.853], [9.5, 16.454], [6.595, 15.923], [4.159, 15.521], [2.142, 16.273], [0, 18], [-2.557, 19.419], [-5.159, 19.253], [-7.181, 17.337], [-8.5, 14.722], [-9.751, 12.707], [-11.728, 11.728], [-14.487, 11.117], [-17.088, 9.866], [-18.337, 7.595], [-17.887, 4.793], [-16.639, 2.191], [-16, 0], [-16.639, -2.191], [-17.887, -4.793], [-18.337, -7.595], [-17.088, -9.866], [-14.487, -11.117], [-11.728, -11.728], [-9.751, -12.707], [-8.5, -14.722], [-7.181, -17.337], [-5.159, -19.253], [-2.557, -19.419], [0, -18], [2.142, -16.273], [4.159, -15.521], [6.595, -15.923], [9.5, -16.454], [12.165, -15.853], [13.728, -13.728], [14.073, -10.799], [14.088, -8.134], [14.923, -6.181], [16.887, -4.525], [19.053, -2.508]];

difference() {
  union() {
    /* grip outline extruded straight up */
    linear_extrude(height = grip_h) polygon(grip);
    /* boss sunk half a millimetre into the grip */
    translate([0, 0, grip_h - 0.5]) cylinder(h = boss_h + 0.5, d = boss_d);
  }
  /* threaded bore through grip and boss */
  translate([0, 0, -2.5]) cylinder(h = grip_h + boss_h + 5, d = bore_d);
  translate([0, 0, 2.0]) rotate_extrude() polygon([[5.35, 0], [5.35, 20], [5.85, 20], [7.4, 19.125], [5.85, 18.25], [7.4, 17.375], [5.85, 16.5], [7.4, 15.625], [5.85, 14.75], [7.4, 13.875], [5.85, 13], [7.4, 12.125], [5.85, 11.25], [7.4, 10.375], [5.85, 9.5], [7.4, 8.625], [5.85, 7.75], [7.4, 6.875], [5.85, 6], [7.4, 5.125], [5.85, 4.25], [7.4, 3.375], [5.85, 2.5], [7.4, 1.625], [5.85, 0], [5.35, 0]]);
