$fn = 32;

// ----------------------------------------------------------------------
// Thumb nut: 7 lobe grip, 22 mm tall, M6.35 thread
// ----------------------------------------------------------------------

// --- parameters (mm) ---
base_r = 18;              // grip base radius
lobe_amp = 1.2;           // lobe height above the base radius
lobes = 7;                // number of grip lobes
grip_h = 14;              // grip height
boss_d = 12.35;           // threaded boss diameter
boss_h = 8;               // boss height
bore_d = 6.35;            // thread core diameter
pitch = 1.75;             // thread pitch
thread_d = 1.05;          // thread depth

grip = [[19.2, 0], [18.57, 2.445], [17.087, 4.578], [15.606, 6.464], [14.688, 8.48], [14.156, 10.862], [13.328, 13.328], [11.682, 15.224], [9.3, 16.108], [6.713, 16.206], [4.359, 16.267], [2.225, 16.902], [0, 18], [-2.474, 18.79], [-4.959, 18.506], [-7.064, 17.054], [-8.7, 15.069], [-10.233, 13.336], [-12.128, 12.128], [-14.405, 11.053], [-16.488, 9.52], [-17.654, 7.313], [-17.687, 4.739], [-17.122, 2.254], [-16.8, 0], [-17.122, -2.254], [-17.687, -4.739], [-17.654, -7.313], [-16.488, -9.52], [-14.405, -11.053], [-12.128, -12.128], [-10.233, -13.336], [-8.7, -15.069], [-7.064, -17.054], [-4.959, -18.506], [-2.474, -18.79], [0, -18], [2.225, -16.902], [4.359, -16.267], [6.713, -16.206], [9.3, -16.108], [11.682, -15.224], [13.328, -13.328], [14.156, -10.862], [14.688, -8.48], [15.606, -6.464], [17.087, -4.578], [18.57, -2.445]];

difference() {
  union() {
    /* grip outline extruded straight up */
    linear_extrude(height = grip_h) polygon(grip);
    /* boss sunk half a millimetre into the grip */
    translate([0, 0, grip_h - 0.5]) cylinder(h = boss_h + 0.5, d = boss_d);
  }
  /* threaded bore through grip and boss */
  translate([0, 0, -2.5]) cylinder(h = grip_h + boss_h + 5, d = bore_d);
  translate([0, 0, 2.0]) rotate_extrude() polygon([[2.175, 0], [2.175, 18], [2.675, 18], [4.225, 17.125], [2.675, 16.25], [4.225, 15.375], [2.675, 14.5], [4.225, 13.625], [2.675, 12.75], [4.225, 11.875], [2.675, 11], [4.225, 10.125], [2.675, 9.25], [4.225, 8.375], [2.675, 7.5], [4.225, 6.625], [2.675, 5.75], [4.225, 4.875], [2.675, 4], [4.225, 3.125], [2.675, 0], [2.175, 0]]);
}
