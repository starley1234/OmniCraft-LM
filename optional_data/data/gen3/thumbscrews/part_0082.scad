$fn = 32;

// ----------------------------------------------------------------------
// Thumb nut: 8 lobe grip, 16 mm tall, M7.94 thread
// ----------------------------------------------------------------------

// --- parameters (mm) ---
base_r = 20;              // grip base radius
lobe_amp = 1.2;           // lobe height above the base radius
lobes = 8;                // number of grip lobes
grip_h = 12;              // grip height
boss_d = 17.94;           // threaded boss diameter
boss_h = 4;               // boss height
bore_d = 7.94;            // thread core diameter
pitch = 1.75;             // thread pitch
thread_d = 1.05;          // thread depth

grip = [[21.2, 0], [20.424, 2.689], [18.739, 5.021], [17.369, 7.194], [16.801, 9.7], [16.343, 12.54], [14.991, 14.991], [12.54, 16.343], [9.7, 16.801], [7.194, 17.369], [5.021, 18.739], [2.689, 20.424], [0, 21.2], [-2.689, 20.424], [-5.021, 18.739], [-7.194, 17.369], [-9.7, 16.801], [-12.54, 16.343], [-14.991, 14.991], [-16.343, 12.54], [-16.801, 9.7], [-17.369, 7.194], [-18.739, 5.021], [-20.424, 2.689], [-21.2, 0], [-20.424, -2.689], [-18.739, -5.021], [-17.369, -7.194], [-16.801, -9.7], [-16.343, -12.54], [-14.991, -14.991], [-12.54, -16.343], [-9.7, -16.801], [-7.194, -17.369], [-5.021, -18.739], [-2.689, -20.424], [0, -21.2], [2.689, -20.424], [5.021, -18.739], [7.194, -17.369], [9.7, -16.801], [12.54, -16.343], [14.991, -14.991], [16.343, -12.54], [16.801, -9.7], [17.369, -7.194], [18.739, -5.021], [20.424, -2.689]];

difference() {
  union() {
    /* grip outline extruded straight up */
    linear_extrude(height = grip_h) polygon(grip);
    /* boss sunk half a millimetre into the grip */
    translate([0, 0, grip_h - 0.5]) cylinder(h = boss_h + 0.5, d = boss_d);
  }
  /* threaded bore through grip and boss */
  translate([0, 0, -2.5]) cylinder(h = grip_h + boss_h + 5, d = bore_d);
  translate([0, 0, 2.0]) rotate_extrude() polygon([[2.969, 0], [2.969, 12], [3.469, 12], [5.019, 11.125], [3.469, 10.25], [5.019, 9.375], [3.469, 8.5], [5.019, 7.625], [3.469, 6.75], [5.019, 5.875], [3.469, 5], [5.019, 4.125], [3.469, 3.25], [5.019, 2.375], [3.469, 0], [2.969, 0]]);
}
