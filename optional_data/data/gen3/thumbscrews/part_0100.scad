$fn = 32;

// ----------------------------------------------------------------------
// Thumb nut: 8 lobe grip, 16 mm tall, M6.35 thread
// ----------------------------------------------------------------------

// --- parameters (mm) ---
base_r = 20;              // grip base radius
lobe_amp = 2;             // lobe height above the base radius
lobes = 8;                // number of grip lobes
grip_h = 10;              // grip height
boss_d = 12.35;           // threaded boss diameter
boss_h = 6;               // boss height
bore_d = 6.35;            // thread core diameter
pitch = 1.75;             // thread pitch
thread_d = 1.05;          // thread depth

grip = [[22, 0], [20.82, 2.741], [18.353, 4.918], [16.63, 6.888], [16.454, 9.5], [16.66, 12.784], [15.556, 15.556], [12.784, 16.66], [9.5, 16.454], [6.888, 16.63], [4.918, 18.353], [2.741, 20.82], [0, 22], [-2.741, 20.82], [-4.918, 18.353], [-6.888, 16.63], [-9.5, 16.454], [-12.784, 16.66], [-15.556, 15.556], [-16.66, 12.784], [-16.454, 9.5], [-16.63, 6.888], [-18.353, 4.918], [-20.82, 2.741], [-22, 0], [-20.82, -2.741], [-18.353, -4.918], [-16.63, -6.888], [-16.454, -9.5], [-16.66, -12.784], [-15.556, -15.556], [-12.784, -16.66], [-9.5, -16.454], [-6.888, -16.63], [-4.918, -18.353], [-2.741, -20.82], [0, -22], [2.741, -20.82], [4.918, -18.353], [6.888, -16.63], [9.5, -16.454], [12.784, -16.66], [15.556, -15.556], [16.66, -12.784], [16.454, -9.5], [16.63, -6.888], [18.353, -4.918], [20.82, -2.741]];

difference() {
  union() {
    /* grip outline extruded straight up */
    linear_extrude(height = grip_h) polygon(grip);
    /* boss sunk half a millimetre into the grip */
    translate([0, 0, grip_h - 0.5]) cylinder(h = boss_h + 0.5, d = boss_d);
  }
  /* threaded bore through grip and boss */
  translate([0, 0, -2.5]) cylinder(h = grip_h + boss_h + 5, d = bore_d);
  translate([0, 0, 2.0]) rotate_extrude() polygon([[2.175, 0], [2.175, 12], [2.675, 12], [4.225, 11.125], [2.675, 10.25], [4.225, 9.375], [2.675, 8.5], [4.225, 7.625], [2.675, 6.75], [4.225, 5.875], [2.675, 5], [4.225, 4.125], [2.675, 3.25], [4.225, 2.375], [2.675, 0], [2.175, 0]]);
}
