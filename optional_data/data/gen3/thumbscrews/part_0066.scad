$fn = 32;

// ----------------------------------------------------------------------
// Thumb nut: 8 lobe grip, 16 mm tall, M7.94 thread
// ----------------------------------------------------------------------

// --- parameters (mm) ---
base_r = 22;              // grip base radius
lobe_amp = 2.5;           // lobe height above the base radius
lobes = 8;                // number of grip lobes
grip_h = 12;              // grip height
boss_d = 17.94;           // threaded boss diameter
boss_h = 4;               // boss height
bore_d = 7.94;            // thread core diameter
pitch = 1.75;             // thread pitch
thread_d = 1.05;          // thread depth

grip = [[24.5, 0], [23.051, 3.035], [20.043, 5.37], [18.016, 7.462], [17.97, 10.375], [18.445, 14.154], [17.324, 17.324], [14.154, 18.445], [10.375, 17.97], [7.462, 18.016], [5.37, 20.043], [3.035, 23.051], [0, 24.5], [-3.035, 23.051], [-5.37, 20.043], [-7.462, 18.016], [-10.375, 17.97], [-14.154, 18.445], [-17.324, 17.324], [-18.445, 14.154], [-17.97, 10.375], [-18.016, 7.462], [-20.043, 5.37], [-23.051, 3.035], [-24.5, 0], [-23.051, -3.035], [-20.043, -5.37], [-18.016, -7.462], [-17.97, -10.375], [-18.445, -14.154], [-17.324, -17.324], [-14.154, -18.445], [-10.375, -17.97], [-7.462, -18.016], [-5.37, -20.043], [-3.035, -23.051], [0, -24.5], [3.035, -23.051], [5.37, -20.043], [7.462, -18.016], [10.375, -17.97], [14.154, -18.445], [17.324, -17.324], [18.445, -14.154], [17.97, -10.375], [18.016, -7.462], [20.043, -5.37], [23.051, -3.035]];

difference() {
  union() {
    /* grip outline extruded straight up */
    linear_extrude(height = grip_h) polygon(grip);
    /* boss sunk half a millimetre into the grip */
    translate([0, 0, grip_h - 0.5]) cylinder(h = boss_h + 0.5, d = boss_d);
  }
  /* threaded bore through grip and boss */
  translate([0, 0, -2.5]) cylinder(h = grip_h + boss_h + 5, d = bore_d);
  translate([0, 0, 2.0]) rotate_extrude() polygon([[2.969, 0], [2.969, 12], [3.469, 12], [5.019, 11.125], [3.469, 10.25], [5.019, 9.375], [3.469, 8.5], [5.019, 7.625], [3.469, 6.75], [5.019, 5.875], [3.469, 5], [5.019, 4.125], [3.469, 3.25], [5.019, 2.375], [3.469, 0], [2.969, 0]]);
}
