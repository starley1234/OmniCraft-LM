$fn = 32;

// ----------------------------------------------------------------------
// Thumb nut: 5 lobe grip, 20 mm tall, M9.53 thread
// ----------------------------------------------------------------------

// --- parameters (mm) ---
base_r = 16;              // grip base radius
lobe_amp = 2;             // lobe height above the base radius
lobes = 5;                // number of grip lobes
grip_h = 16;              // grip height
boss_d = 17.52;           // threaded boss diameter
boss_h = 4;               // boss height
bore_d = 9.53;            // thread core diameter
pitch = 1.75;             // thread pitch
thread_d = 1.05;          // thread depth

grip = [[18, 0], [17.436, 2.296], [15.955, 4.275], [14.075, 5.83], [12.356, 7.134], [11.121, 8.533], [10.314, 10.314], [9.581, 12.487], [8.5, 14.722], [6.83, 16.489], [4.641, 17.321], [2.247, 17.07], [0, 16], [-1.93, 14.656], [-3.641, 13.589], [-5.416, 13.075], [-7.5, 12.99], [-9.899, 12.901], [-12.314, 12.314], [-14.267, 10.947], [-15.356, 8.866], [-15.489, 6.416], [-14.955, 4.007], [-14.29, 1.881], [-14, 0], [-14.29, -1.881], [-14.955, -4.007], [-15.489, -6.416], [-15.356, -8.866], [-14.267, -10.947], [-12.314, -12.314], [-9.899, -12.901], [-7.5, -12.99], [-5.416, -13.075], [-3.641, -13.589], [-1.93, -14.656], [0, -16], [2.247, -17.07], [4.641, -17.321], [6.83, -16.489], [8.5, -14.722], [9.581, -12.487], [10.314, -10.314], [11.121, -8.533], [12.356, -7.134], [14.075, -5.83], [15.955, -4.275], [17.436, -2.296]];

difference() {
  union() {
    /* grip outline extruded straight up */
    linear_extrude(height = grip_h) polygon(grip);
    /* boss sunk half a millimetre into the grip */
    translate([0, 0, grip_h - 0.5]) cylinder(h = boss_h + 0.5, d = boss_d);
  }
  /* threaded bore through grip and boss */
  translate([0, 0, -2.5]) cylinder(h = grip_h + boss_h + 5, d = bore_d);
  translate([0, 0, 2.0]) rotate_extrude() polygon([[3.763, 0], [3.763, 16], [4.263, 16], [5.812, 15.125], [4.263, 14.25], [5.812, 13.375], [4.263, 12.5], [5.812, 11.625], [4.263, 10.75], [5.812, 9.875], [4.263, 9], [5.812, 8.125], [4.263, 7.25], [5.812, 6.375], [4.263, 5.5], [5.812, 4.625], [4.263, 3.75], [5.812, 2.875], [4.263, 0], [3.763, 0]]);
}
