$fn = 32;

// ----------------------------------------------------------------------
// Thumb nut: 4 lobe grip, 18 mm tall, M7.94 thread
// ----------------------------------------------------------------------

// --- parameters (mm) ---
base_r = 22;              // grip base radius
lobe_amp = 2;             // lobe height above the base radius
lobes = 4;                // number of grip lobes
grip_h = 12;              // grip height
boss_d = 15.94;           // threaded boss diameter
boss_h = 6;               // boss height
bore_d = 7.94;            // thread core diameter
pitch = 1.75;             // thread pitch
thread_d = 1.05;          // thread depth

grip = [[24, 0], [23.529, 3.098], [22.216, 5.953], [20.325, 8.419], [18.187, 10.5], [16.08, 12.338], [14.142, 14.142], [12.338, 16.08], [10.5, 18.187], [8.419, 20.325], [5.953, 22.216], [3.098, 23.529], [0, 24], [-3.098, 23.529], [-5.953, 22.216], [-8.419, 20.325], [-10.5, 18.187], [-12.338, 16.08], [-14.142, 14.142], [-16.08, 12.338], [-18.187, 10.5], [-20.325, 8.419], [-22.216, 5.953], [-23.529, 3.098], [-24, 0], [-23.529, -3.098], [-22.216, -5.953], [-20.325, -8.419], [-18.187, -10.5], [-16.08, -12.338], [-14.142, -14.142], [-12.338, -16.08], [-10.5, -18.187], [-8.419, -20.325], [-5.953, -22.216], [-3.098, -23.529], [0, -24], [3.098, -23.529], [5.953, -22.216], [8.419, -20.325], [10.5, -18.187], [12.338, -16.08], [14.142, -14.142], [16.08, -12.338], [18.187, -10.5], [20.325, -8.419], [22.216, -5.953], [23.529, -3.098]];

difference() {
  union() {
    /* grip outline extruded straight up */
    linear_extrude(height = grip_h) polygon(grip);
    /* boss sunk half a millimetre into the grip */
    translate([0, 0, grip_h - 0.5]) cylinder(h = boss_h + 0.5, d = boss_d);
  }
  /* threaded bore through grip and boss */
  translate([0, 0, -2.5]) cylinder(h = grip_h + boss_h + 5, d = bore_d);
  translate([0, 0, 2.0]) rotate_extrude() polygon([[2.969, 0], [2.969, 14], [3.469, 14], [5.019, 13.125], [3.469, 12.25], [5.019, 11.375], [3.469, 10.5], [5.019, 9.625], [3.469, 8.75], [5.019, 7.875], [3.469, 7], [5.019, 6.125], [3.469, 5.25], [5.019, 4.375], [3.469, 3.5], [5.019, 2.625], [3.469, 0], [2.969, 0]]);
}
