$fn = 32;

// ----------------------------------------------------------------------
// Thumb nut: 7 lobe grip, 18 mm tall, M12.7 thread
// ----------------------------------------------------------------------

// --- parameters (mm) ---
base_r = 14;              // grip base radius
lobe_amp = 1.2;           // lobe height above the base radius
lobes = 7;                // number of grip lobes
grip_h = 14;              // grip height
boss_d = 22;              // threaded boss diameter
boss_h = 4;               // boss height
bore_d = 12.7;            // thread core diameter
pitch = 1.75;             // thread pitch
thread_d = 1.05;          // thread depth

grip = [[15.2, 0], [14.604, 1.923], [13.223, 3.543], [11.91, 4.933], [11.224, 6.48], [10.983, 8.427], [10.499, 10.499], [9.247, 12.051], [7.3, 12.644], [5.182, 12.51], [3.323, 12.403], [1.703, 12.936], [0, 14], [-1.952, 14.824], [-3.923, 14.643], [-5.533, 13.359], [-6.7, 11.605], [-7.798, 10.163], [-9.299, 9.299], [-11.231, 8.618], [-13.024, 7.52], [-13.959, 5.782], [-13.823, 3.704], [-13.156, 1.732], [-12.8, 0], [-13.156, -1.732], [-13.823, -3.704], [-13.959, -5.782], [-13.024, -7.52], [-11.231, -8.618], [-9.299, -9.299], [-7.798, -10.163], [-6.7, -11.605], [-5.533, -13.359], [-3.923, -14.643], [-1.952, -14.824], [0, -14], [1.703, -12.936], [3.323, -12.403], [5.182, -12.51], [7.3, -12.644], [9.247, -12.051], [10.499, -10.499], [10.983, -8.427], [11.224, -6.48], [11.91, -4.933], [13.223, -3.543], [14.604, -1.923]];

difference() {
  union() {
    /* grip outline extruded straight up */
    linear_extrude(height = grip_h) polygon(grip);
    /* boss sunk half a millimetre into the grip */
    translate([0, 0, grip_h - 0.5]) cylinder(h = boss_h + 0.5, d = boss_d);
  }
  /* threaded bore through grip and boss */
  translate([0, 0, -2.5]) cylinder(h = grip_h + boss_h + 5, d = bore_d);
  translate([0, 0, 2.0]) rotate_extrude() polygon([[5.35, 0], [5.35, 14], [5.85, 14], [7.4, 13.125], [5.85, 12.25], [7.4, 11.375], [5.85, 10.5], [7.4, 9.625], [5.85, 8.75], [7.4, 7.875], [5.85, 7], [7.4, 6.125], [5.85, 5.25], [7.4, 4.375], [5.85, 3.5], [7.4, 2.625], [5.85, 0], [5.35, 0]]);
}
