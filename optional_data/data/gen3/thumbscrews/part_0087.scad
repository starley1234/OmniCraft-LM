$fn = 32;

// ----------------------------------------------------------------------
// Thumb nut: 6 lobe grip, 22 mm tall, M7.94 thread
// ----------------------------------------------------------------------

// --- parameters (mm) ---
base_r = 14;              // grip base radius
lobe_amp = 2.5;           // lobe height above the base radius
lobes = 6;                // number of grip lobes
grip_h = 16;              // grip height
boss_d = 15.94;           // threaded boss diameter
boss_h = 6;               // boss height
bore_d = 7.94;            // thread core diameter
pitch = 1.75;             // thread pitch
thread_d = 1.05;          // thread depth

grip = [[16.5, 0], [15.633, 2.058], [13.523, 3.623], [11.301, 4.681], [9.959, 5.75], [9.704, 7.447], [9.899, 9.899], [9.599, 12.509], [8.25, 14.289], [6.034, 14.568], [3.623, 13.523], [1.597, 12.128], [0, 11.5], [-1.597, 12.128], [-3.623, 13.523], [-6.034, 14.568], [-8.25, 14.289], [-9.599, 12.509], [-9.899, 9.899], [-9.704, 7.447], [-9.959, 5.75], [-11.301, 4.681], [-13.523, 3.623], [-15.633, 2.058], [-16.5, 0], [-15.633, -2.058], [-13.523, -3.623], [-11.301, -4.681], [-9.959, -5.75], [-9.704, -7.447], [-9.899, -9.899], [-9.599, -12.509], [-8.25, -14.289], [-6.034, -14.568], [-3.623, -13.523], [-1.597, -12.128], [0, -11.5], [1.597, -12.128], [3.623, -13.523], [6.034, -14.568], [8.25, -14.289], [9.599, -12.509], [9.899, -9.899], [9.704, -7.447], [9.959, -5.75], [11.301, -4.681], [13.523, -3.623], [15.633, -2.058]];

difference() {
  union() {
    /* grip outline extruded straight up */
    linear_extrude(height = grip_h) polygon(grip);
    /* boss sunk half a millimetre into the grip */
    translate([0, 0, grip_h - 0.5]) cylinder(h = boss_h + 0.5, d = boss_d);
  }
  /* threaded bore through grip and boss */
  translate([0, 0, -2.5]) cylinder(h = grip_h + boss_h + 5, d = bore_d);
  translate([0, 0, 2.0]) rotate_extrude() polygon([[2.969, 0], [2.969, 18], [3.469, 18], [5.019, 17.125], [3.469, 16.25], [5.019, 15.375], [3.469, 14.5], [5.019, 13.625], [3.469, 12.75], [5.019, 11.875], [3.469, 11], [5.019, 10.125], [3.469, 9.25], [5.019, 8.375], [3.469, 7.5], [5.019, 6.625], [3.469, 5.75], [5.019, 4.875], [3.469, 4], [5.019, 3.125], [3.469, 0], [2.969, 0]]);
