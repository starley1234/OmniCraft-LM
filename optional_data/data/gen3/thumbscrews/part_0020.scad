$fn = 32;

// ----------------------------------------------------------------------
// Thumb nut: 7 lobe grip, 20 mm tall, M7.94 thread
// ----------------------------------------------------------------------

// --- parameters (mm) ---
base_r = 22;              // grip base radius
lobe_amp = 2.5;           // lobe height above the base radius
lobes = 7;                // number of grip lobes
grip_h = 14;              // grip height
boss_d = 13.94;           // threaded boss diameter
boss_h = 6;               // boss height
bore_d = 7.94;            // thread core diameter
pitch = 1.75;             // thread pitch
thread_d = 1.05;          // thread depth

grip = [[24.5, 0], [23.321, 3.07], [20.625, 5.527], [18.191, 7.535], [17.178, 9.917], [17.195, 13.194], [16.806, 16.806], [14.902, 19.42], [11.625, 20.135], [8.053, 19.441], [5.069, 18.918], [2.613, 19.845], [0, 22], [-3.13, 23.778], [-6.319, 23.583], [-8.785, 21.209], [-10.375, 17.97], [-11.884, 15.487], [-14.306, 14.306], [-17.713, 13.591], [-20.928, 12.083], [-22.459, 9.303], [-21.875, 5.861], [-20.303, 2.673], [-19.5, 0], [-20.303, -2.673], [-21.875, -5.861], [-22.459, -9.303], [-20.928, -12.083], [-17.713, -13.591], [-14.306, -14.306], [-11.884, -15.487], [-10.375, -17.97], [-8.785, -21.209], [-6.319, -23.583], [-3.13, -23.778], [0, -22], [2.613, -19.845], [5.069, -18.918], [8.053, -19.441], [11.625, -20.135], [14.902, -19.42], [16.806, -16.806], [17.195, -13.194], [17.178, -9.917], [18.191, -7.535], [20.625, -5.527], [23.321, -3.07]];

difference() {
  union() {
    /* grip outline extruded straight up */
    linear_extrude(height = grip_h) polygon(grip);
    /* boss sunk half a millimetre into the grip */
    translate([0, 0, grip_h - 0.5]) cylinder(h = boss_h + 0.5, d = boss_d);
  }
  /* threaded bore through grip and boss */
  translate([0, 0, -2.5]) cylinder(h = grip_h + boss_h + 5, d = bore_d);
  translate([0, 0, 2.0]) rotate_extrude() polygon([[2.969, 0], [2.969, 16], [3.469, 16], [5.019, 15.125], [3.469, 14.25], [5.019, 13.375], [3.469, 12.5], [5.019, 11.625], [3.469, 10.75], [5.019, 9.875], [3.469, 9], [5.019, 8.125], [3.469, 7.25], [5.019, 6.375], [3.469, 5.5], [5.019, 4.625], [3.469, 3.75], [5.019, 2.875], [3.469, 0], [2.969, 0]]);
