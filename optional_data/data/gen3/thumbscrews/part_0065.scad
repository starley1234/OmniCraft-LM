$fn = 32;

// ----------------------------------------------------------------------
// Thumb nut: 8 lobe grip, 22 mm tall, M6.35 thread
// ----------------------------------------------------------------------

// --- parameters (mm) ---
base_r = 22;              // grip base radius
lobe_amp = 2;             // lobe height above the base radius
lobes = 8;                // number of grip lobes
grip_h = 16;              // grip height
boss_d = 16.35;           // threaded boss diameter
boss_h = 6;               // boss height
bore_d = 6.35;            // thread core diameter
pitch = 1.75;             // thread pitch
thread_d = 1.05;          // thread depth

grip = [[24, 0], [22.803, 3.002], [20.284, 5.435], [18.478, 7.654], [18.187, 10.5], [18.247, 14.002], [16.971, 16.971], [14.002, 18.247], [10.5, 18.187], [7.654, 18.478], [5.435, 20.284], [3.002, 22.803], [0, 24], [-3.002, 22.803], [-5.435, 20.284], [-7.654, 18.478], [-10.5, 18.187], [-14.002, 18.247], [-16.971, 16.971], [-18.247, 14.002], [-18.187, 10.5], [-18.478, 7.654], [-20.284, 5.435], [-22.803, 3.002], [-24, 0], [-22.803, -3.002], [-20.284, -5.435], [-18.478, -7.654], [-18.187, -10.5], [-18.247, -14.002], [-16.971, -16.971], [-14.002, -18.247], [-10.5, -18.187], [-7.654, -18.478], [-5.435, -20.284], [-3.002, -22.803], [0, -24], [3.002, -22.803], [5.435, -20.284], [7.654, -18.478], [10.5, -18.187], [14.002, -18.247], [16.971, -16.971], [18.247, -14.002], [18.187, -10.5], [18.478, -7.654], [20.284, -5.435], [22.803, -3.002]];

difference() {
  union() {
    /* grip outline extruded straight up */
    linear_extrude(height = grip_h) polygon(grip);
    /* boss sunk half a millimetre into the grip */
    translate([0, 0, grip_h - 0.5]) cylinder(h = boss_h + 0.5, d = boss_d);
  }
  /* threaded bore through grip and boss */
  translate([0, 0, -2.5]) cylinder(h = grip_h + boss_h + 5, d = bore_d);
  translate([0, 0, 2.0]) rotate_extrude() polygon([[2.175, 0], [2.175, 18], [2.675, 18], [4.225, 17.125], [2.675, 16.25], [4.225, 15.375], [2.675, 14.5], [4.225, 13.625], [2.675, 12.75], [4.225, 11.875], [2.675, 11], [4.225, 10.125], [2.675, 9.25], [4.225, 8.375], [2.675, 7.5], [4.225, 6.625], [2.675, 5.75], [4.225, 4.875], [2.675, 4], [4.225, 3.125], [2.675, 0], [2.175, 0]]);
}
