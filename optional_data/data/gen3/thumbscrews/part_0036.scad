$fn = 32;

// ----------------------------------------------------------------------
// Thumb nut: 4 lobe grip, 20 mm tall, M12.7 thread
// ----------------------------------------------------------------------

// --- parameters (mm) ---
base_r = 22;              // grip base radius
lobe_amp = 2.5;           // lobe height above the base radius
lobes = 4;                // number of grip lobes
grip_h = 12;              // grip height
boss_d = 22.7;            // threaded boss diameter
boss_h = 8;               // boss height
bore_d = 12.7;            // thread core diameter
pitch = 1.75;             // thread pitch
thread_d = 1.05;          // thread depth

grip = [[24.5, 0], [23.958, 3.154], [22.458, 6.018], [20.325, 8.419], [17.97, 10.375], [15.736, 12.075], [13.789, 13.789], [12.075, 15.736], [10.375, 17.97], [8.419, 20.325], [6.018, 22.458], [3.154, 23.958], [0, 24.5], [-3.154, 23.958], [-6.018, 22.458], [-8.419, 20.325], [-10.375, 17.97], [-12.075, 15.736], [-13.789, 13.789], [-15.736, 12.075], [-17.97, 10.375], [-20.325, 8.419], [-22.458, 6.018], [-23.958, 3.154], [-24.5, 0], [-23.958, -3.154], [-22.458, -6.018], [-20.325, -8.419], [-17.97, -10.375], [-15.736, -12.075], [-13.789, -13.789], [-12.075, -15.736], [-10.375, -17.97], [-8.419, -20.325], [-6.018, -22.458], [-3.154, -23.958], [0, -24.5], [3.154, -23.958], [6.018, -22.458], [8.419, -20.325], [10.375, -17.97], [12.075, -15.736], [13.789, -13.789], [15.736, -12.075], [17.97, -10.375], [20.325, -8.419], [22.458, -6.018], [23.958, -3.154]];

difference() {
  union() {
    /* grip outline extruded straight up */
    linear_extrude(height = grip_h) polygon(grip);
    /* boss sunk half a millimetre into the grip */
    translate([0, 0, grip_h - 0.5]) cylinder(h = boss_h + 0.5, d = boss_d);
  }
  /* threaded bore through grip and boss */
  translate([0, 0, -2.5]) cylinder(h = grip_h + boss_h + 5, d = bore_d);
  translate([0, 0, 2.0]) rotate_extrude() polygon([[5.35, 0], [5.35, 16], [5.85, 16], [7.4, 15.125], [5.85, 14.25], [7.4, 13.375], [5.85, 12.5], [7.4, 11.625], [5.85, 10.75], [7.4, 9.875], [5.85, 9], [7.4, 8.125], [5.85, 7.25], [7.4, 6.375], [5.85, 5.5], [7.4, 4.625], [5.85, 3.75], [7.4, 2.875], [5.85, 0], [5.35, 0]]);
}
