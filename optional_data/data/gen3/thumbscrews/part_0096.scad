$fn = 32;

// ----------------------------------------------------------------------
// Thumb nut: 6 lobe grip, 18 mm tall, M12.7 thread
// ----------------------------------------------------------------------

// --- parameters (mm) ---
base_r = 18;              // grip base radius
lobe_amp = 1.2;           // lobe height above the base radius
lobes = 6;                // number of grip lobes
grip_h = 10;              // grip height
boss_d = 18.7;            // threaded boss diameter
boss_h = 8;               // boss height
bore_d = 12.7;            // thread core diameter
pitch = 1.75;             // thread pitch
thread_d = 1.05;          // thread depth

grip = [[19.2, 0], [18.687, 2.46], [17.387, 4.659], [15.846, 6.564], [14.549, 8.4], [13.607, 10.441], [12.728, 12.728], [11.474, 14.954], [9.6, 16.628], [7.213, 17.414], [4.659, 17.387], [2.239, 17.005], [0, 16.8], [-2.239, 17.005], [-4.659, 17.387], [-7.213, 17.414], [-9.6, 16.628], [-11.474, 14.954], [-12.728, 12.728], [-13.607, 10.441], [-14.549, 8.4], [-15.846, 6.564], [-17.387, 4.659], [-18.687, 2.46], [-19.2, 0], [-18.687, -2.46], [-17.387, -4.659], [-15.846, -6.564], [-14.549, -8.4], [-13.607, -10.441], [-12.728, -12.728], [-11.474, -14.954], [-9.6, -16.628], [-7.213, -17.414], [-4.659, -17.387], [-2.239, -17.005], [0, -16.8], [2.239, -17.005], [4.659, -17.387], [7.213, -17.414], [9.6, -16.628], [11.474, -14.954], [12.728, -12.728], [13.607, -10.441], [14.549, -8.4], [15.846, -6.564], [17.387, -4.659], [18.687, -2.46]];

difference() {
  union() {
    /* grip outline extruded straight up */
    linear_extrude(height = grip_h) polygon(grip);
    /* boss sunk half a millimetre into the grip */
    translate([0, 0, grip_h - 0.5]) cylinder(h = boss_h + 0.5, d = boss_d);
  }
  /* threaded bore through grip and boss */
  translate([0, 0, -2.5]) cylinder(h = grip_h + boss_h + 5, d = bore_d);
  translate([0, 0, 2.0]) rotate_extrude() polygon([[5.35, 0], [5.35, 14], [5.85, 14], [7.4, 13.125], [5.85, 12.25], [7.4, 11.375], [5.85, 10.5], [7.4, 9.625], [5.85, 8.75], [7.4, 7.875], [5.85, 7], [7.4, 6.125], [5.85, 5.25], [7.4, 4.375], [5.85, 3.5], [7.4, 2.625], [5.85, 0], [5.35, 0]]);
}
