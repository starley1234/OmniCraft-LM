$fn = 32;

// ----------------------------------------------------------------------
// Thumb nut: 8 lobe grip, 20 mm tall, M9.53 thread
// ----------------------------------------------------------------------

// --- parameters (mm) ---
base_r = 16;              // grip base radius
lobe_amp = 1.6;           // lobe height above the base radius
lobes = 8;                // number of grip lobes
grip_h = 16;              // grip height
boss_d = 15.53;           // threaded boss diameter
boss_h = 4;               // boss height
bore_d = 9.53;            // thread core diameter
pitch = 1.75;             // thread pitch
thread_d = 1.05;          // thread depth

grip = [[17.6, 0], [16.656, 2.193], [14.682, 3.934], [13.304, 5.511], [13.164, 7.6], [13.328, 10.227], [12.445, 12.445], [10.227, 13.328], [7.6, 13.164], [5.511, 13.304], [3.934, 14.682], [2.193, 16.656], [0, 17.6], [-2.193, 16.656], [-3.934, 14.682], [-5.511, 13.304], [-7.6, 13.164], [-10.227, 13.328], [-12.445, 12.445], [-13.328, 10.227], [-13.164, 7.6], [-13.304, 5.511], [-14.682, 3.934], [-16.656, 2.193], [-17.6, 0], [-16.656, -2.193], [-14.682, -3.934], [-13.304, -5.511], [-13.164, -7.6], [-13.328, -10.227], [-12.445, -12.445], [-10.227, -13.328], [-7.6, -13.164], [-5.511, -13.304], [-3.934, -14.682], [-2.193, -16.656], [0, -17.6], [2.193, -16.656], [3.934, -14.682], [5.511, -13.304], [7.6, -13.164], [10.227, -13.328], [12.445, -12.445], [13.328, -10.227], [13.164, -7.6], [13.304, -5.511], [14.682, -3.934], [16.656, -2.193]];

difference() {
  union() {
    /* grip outline extruded straight up */
    linear_extrude(height = grip_h) polygon(grip);
    /* boss sunk half a millimetre into the grip */
    translate([0, 0, grip_h - 0.5]) cylinder(h = boss_h + 0.5, d = boss_d);
  }
  /* threaded bore through grip and boss */
  translate([0, 0, -2.5]) cylinder(h = grip_h + boss_h + 5, d = bore_d);
  translate([0, 0, 2.0]) rotate_extrude() polygon([[3.763, 0], [3.763, 16], [4.263, 16], [5.812, 15.125], [4.263, 14.25], [5.812, 13.375], [4.263, 12.5], [5.812, 11.625], [4.263, 10.75], [5.812, 9.875], [4.263, 9], [5.812, 8.125], [4.263, 7.25], [5.812, 6.375], [4.263, 5.5], [5.812, 4.625], [4.263, 3.75], [5.812, 2.875], [4.263, 0], [3.763, 0]]);
}
