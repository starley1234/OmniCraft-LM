$fn = 32;

// ----------------------------------------------------------------------
// Thumb nut: 4 lobe grip, 18 mm tall, M12.7 thread
// ----------------------------------------------------------------------

// --- parameters (mm) ---
base_r = 22;              // grip base radius
lobe_amp = 1.2;           // lobe height above the base radius
lobes = 4;                // number of grip lobes
grip_h = 10;              // grip height
boss_d = 18.7;            // threaded boss diameter
boss_h = 8;               // boss height
bore_d = 12.7;            // thread core diameter
pitch = 1.75;             // thread pitch
thread_d = 1.05;          // thread depth

grip = [[23.2, 0], [22.842, 3.007], [21.83, 5.849], [20.325, 8.419], [18.533, 10.7], [16.629, 12.76], [14.708, 14.708], [12.76, 16.629], [10.7, 18.533], [8.419, 20.325], [5.849, 21.83], [3.007, 22.842], [0, 23.2], [-3.007, 22.842], [-5.849, 21.83], [-8.419, 20.325], [-10.7, 18.533], [-12.76, 16.629], [-14.708, 14.708], [-16.629, 12.76], [-18.533, 10.7], [-20.325, 8.419], [-21.83, 5.849], [-22.842, 3.007], [-23.2, 0], [-22.842, -3.007], [-21.83, -5.849], [-20.325, -8.419], [-18.533, -10.7], [-16.629, -12.76], [-14.708, -14.708], [-12.76, -16.629], [-10.7, -18.533], [-8.419, -20.325], [-5.849, -21.83], [-3.007, -22.842], [0, -23.2], [3.007, -22.842], [5.849, -21.83], [8.419, -20.325], [10.7, -18.533], [12.76, -16.629], [14.708, -14.708], [16.629, -12.76], [18.533, -10.7], [20.325, -8.419], [21.83, -5.849], [22.842, -3.007]];

difference() {
  union() {
    /* grip outline extruded straight up */
    linear_extrude(height = grip_h) polygon(grip);
    /* boss sunk half a millimetre into the grip */
    translate([0, 0, grip_h - 0.5]) cylinder(h = boss_h + 0.5, d = boss_d);
  }
  /* threaded bore through grip and boss */
  translate([0, 0, -2.5]) cylinder(h = grip_h + boss_h + 5, d = bore_d);
  translate([0, 0, 2.0]) rotate_extrude() polygon([[5.35, 0], [5.35, 14], [5.85, 14], [7.4, 13.125], [5.85, 12.25], [7.4, 11.375], [5.85, 10.5], [7.4, 9.625], [5.85, 8.75], [7.4, 7.875], [5.85, 7], [7.4, 6.125], [5.85, 5.25], [7.4, 4.375], [5.85, 3.5], [7.4, 2.625], [5.85, 0], [5.35, 0]]);
}
