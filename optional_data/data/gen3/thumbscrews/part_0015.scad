$fn = 32;

// ----------------------------------------------------------------------
// Thumb nut: 8 lobe grip, 14 mm tall, M9.53 thread
// ----------------------------------------------------------------------

// --- parameters (mm) ---
base_r = 16;              // grip base radius
lobe_amp = 2;             // lobe height above the base radius
lobes = 8;                // number of grip lobes
grip_h = 10;              // grip height
boss_d = 15.53;           // threaded boss diameter
boss_h = 4;               // boss height
bore_d = 9.53;            // thread core diameter
pitch = 1.75;             // thread pitch
thread_d = 1.05;          // thread depth

grip = [[18, 0], [16.855, 2.219], [14.489, 3.882], [12.934, 5.358], [12.99, 7.5], [13.487, 10.349], [12.728, 12.728], [10.349, 13.487], [7.5, 12.99], [5.358, 12.934], [3.882, 14.489], [2.219, 16.855], [0, 18], [-2.219, 16.855], [-3.882, 14.489], [-5.358, 12.934], [-7.5, 12.99], [-10.349, 13.487], [-12.728, 12.728], [-13.487, 10.349], [-12.99, 7.5], [-12.934, 5.358], [-14.489, 3.882], [-16.855, 2.219], [-18, 0], [-16.855, -2.219], [-14.489, -3.882], [-12.934, -5.358], [-12.99, -7.5], [-13.487, -10.349], [-12.728, -12.728], [-10.349, -13.487], [-7.5, -12.99], [-5.358, -12.934], [-3.882, -14.489], [-2.219, -16.855], [0, -18], [2.219, -16.855], [3.882, -14.489], [5.358, -12.934], [7.5, -12.99], [10.349, -13.487], [12.728, -12.728], [13.487, -10.349], [12.99, -7.5], [12.934, -5.358], [14.489, -3.882], [16.855, -2.219]];

difference() {
  union() {
    /* grip outline extruded straight up */
    linear_extrude(height = grip_h) polygon(grip);
    /* boss sunk half a millimetre into the grip */
    translate([0, 0, grip_h - 0.5]) cylinder(h = boss_h + 0.5, d = boss_d);
  }
  /* threaded bore through grip and boss */
  translate([0, 0, -2.5]) cylinder(h = grip_h + boss_h + 5, d = bore_d);
  translate([0, 0, 2.0]) rotate_extrude() polygon([[3.763, 0], [3.763, 10], [4.263, 10], [5.812, 9.125], [4.263, 8.25], [5.812, 7.375], [4.263, 6.5], [5.812, 5.625], [4.263, 4.75], [5.812, 3.875], [4.263, 3], [5.812, 2.125], [4.263, 0], [3.763, 0]]);
}
