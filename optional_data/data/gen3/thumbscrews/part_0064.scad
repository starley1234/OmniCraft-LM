$fn = 32;

// ----------------------------------------------------------------------
// Thumb nut: 4 lobe grip, 16 mm tall, M6.35 thread
// ----------------------------------------------------------------------

// --- parameters (mm) ---
base_r = 16;              // grip base radius
lobe_amp = 2;             // lobe height above the base radius
lobes = 4;                // number of grip lobes
grip_h = 12;              // grip height
boss_d = 16.35;           // threaded boss diameter
boss_h = 4;               // boss height
bore_d = 6.35;            // thread core diameter
pitch = 1.75;             // thread pitch
thread_d = 1.05;          // thread depth

grip = [[18, 0], [17.58, 2.314], [16.421, 4.4], [14.782, 6.123], [12.99, 7.5], [11.32, 8.686], [9.899, 9.899], [8.686, 11.32], [7.5, 12.99], [6.123, 14.782], [4.4, 16.421], [2.314, 17.58], [0, 18], [-2.314, 17.58], [-4.4, 16.421], [-6.123, 14.782], [-7.5, 12.99], [-8.686, 11.32], [-9.899, 9.899], [-11.32, 8.686], [-12.99, 7.5], [-14.782, 6.123], [-16.421, 4.4], [-17.58, 2.314], [-18, 0], [-17.58, -2.314], [-16.421, -4.4], [-14.782, -6.123], [-12.99, -7.5], [-11.32, -8.686], [-9.899, -9.899], [-8.686, -11.32], [-7.5, -12.99], [-6.123, -14.782], [-4.4, -16.421], [-2.314, -17.58], [0, -18], [2.314, -17.58], [4.4, -16.421], [6.123, -14.782], [7.5, -12.99], [8.686, -11.32], [9.899, -9.899], [11.32, -8.686], [12.99, -7.5], [14.782, -6.123], [16.421, -4.4], [17.58, -2.314]];

difference() {
  union() {
    /* grip outline extruded straight up */
    linear_extrude(height = grip_h) polygon(grip);
    /* boss sunk half a millimetre into the grip */
    translate([0, 0, grip_h - 0.5]) cylinder(h = boss_h + 0.5, d = boss_d);
  }
  /* threaded bore through grip and boss */
  translate([0, 0, -2.5]) cylinder(h = grip_h + boss_h + 5, d = bore_d);
  translate([0, 0, 2.0]) rotate_extrude() polygon([[2.175, 0], [2.175, 12], [2.675, 12], [4.225, 11.125], [2.675, 10.25], [4.225, 9.375], [2.675, 8.5], [4.225, 7.625], [2.675, 6.75], [4.225, 5.875], [2.675, 5], [4.225, 4.125], [2.675, 3.25], [4.225, 2.375], [2.675, 0], [2.175, 0]]);
}
