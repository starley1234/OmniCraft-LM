$fn = 32;

// ----------------------------------------------------------------------
// Thumb nut: 7 lobe grip, 14 mm tall, M6.35 thread
// ----------------------------------------------------------------------

// --- parameters (mm) ---
base_r = 20;              // grip base radius
lobe_amp = 2.5;           // lobe height above the base radius
lobes = 7;                // number of grip lobes
grip_h = 10;              // grip height
boss_d = 16.35;           // threaded boss diameter
boss_h = 4;               // boss height
bore_d = 6.35;            // thread core diameter
pitch = 1.75;             // thread pitch
thread_d = 1.05;          // thread depth

grip = [[22.5, 0], [21.338, 2.809], [18.694, 5.009], [16.344, 6.77], [15.446, 8.917], [15.608, 11.977], [15.392, 15.392], [13.684, 17.833], [10.625, 18.403], [7.288, 17.594], [4.551, 16.986], [2.352, 17.862], [0, 20], [-2.869, 21.795], [-5.801, 21.651], [-8.02, 19.361], [-9.375, 16.238], [-10.666, 13.901], [-12.892, 12.892], [-16.126, 12.374], [-19.196, 11.083], [-20.611, 8.538], [-19.944, 5.344], [-18.32, 2.412], [-17.5, 0], [-18.32, -2.412], [-19.944, -5.344], [-20.611, -8.538], [-19.196, -11.083], [-16.126, -12.374], [-12.892, -12.892], [-10.666, -13.901], [-9.375, -16.238], [-8.02, -19.361], [-5.801, -21.651], [-2.869, -21.795], [0, -20], [2.352, -17.862], [4.551, -16.986], [7.288, -17.594], [10.625, -18.403], [13.684, -17.833], [15.392, -15.392], [15.608, -11.977], [15.446, -8.917], [16.344, -6.77], [18.694, -5.009], [21.338, -2.809]];

difference() {
  union() {
    /* grip outline extruded straight up */
    linear_extrude(height = grip_h) polygon(grip);
    /* boss sunk half a millimetre into the grip */
    translate([0, 0, grip_h - 0.5]) cylinder(h = boss_h + 0.5, d = boss_d);
  }
  /* threaded bore through grip and boss */
  translate([0, 0, -2.5]) cylinder(h = grip_h + boss_h + 5, d = bore_d);
  translate([0, 0, 2.0]) rotate_extrude() polygon([[2.175, 0], [2.175, 10], [2.675, 10], [4.225, 9.125], [2.675, 8.25], [4.225, 7.375], [2.675, 6.5], [4.225, 5.625], [2.675, 4.75], [4.225, 3.875], [2.675, 3], [4.225, 2.125], [2.675, 0], [2.175, 0]]);
}
