$fn = 32;

// ----------------------------------------------------------------------
// Thumb nut: 6 lobe grip, 20 mm tall, M9.53 thread
// ----------------------------------------------------------------------

// --- parameters (mm) ---
base_r = 14;              // grip base radius
lobe_amp = 1.6;           // lobe height above the base radius
lobes = 6;                // number of grip lobes
grip_h = 14;              // grip height
boss_d = 19.52;           // threaded boss diameter
boss_h = 6;               // boss height
bore_d = 9.53;            // thread core diameter
pitch = 1.75;             // thread pitch
thread_d = 1.05;          // thread depth

grip = [[15.6, 0], [15.002, 1.975], [13.523, 3.623], [11.889, 4.925], [10.739, 6.2], [10.209, 7.834], [9.899, 9.899], [9.211, 12.005], [7.8, 13.51], [5.791, 13.98], [3.623, 13.523], [1.68, 12.759], [0, 12.4], [-1.68, 12.759], [-3.623, 13.523], [-5.791, 13.98], [-7.8, 13.51], [-9.211, 12.005], [-9.899, 9.899], [-10.209, 7.834], [-10.739, 6.2], [-11.889, 4.925], [-13.523, 3.623], [-15.002, 1.975], [-15.6, 0], [-15.002, -1.975], [-13.523, -3.623], [-11.889, -4.925], [-10.739, -6.2], [-10.209, -7.834], [-9.899, -9.899], [-9.211, -12.005], [-7.8, -13.51], [-5.791, -13.98], [-3.623, -13.523], [-1.68, -12.759], [0, -12.4], [1.68, -12.759], [3.623, -13.523], [5.791, -13.98], [7.8, -13.51], [9.211, -12.005], [9.899, -9.899], [10.209, -7.834], [10.739, -6.2], [11.889, -4.925], [13.523, -3.623], [15.002, -1.975]];

difference() {
  union() {
    /* grip outline extruded straight up */
    linear_extrude(height = grip_h) polygon(grip);
    /* boss sunk half a millimetre into the grip */
    translate([0, 0, grip_h - 0.5]) cylinder(h = boss_h + 0.5, d = boss_d);
  }
  /* threaded bore through grip and boss */
  translate([0, 0, -2.5]) cylinder(h = grip_h + boss_h + 5, d = bore_d);
  translate([0, 0, 2.0]) rotate_extrude() polygon([[3.763, 0], [3.763, 16], [4.263, 16], [5.812, 15.125], [4.263, 14.25], [5.812, 13.375], [4.263, 12.5], [5.812, 11.625], [4.263, 10.75], [5.812, 9.875], [4.263, 9], [5.812, 8.125], [4.263, 7.25], [5.812, 6.375], [4.263, 5.5], [5.812, 4.625], [4.263, 3.75], [5.812, 2.875], [4.263, 0], [3.763, 0]]);
}
