$fn = 32;

// ----------------------------------------------------------------------
// Thumb nut: 8 lobe grip, 16 mm tall, M7.94 thread
// ----------------------------------------------------------------------

// --- parameters (mm) ---
base_r = 16;              // grip base radius
lobe_amp = 1.2;           // lobe height above the base radius
lobes = 8;                // number of grip lobes
grip_h = 10;              // grip height
boss_d = 13.94;           // threaded boss diameter
boss_h = 6;               // boss height
bore_d = 7.94;            // thread core diameter
pitch = 1.75;             // thread pitch
thread_d = 1.05;          // thread depth

grip = [[17.2, 0], [16.458, 2.167], [14.875, 3.986], [13.673, 5.664], [13.337, 7.7], [13.17, 10.105], [12.162, 12.162], [10.105, 13.17], [7.7, 13.337], [5.664, 13.673], [3.986, 14.875], [2.167, 16.458], [0, 17.2], [-2.167, 16.458], [-3.986, 14.875], [-5.664, 13.673], [-7.7, 13.337], [-10.105, 13.17], [-12.162, 12.162], [-13.17, 10.105], [-13.337, 7.7], [-13.673, 5.664], [-14.875, 3.986], [-16.458, 2.167], [-17.2, 0], [-16.458, -2.167], [-14.875, -3.986], [-13.673, -5.664], [-13.337, -7.7], [-13.17, -10.105], [-12.162, -12.162], [-10.105, -13.17], [-7.7, -13.337], [-5.664, -13.673], [-3.986, -14.875], [-2.167, -16.458], [0, -17.2], [2.167, -16.458], [3.986, -14.875], [5.664, -13.673], [7.7, -13.337], [10.105, -13.17], [12.162, -12.162], [13.17, -10.105], [13.337, -7.7], [13.673, -5.664], [14.875, -3.986], [16.458, -2.167]];

difference() {
  union() {
    /* grip outline extruded straight up */
    linear_extrude(height = grip_h) polygon(grip);
    /* boss sunk half a millimetre into the grip */
    translate([0, 0, grip_h - 0.5]) cylinder(h = boss_h + 0.5, d = boss_d);
  }
  /* threaded bore through grip and boss */
  translate([0, 0, -2.5]) cylinder(h = grip_h + boss_h + 5, d = bore_d);
  translate([0, 0, 2.0]) rotate_extrude() polygon([[2.969, 0], [2.969, 12], [3.469, 12], [5.019, 11.125], [3.469, 10.25], [5.019, 9.375], [3.469, 8.5], [5.019, 7.625], [3.469, 6.75], [5.019, 5.875], [3.469, 5], [5.019, 4.125], [3.469, 3.25], [5.019, 2.375], [3.469, 0], [2.969, 0]]);
}
