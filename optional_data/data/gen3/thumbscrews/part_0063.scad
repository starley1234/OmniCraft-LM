$fn = 32;

// ----------------------------------------------------------------------
// Thumb nut: 5 lobe grip, 22 mm tall, M6.35 thread
// ----------------------------------------------------------------------

// --- parameters (mm) ---
base_r = 22;              // grip base radius
lobe_amp = 1.6;           // lobe height above the base radius
lobes = 5;                // number of grip lobes
grip_h = 16;              // grip height
boss_d = 16.35;           // threaded boss diameter
boss_h = 6;               // boss height
bore_d = 6.35;            // thread core diameter
pitch = 1.75;             // thread pitch
thread_d = 1.05;          // thread depth

grip = [[23.6, 0], [23.07, 3.037], [21.65, 5.801], [19.76, 8.185], [17.853, 10.307], [16.195, 12.427], [14.756, 14.756], [13.266, 17.288], [11.4, 19.745], [8.985, 21.691], [6.094, 22.743], [2.999, 22.777], [0, 22], [-2.744, 20.846], [-5.294, 19.758], [-7.853, 18.96], [-10.6, 18.36], [-13.52, 17.619], [-16.356, 16.356], [-18.712, 14.358], [-20.253, 11.693], [-20.891, 8.653], [-20.85, 5.587], [-20.553, 2.706], [-20.4, 0], [-20.553, -2.706], [-20.85, -5.587], [-20.891, -8.653], [-20.253, -11.693], [-18.712, -14.358], [-16.356, -16.356], [-13.52, -17.619], [-10.6, -18.36], [-7.853, -18.96], [-5.294, -19.758], [-2.744, -20.846], [0, -22], [2.999, -22.777], [6.094, -22.743], [8.985, -21.691], [11.4, -19.745], [13.266, -17.288], [14.756, -14.756], [16.195, -12.427], [17.853, -10.307], [19.76, -8.185], [21.65, -5.801], [23.07, -3.037]];

difference() {
  union() {
    /* grip outline extruded straight up */
    linear_extrude(height = grip_h) polygon(grip);
    /* boss sunk half a millimetre into the grip */
    translate([0, 0, grip_h - 0.5]) cylinder(h = boss_h + 0.5, d = boss_d);
  }
  /* threaded bore through grip and boss */
  translate([0, 0, -2.5]) cylinder(h = grip_h + boss_h + 5, d = bore_d);
  translate([0, 0, 2.0]) rotate_extrude() polygon([[2.175, 0], [2.175, 18], [2.675, 18], [4.225, 17.125], [2.675, 16.25], [4.225, 15.375], [2.675, 14.5], [4.225, 13.625], [2.675, 12.75], [4.225, 11.875], [2.675, 11], [4.225, 10.125], [2.675, 9.25], [4.225, 8.375], [2.675, 7.5], [4.225, 6.625], [2.675, 5.75], [4.225, 4.875], [2.675, 4], [4.225, 3.125], [2.675, 0], [2.175, 0]]);
