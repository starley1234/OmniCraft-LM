$fn = 32;

// ----------------------------------------------------------------------
// Thumb nut: 4 lobe grip, 20 mm tall, M7.94 thread
// ----------------------------------------------------------------------

// --- parameters (mm) ---
base_r = 14;              // grip base radius
lobe_amp = 2.5;           // lobe height above the base radius
lobes = 4;                // number of grip lobes
grip_h = 16;              // grip height
boss_d = 15.94;           // threaded boss diameter
boss_h = 4;               // boss height
bore_d = 7.94;            // thread core diameter
pitch = 1.75;             // thread pitch
thread_d = 1.05;          // thread depth

grip = [[16.5, 0], [16.027, 2.11], [14.73, 3.947], [12.934, 5.358], [11.042, 6.375], [9.389, 7.205], [8.132, 8.132], [7.205, 9.389], [6.375, 11.042], [5.358, 12.934], [3.947, 14.73], [2.11, 16.027], [0, 16.5], [-2.11, 16.027], [-3.947, 14.73], [-5.358, 12.934], [-6.375, 11.042], [-7.205, 9.389], [-8.132, 8.132], [-9.389, 7.205], [-11.042, 6.375], [-12.934, 5.358], [-14.73, 3.947], [-16.027, 2.11], [-16.5, 0], [-16.027, -2.11], [-14.73, -3.947], [-12.934, -5.358], [-11.042, -6.375], [-9.389, -7.205], [-8.132, -8.132], [-7.205, -9.389], [-6.375, -11.042], [-5.358, -12.934], [-3.947, -14.73], [-2.11, -16.027], [0, -16.5], [2.11, -16.027], [3.947, -14.73], [5.358, -12.934], [6.375, -11.042], [7.205, -9.389], [8.132, -8.132], [9.389, -7.205], [11.042, -6.375], [12.934, -5.358], [14.73, -3.947], [16.027, -2.11]];

difference() {
  union() {
    /* grip outline extruded straight up */
    linear_extrude(height = grip_h) polygon(grip);
    /* boss sunk half a millimetre into the grip */
    translate([0, 0, grip_h - 0.5]) cylinder(h = boss_h + 0.5, d = boss_d);
  }
  /* threaded bore through grip and boss */
  translate([0, 0, -2.5]) cylinder(h = grip_h + boss_h + 5, d = bore_d);
  translate([0, 0, 2.0]) rotate_extrude() polygon([[2.969, 0], [2.969, 16], [3.469, 16], [5.019, 15.125], [3.469, 14.25], [5.019, 13.375], [3.469, 12.5], [5.019, 11.625], [3.469, 10.75], [5.019, 9.875], [3.469, 9], [5.019, 8.125], [3.469, 7.25], [5.019, 6.375], [3.469, 5.5], [5.019, 4.625], [3.469, 3.75], [5.019, 2.875], [3.469, 0], [2.969, 0]]);
}
