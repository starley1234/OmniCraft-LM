$fn = 32;

// ----------------------------------------------------------------------
// Thumb nut: 7 lobe grip, 20 mm tall, M7.94 thread
// ----------------------------------------------------------------------

// --- parameters (mm) ---
base_r = 16;              // grip base radius
lobe_amp = 2;             // lobe height above the base radius
lobes = 7;                // number of grip lobes
grip_h = 12;              // grip height
boss_d = 13.94;           // threaded boss diameter
boss_h = 8;               // boss height
bore_d = 7.94;            // thread core diameter
pitch = 1.75;             // thread pitch
thread_d = 1.05;          // thread depth

grip = [[18, 0], [17.07, 2.247], [14.955, 4.007], [13.075, 5.416], [12.356, 7.134], [12.487, 9.581], [12.314, 12.314], [10.947, 14.267], [8.5, 14.722], [5.83, 14.075], [3.641, 13.589], [1.881, 14.29], [0, 16], [-2.296, 17.436], [-4.641, 17.321], [-6.416, 15.489], [-7.5, 12.99], [-8.533, 11.121], [-10.314, 10.314], [-12.901, 9.899], [-15.356, 8.866], [-16.489, 6.83], [-15.955, 4.275], [-14.656, 1.93], [-14, 0], [-14.656, -1.93], [-15.955, -4.275], [-16.489, -6.83], [-15.356, -8.866], [-12.901, -9.899], [-10.314, -10.314], [-8.533, -11.121], [-7.5, -12.99], [-6.416, -15.489], [-4.641, -17.321], [-2.296, -17.436], [0, -16], [1.881, -14.29], [3.641, -13.589], [5.83, -14.075], [8.5, -14.722], [10.947, -14.267], [12.314, -12.314], [12.487, -9.581], [12.356, -7.134], [13.075, -5.416], [14.955, -4.007], [17.07, -2.247]];

difference() {
  union() {
    /* grip outline extruded straight up */
    linear_extrude(height = grip_h) polygon(grip);
    /* boss sunk half a millimetre into the grip */
    translate([0, 0, grip_h - 0.5]) cylinder(h = boss_h + 0.5, d = boss_d);
  }
  /* threaded bore through grip and boss */
  translate([0, 0, -2.5]) cylinder(h = grip_h + boss_h + 5, d = bore_d);
  translate([0, 0, 2.0]) rotate_extrude() polygon([[2.969, 0], [2.969, 16], [3.469, 16], [5.019, 15.125], [3.469, 14.25], [5.019, 13.375], [3.469, 12.5], [5.019, 11.625], [3.469, 10.75], [5.019, 9.875], [3.469, 9], [5.019, 8.125], [3.469, 7.25], [5.019, 6.375], [3.469, 5.5], [5.019, 4.625], [3.469, 3.75], [5.019, 2.875], [3.469, 0], [2.969, 0]]);
}
