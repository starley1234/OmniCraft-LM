$fn = 32;

// ----------------------------------------------------------------------
// Thumb nut: 6 lobe grip, 20 mm tall, M6.35 thread
// ----------------------------------------------------------------------

// --- parameters (mm) ---
base_r = 16;              // grip base radius
lobe_amp = 2;             // lobe height above the base radius
lobes = 6;                // number of grip lobes
grip_h = 14;              // grip height
boss_d = 14.35;           // threaded boss diameter
boss_h = 6;               // boss height
bore_d = 6.35;            // thread core diameter
pitch = 1.75;             // thread pitch
thread_d = 1.05;          // thread depth

grip = [[18, 0], [17.265, 2.273], [15.455, 4.141], [13.476, 5.582], [12.124, 7], [11.572, 8.879], [11.314, 11.314], [10.601, 13.816], [9, 15.588], [6.664, 16.089], [4.141, 15.455], [1.904, 14.461], [0, 14], [-1.904, 14.461], [-4.141, 15.455], [-6.664, 16.089], [-9, 15.588], [-10.601, 13.816], [-11.314, 11.314], [-11.572, 8.879], [-12.124, 7], [-13.476, 5.582], [-15.455, 4.141], [-17.265, 2.273], [-18, 0], [-17.265, -2.273], [-15.455, -4.141], [-13.476, -5.582], [-12.124, -7], [-11.572, -8.879], [-11.314, -11.314], [-10.601, -13.816], [-9, -15.588], [-6.664, -16.089], [-4.141, -15.455], [-1.904, -14.461], [0, -14], [1.904, -14.461], [4.141, -15.455], [6.664, -16.089], [9, -15.588], [10.601, -13.816], [11.314, -11.314], [11.572, -8.879], [12.124, -7], [13.476, -5.582], [15.455, -4.141], [17.265, -2.273]];

difference() {
  union() {
    /* grip outline extruded straight up */
    linear_extrude(height = grip_h) polygon(grip);
    /* boss sunk half a millimetre into the grip */
    translate([0, 0, grip_h - 0.5]) cylinder(h = boss_h + 0.5, d = boss_d);
  }
  /* threaded bore through grip and boss */
  translate([0, 0, -2.5]) cylinder(h = grip_h + boss_h + 5, d = bore_d);
  translate([0, 0, 2.0]) rotate_extrude() polygon([[2.175, 0], [2.175, 16], [2.675, 16], [4.225, 15.125], [2.675, 14.25], [4.225, 13.375], [2.675, 12.5], [4.225, 11.625], [2.675, 10.75], [4.225, 9.875], [2.675, 9], [4.225, 8.125], [2.675, 7.25], [4.225, 6.375], [2.675, 5.5], [4.225, 4.625], [2.675, 3.75], [4.225, 2.875], [2.675, 0], [2.175, 0]]);
}
