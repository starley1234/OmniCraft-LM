$fn = 32;

// ----------------------------------------------------------------------
// Thumb nut: 5 lobe grip, 16 mm tall, M12.7 thread
// ----------------------------------------------------------------------

// --- parameters (mm) ---
base_r = 20;              // grip base radius
lobe_amp = 1.6;           // lobe height above the base radius
lobes = 5;                // number of grip lobes
grip_h = 10;              // grip height
boss_d = 20.7;            // threaded boss diameter
boss_h = 6;               // boss height
bore_d = 12.7;            // thread core diameter
pitch = 1.75;             // thread pitch
thread_d = 1.05;          // thread depth

grip = [[21.6, 0], [21.087, 2.776], [19.719, 5.284], [17.912, 7.419], [16.121, 9.307], [14.609, 11.21], [13.342, 13.342], [12.048, 15.701], [10.4, 18.013], [8.219, 19.843], [5.576, 20.811], [2.738, 20.795], [0, 20], [-2.483, 18.863], [-4.776, 17.826], [-7.088, 17.112], [-9.6, 16.628], [-12.302, 16.033], [-14.942, 14.942], [-17.126, 13.141], [-18.521, 10.693], [-19.043, 7.888], [-18.919, 5.069], [-18.57, 2.445], [-18.4, 0], [-18.57, -2.445], [-18.919, -5.069], [-19.043, -7.888], [-18.521, -10.693], [-17.126, -13.141], [-14.942, -14.942], [-12.302, -16.033], [-9.6, -16.628], [-7.088, -17.112], [-4.776, -17.826], [-2.483, -18.863], [0, -20], [2.738, -20.795], [5.576, -20.811], [8.219, -19.843], [10.4, -18.013], [12.048, -15.701], [13.342, -13.342], [14.609, -11.21], [16.121, -9.307], [17.912, -7.419], [19.719, -5.284], [21.087, -2.776]];

difference() {
  union() {
    /* grip outline extruded straight up */
    linear_extrude(height = grip_h) polygon(grip);
    /* boss sunk half a millimetre into the grip */
    translate([0, 0, grip_h - 0.5]) cylinder(h = boss_h + 0.5, d = boss_d);
  }
  /* threaded bore through grip and boss */
  translate([0, 0, -2.5]) cylinder(h = grip_h + boss_h + 5, d = bore_d);
  translate([0, 0, 2.0]) rotate_extrude() polygon([[5.35, 0], [5.35, 12], [5.85, 12], [7.4, 11.125], [5.85, 10.25], [7.4, 9.375], [5.85, 8.5], [7.4, 7.625], [5.85, 6.75], [7.4, 5.875], [5.85, 5], [7.4, 4.125], [5.85, 3.25], [7.4, 2.375], [5.85, 0], [5.35, 0]]);
}
