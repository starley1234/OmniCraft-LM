$fn = 32;

// ----------------------------------------------------------------------
// Thumb nut: 8 lobe grip, 22 mm tall, M12.7 thread
// ----------------------------------------------------------------------

// --- parameters (mm) ---
base_r = 18;              // grip base radius
lobe_amp = 2.5;           // lobe height above the base radius
lobes = 8;                // number of grip lobes
grip_h = 16;              // grip height
boss_d = 20.7;            // threaded boss diameter
boss_h = 6;               // boss height
bore_d = 12.7;            // thread core diameter
pitch = 1.75;             // thread pitch
thread_d = 1.05;          // thread depth

grip = [[20.5, 0], [19.085, 2.513], [16.179, 4.335], [14.32, 5.932], [14.506, 8.375], [15.272, 11.719], [14.496, 14.496], [11.719, 15.272], [8.375, 14.506], [5.932, 14.32], [4.335, 16.179], [2.513, 19.085], [0, 20.5], [-2.513, 19.085], [-4.335, 16.179], [-5.932, 14.32], [-8.375, 14.506], [-11.719, 15.272], [-14.496, 14.496], [-15.272, 11.719], [-14.506, 8.375], [-14.32, 5.932], [-16.179, 4.335], [-19.085, 2.513], [-20.5, 0], [-19.085, -2.513], [-16.179, -4.335], [-14.32, -5.932], [-14.506, -8.375], [-15.272, -11.719], [-14.496, -14.496], [-11.719, -15.272], [-8.375, -14.506], [-5.932, -14.32], [-4.335, -16.179], [-2.513, -19.085], [0, -20.5], [2.513, -19.085], [4.335, -16.179], [5.932, -14.32], [8.375, -14.506], [11.719, -15.272], [14.496, -14.496], [15.272, -11.719], [14.506, -8.375], [14.32, -5.932], [16.179, -4.335], [19.085, -2.513]];

difference() {
  union() {
    /* grip outline extruded straight up */
    linear_extrude(height = grip_h) polygon(grip);
    /* boss sunk half a millimetre into the grip */
    translate([0, 0, grip_h - 0.5]) cylinder(h = boss_h + 0.5, d = boss_d);
  }
  /* threaded bore through grip and boss */
  translate([0, 0, -2.5]) cylinder(h = grip_h + boss_h + 5, d = bore_d);
  translate([0, 0, 2.0]) rotate_extrude() polygon([[5.35, 0], [5.35, 18], [5.85, 18], [7.4, 17.125], [5.85, 16.25], [7.4, 15.375], [5.85, 14.5], [7.4, 13.625], [5.85, 12.75], [7.4, 11.875], [5.85, 11], [7.4, 10.125], [5.85, 9.25], [7.4, 8.375], [5.85, 7.5], [7.4, 6.625], [5.85, 5.75], [7.4, 4.875], [5.85, 4], [7.4, 3.125], [5.85, 0], [5.35, 0]]);
}
