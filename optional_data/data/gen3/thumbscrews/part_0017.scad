$fn = 32;

// ----------------------------------------------------------------------
// Thumb nut: 4 lobe grip, 24 mm tall, M9.53 thread
// ----------------------------------------------------------------------

// --- parameters (mm) ---
base_r = 14;              // grip base radius
lobe_amp = 1.6;           // lobe height above the base radius
lobes = 4;                // number of grip lobes
grip_h = 16;              // grip height
boss_d = 17.52;           // threaded boss diameter
boss_h = 8;               // boss height
bore_d = 9.53;            // thread core diameter
pitch = 1.75;             // thread pitch
thread_d = 1.05;          // thread depth

grip = [[15.6, 0], [15.254, 2.008], [14.296, 3.831], [12.934, 5.358], [11.432, 6.6], [10.008, 7.679], [8.768, 8.768], [7.679, 10.008], [6.6, 11.432], [5.358, 12.934], [3.831, 14.296], [2.008, 15.254], [0, 15.6], [-2.008, 15.254], [-3.831, 14.296], [-5.358, 12.934], [-6.6, 11.432], [-7.679, 10.008], [-8.768, 8.768], [-10.008, 7.679], [-11.432, 6.6], [-12.934, 5.358], [-14.296, 3.831], [-15.254, 2.008], [-15.6, 0], [-15.254, -2.008], [-14.296, -3.831], [-12.934, -5.358], [-11.432, -6.6], [-10.008, -7.679], [-8.768, -8.768], [-7.679, -10.008], [-6.6, -11.432], [-5.358, -12.934], [-3.831, -14.296], [-2.008, -15.254], [0, -15.6], [2.008, -15.254], [3.831, -14.296], [5.358, -12.934], [6.6, -11.432], [7.679, -10.008], [8.768, -8.768], [10.008, -7.679], [11.432, -6.6], [12.934, -5.358], [14.296, -3.831], [15.254, -2.008]];

difference() {
  union() {
    /* grip outline extruded straight up */
    linear_extrude(height = grip_h) polygon(grip);
    /* boss sunk half a millimetre into the grip */
    translate([0, 0, grip_h - 0.5]) cylinder(h = boss_h + 0.5, d = boss_d);
  }
  /* threaded bore through grip and boss */
  translate([0, 0, -2.5]) cylinder(h = grip_h + boss_h + 5, d = bore_d);
  translate([0, 0, 2.0]) rotate_extrude() polygon([[3.763, 0], [3.763, 20], [4.263, 20], [5.812, 19.125], [4.263, 18.25], [5.812, 17.375], [4.263, 16.5], [5.812, 15.625], [4.263, 14.75], [5.812, 13.875], [4.263, 13], [5.812, 12.125], [4.263, 11.25], [5.812, 10.375], [4.263, 9.5], [5.812, 8.625], [4.263, 7.75], [5.812, 6.875], [4.263, 6], [5.812, 5.125], [4.263, 4.25], [5.812, 3.375], [4.263, 2.5], [5.812, 1.625], [4.263, 0], [3.763, 0]]);
