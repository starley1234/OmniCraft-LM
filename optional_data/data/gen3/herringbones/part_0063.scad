difference() {
  union() {
    /* lower half, twisted one way */
    linear_extrude(height = half_w + 0.4, twist = helix, slices = 20) polygon(teeth_profile);
    /* upper half, twisted the other way, overlapping the joint */
    translate([0, 0, half_w - 0.4]) linear_extrude(height = half_w + 0.4, twist = -helix, slices = 20) polygon(teeth_profile);
