$fn = 32;

// ----------------------------------------------------------------------
// Worm wheel: z16 module 3.5, 42 degree helix, 24 mm hub
// ----------------------------------------------------------------------

// --- parameters (mm) ---
gear_module = 3.5;        // tooth module
teeth = 16;               // tooth count
helix = 42;               // helix angle of the rim
rim_w = 12;               // rim width
hub_r = 15.7;             // hub radius
hub_h = 24;               // hub height
bore_d = 25.4;            // hub bore
key_w = 5;                // keyway width
key_depth = 2.5;          // keyway depth
screw_d = 4;              // set screw thread

rim_profile = [[23.474, -2.664], [27.942, -2.725], [29.714, -2.092], [31.478, -1.165], [31.478, 1.165], [29.714, 2.092], [27.942, 2.725], [23.474, 2.664], [22.707, 6.522], [26.857, 8.176], [28.252, 9.438], [29.528, 10.97], [28.637, 13.122], [26.651, 13.303], [24.772, 13.21], [20.668, 11.444], [18.483, 14.715], [21.684, 17.831], [22.49, 19.532], [23.082, 21.435], [21.435, 23.082], [19.532, 22.49], [17.831, 21.684], [14.715, 18.483], [11.444, 20.668], [13.21, 24.772], [13.303, 26.651], [13.122, 28.637], [10.97, 29.528], [9.438, 28.252], [8.176, 26.857], [6.522, 22.707], [2.664, 23.474], [2.725, 27.942], [2.092, 29.714], [1.165, 31.478], [-1.165, 31.478], [-2.092, 29.714], [-2.725, 27.942], [-2.664, 23.474], [-6.522, 22.707], [-8.176, 26.857], [-9.438, 28.252], [-10.97, 29.528], [-13.122, 28.637], [-13.303, 26.651], [-13.21, 24.772], [-11.444, 20.668], [-14.715, 18.483], [-17.831, 21.684], [-19.532, 22.49], [-21.435, 23.082], [-23.082, 21.435], [-22.49, 19.532], [-21.684, 17.831], [-18.483, 14.715], [-20.668, 11.444], [-24.772, 13.21], [-26.651, 13.303], [-28.637, 13.122], [-29.528, 10.97], [-28.252, 9.438], [-26.857, 8.176], [-22.707, 6.522], [-23.474, 2.664], [-27.942, 2.725], [-29.714, 2.092], [-31.478, 1.165], [-31.478, -1.165], [-29.714, -2.092], [-27.942, -2.725], [-23.474, -2.664], [-22.707, -6.522], [-26.857, -8.176], [-28.252, -9.438], [-29.528, -10.97], [-28.637, -13.122], [-26.651, -13.303], [-24.772, -13.21], [-20.668, -11.444], [-18.483, -14.715], [-21.684, -17.831], [-22.49, -19.532], [-23.082, -21.435], [-21.435, -23.082], [-19.532, -22.49], [-17.831, -21.684], [-14.715, -18.483], [-11.444, -20.668], [-13.21, -24.772], [-13.303, -26.651], [-13.122, -28.637], [-10.97, -29.528], [-9.438, -28.252], [-8.176, -26.857], [-6.522, -22.707], [-2.664, -23.474], [-2.725, -27.942], [-2.092, -29.714], [-1.165, -31.478], [1.165, -31.478], [2.092, -29.714], [2.725, -27.942], [2.664, -23.474], [6.522, -22.707], [8.176, -26.857], [9.438, -28.252], [10.97, -29.528], [13.1