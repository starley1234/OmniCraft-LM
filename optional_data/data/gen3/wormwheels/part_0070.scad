$fn = 32;

// ----------------------------------------------------------------------
// Worm wheel: z16 module 2, 35 degree helix, 28 mm hub
// ----------------------------------------------------------------------

// --- parameters (mm) ---
gear_module = 2;          // tooth module
teeth = 16;               // tooth count
helix = 35;               // helix angle of the rim
rim_w = 14;               // rim width
hub_r = 14.11;            // hub radius
hub_h = 28;               // hub height
bore_d = 22.23;           // hub bore
key_w = 6;                // keyway width
key_depth = 3;            // keyway depth
screw_d = 6;              // set screw thread

rim_profile = [[13.414, -1.521], [15.981, -1.553], [16.987, -1.192], [17.988, -0.666], [17.988, 0.666], [16.987, 1.192], [15.981, 1.553], [13.414, 1.521], [12.975, 3.728], [15.359, 4.681], [16.15, 5.399], [16.873, 6.269], [16.364, 7.498], [15.237, 7.602], [14.171, 7.551], [11.811, 6.538], [10.561, 8.41], [12.399, 10.202], [12.854, 11.168], [13.19, 12.249], [12.249, 13.19], [11.168, 12.854], [10.202, 12.399], [8.41, 10.561], [6.538, 11.811], [7.551, 14.171], [7.602, 15.237], [7.498, 16.364], [6.269, 16.873], [5.399, 16.15], [4.681, 15.359], [3.728, 12.975], [1.521, 13.414], [1.553, 15.981], [1.192, 16.987], [0.666, 17.988], [-0.666, 17.988], [-1.192, 16.987], [-1.553, 15.981], [-1.521, 13.414], [-3.728, 12.975], [-4.681, 15.359], [-5.399, 16.15], [-6.269, 16.873], [-7.498, 16.364], [-7.602, 15.237], [-7.551, 14.171], [-6.538, 11.811], [-8.41, 10.561], [-10.202, 12.399], [-11.168, 12.854], [-12.249, 13.19], [-13.19, 12.249], [-12.854, 11.168], [-12.399, 10.202], [-10.561, 8.41], [-11.811, 6.538], [-14.171, 7.551], [-15.237, 7.602], [-16.364, 7.498], [-16.873, 6.269], [-16.15, 5.399], [-15.359, 4.681], [-12.975, 3.728], [-13.414, 1.521], [-15.981, 1.553], [-16.987, 1.192], [-17.988, 0.666], [-17.988, -0.666], [-16.987, -1.192], [-15.981, -1.553], [-13.414, -1.521], [-12.975, -3.728], [-15.359, -4.681], [-16.15, -5.399], [-16.873, -6.269], [-16.364, -7.498], [-15.237, -7.602], [-14.171, -7.551], [-11.811, -6.538], [-10.561, -8.41], [-12.399, -10.202], [-12.854, -11.168], [-13.19, -12.249], [-12.249, -13.19], [-11.168, -12.854], [-10.202, -12.399], [-8.41, -10.561], [-6.538, -11.811], [-7.551, -14.171], [-7.602, -15.237], [-7.498, -16.364], [-6.269, -16.873], [-5.399, -16.15], [-4.681, -15.359], [-3.728, -12.975], [-1.521, -13.414], [-1.553, -15.981], [-1.192, -16.987], [-0.666, -17.988], [0.666, -17.988], [1.192, -16.987], [1.553, -15.981], [1.521, -13.414], [3.728, -12.975], [4.681, -15.359], [5.399, -16.15], [6.269, -16.873], [7.498, -16.364], [7.602, -15.237], [7.551