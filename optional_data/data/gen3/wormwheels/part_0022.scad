$fn = 32;

// ----------------------------------------------------------------------
// Worm wheel: z16 module 3, 55 degree helix, 30 mm hub
// ----------------------------------------------------------------------

// --- parameters (mm) ---
gear_module = 3;          // tooth module
teeth = 16;               // tooth count
helix = 55;               // helix angle of the rim
rim_w = 16;               // rim width
hub_r = 15.7;             // hub radius
hub_h = 30;               // hub height
bore_d = 25.4;            // hub bore
key_w = 4;                // keyway width
key_depth = 2;            // keyway depth
screw_d = 4;              // set screw thread

rim_profile = [[20.121, -2.283], [23.955, -2.334], [25.471, -1.792], [26.982, -0.998], [26.982, 0.998], [25.471, 1.792], [23.955, 2.334], [20.121, 2.283], [19.463, 5.591], [23.025, 7.011], [24.218, 8.092], [25.31, 9.403], [24.546, 11.248], [22.847, 11.403], [21.238, 11.324], [17.716, 9.809], [15.842, 12.613], [18.589, 15.288], [19.278, 16.744], [19.785, 18.373], [18.373, 19.785], [16.744, 19.278], [15.288, 18.589], [12.613, 15.842], [9.809, 17.716], [11.324, 21.238], [11.403, 22.847], [11.248, 24.546], [9.403, 25.31], [8.092, 24.218], [7.011, 23.025], [5.591, 19.463], [2.283, 20.121], [2.334, 23.955], [1.792, 25.471], [0.998, 26.982], [-0.998, 26.982], [-1.792, 25.471], [-2.334, 23.955], [-2.283, 20.121], [-5.591, 19.463], [-7.011, 23.025], [-8.092, 24.218], [-9.403, 25.31], [-11.248, 24.546], [-11.403, 22.847], [-11.324, 21.238], [-9.809, 17.716], [-12.613, 15.842], [-15.288, 18.589], [-16.744, 19.278], [-18.373, 19.785], [-19.785, 18.373], [-19.278, 16.744], [-18.589, 15.288], [-15.842, 12.613], [-17.716, 9.809], [-21.238, 11.324], [-22.847, 11.403], [-24.546, 11.248], [-25.31, 9.403], [-24.218, 8.092], [-23.025, 7.011], [-19.463, 5.591], [-20.121, 2.283], [-23.955, 2.334], [-25.471, 1.792], [-26.982, 0.998], [-26.982, -0.998], [-25.471, -1.792], [-23.955, -2.334], [-20.121, -2.283], [-19.463, -5.591], [-23.025, -7.011], [-24.218, -8.092], [-25.31, -9.403], [-24.546, -11.248], [-22.847, -11.403], [-21.238, -11.324], [-17.716, -9.809], [-15.842, -12.613], [-18.589, -15.288], [-19.278, -16.744], [-19.785, -18.373], [-18.373, -19.785], [-16.744, -19.278], [-15.288, -18.589], [-12.613, -15.842], [-9.809, -17.716], [-11.324, -21.238], [-11.403, -22.847], [-11.248, -24.546], [-9.403, -25.31], [-8.092, -24.218], [-7.011, -23.025], [-5.591, -19.463], [-2.283, -20.121], [-2.334, -23.955], [-1.792, -25.471], [-0.998, -26.982], [0.998, -26.982], [1.792, -25.471], [2.334, -23.955], [2.283, -20.121], [5.591, -19.463], [7.011, -23.025], [8.092, -24.218], [9.403, -25.31], [11.24