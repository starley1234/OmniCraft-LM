    /* hub */
    cylinder(h = hub_h, d = 2 * hub_r);
  }
  /* bore */
  translate([0, 0, -2.5]) cylinder(h = hub_h + 5, d = bore_d);
  /* keyway, milled through the whole hub */
  translate([bore_d / 2 - key_depth, -key_w / 2, -2.5]) cube([key_depth + 2.5, key_w, hub_h + 5]);
