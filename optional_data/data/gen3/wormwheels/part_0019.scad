difference() {
  union() {
    /* rim, twisted to stand in for the helical worm teeth */
    translate([0, 0, (hub_h - rim_w) / 2]) linear_extrude(height = rim_w, twist = helix, slices = 24) polygon(rim_profile);
    /* hub */
    cylinder(h = hub_h, d = 2 * hub_r);
  }
  /* bore */
  translate([0, 0, -2.5]) cylinder(h = hub_h + 5, d = bore_d);
  /* keyway, milled through the whole hub */
  translate([bore_d / 2 - key_depth, -key_w / 2, -2.5]) cube([key_depth + 2.5, key_w, hub_h + 5]);
  /* set screw hole straight through the hub wall */
  translate([0, -hub_r - 2.5, hub_h / 2]) rotate([-90, 0, 0]) cylinder(h = 2 * hub_r + 5, d = screw_d);
}
