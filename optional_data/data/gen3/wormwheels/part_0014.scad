$fn = 32;

// ----------------------------------------------------------------------
// Worm wheel: z16 module 2.5, 55 degree helix, 28 mm hub
// ----------------------------------------------------------------------

// --- parameters (mm) ---
gear_module = 2.5;        // tooth module
teeth = 16;               // tooth count
helix = 55;               // helix angle of the rim
rim_w = 16;               // rim width
hub_r = 22.05;            // hub radius
hub_h = 28;               // hub height
bore_d = 38.1;            // hub bore
key_w = 5;                // keyway width
key_depth = 2.5;          // keyway depth
screw_d = 6;              // set screw thread

rim_profile = [[16.767, -1.902], [19.968, -1.943], [21.229, -1.492], [22.485, -0.832], [22.485, 0.832], [21.229, 1.492], [19.968, 1.943], [16.767, 1.902], [16.219, 4.659], [19.192, 5.846], [20.184, 6.746], [21.091, 7.836], [20.455, 9.373], [19.042, 9.502], [17.704, 9.437], [14.763, 8.174], [13.201, 10.511], [15.494, 12.745], [16.066, 13.956], [16.487, 15.311], [15.311, 16.487], [13.956, 16.066], [12.745, 15.494], [10.511, 13.201], [8.174, 14.763], [9.437, 17.704], [9.502, 19.042], [9.373, 20.455], [7.836, 21.091], [6.746, 20.184], [5.846, 19.192], [4.659, 16.219], [1.902, 16.767], [1.943, 19.968], [1.492, 21.229], [0.832, 22.485], [-0.832, 22.485], [-1.492, 21.229], [-1.943, 19.968], [-1.902, 16.767], [-4.659, 16.219], [-5.846, 19.192], [-6.746, 20.184], [-7.836, 21.091], [-9.373, 20.455], [-9.502, 19.042], [-9.437, 17.704], [-8.174, 14.763], [-10.511, 13.201], [-12.745, 15.494], [-13.956, 16.066], [-15.311, 16.487], [-16.487, 15.311], [-16.066, 13.956], [-15.494, 12.745], [-13.201, 10.511], [-14.763, 8.174], [-17.704, 9.437], [-19.042, 9.502], [-20.455, 9.373], [-21.091, 7.836], [-20.184, 6.746], [-19.192, 5.846], [-16.219, 4.659], [-16.767, 1.902], [-19.968, 1.943], [-21.229, 1.492], [-22.485, 0.832], [-22.485, -0.832], [-21.229, -1.492], [-19.968, -1.943], [-16.767, -1.902], [-16.219, -4.659], [-19.192, -5.846], [-20.184, -6.746], [-21.091, -7.836], [-20.455, -9.373], [-19.042, -9.502], [-17.704, -9.437], [-14.763, -8.174], [-13.201, -10.511], [-15.494, -12.745], [-16.066, -13.956], [-16.487, -15.311], [-15.311, -16.487], [-13.956, -16.066], [-12.745, -15.494], [-10.511, -13.201], [-8.174, -14.763], [-9.437, -17.704], [-9.502, -19.042], [-9.373, -20.455], [-7.836, -21.091], [-6.746, -20.184], [-5.846, -19.192], [-4.659, -16.219], [-1.902, -16.767], [-1.943, -19.968], [-1.492, -21.229], [-0.832, -22.485], [0.832, -22.485], [1.492, -21.229], [1.943, -19.968], [1.902, -16.767], [4.659, -16.219], [5.846, -19.192], [6.746, -20.184], [7.836, -21.091], [9.373, -20.455],