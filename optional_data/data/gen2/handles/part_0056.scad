$fn = 32;

// ----------------------------------------------------------------------
// Handle: 120 x 36 mm grip, 10 mm thick
// ----------------------------------------------------------------------

// --- parameters (mm) ---
length = 120;             // grip length
width = 36;               // grip width
thickness = 10;           // grip thickness
waist = 0.8;              // width factor at the middle
draft = 0.97;             // top face scale of the extrusion
scallops = 5;             // finger rests per side
ripple = 0.04;            // depth factor of the finger rests

/* ergonomic grip outline, closed spline-like polygon in the XY plane */
grip = [[-42, 18], [-36.75, 17.218], [-31.5, 16.628], [-26.25, 15.45], [-21, 15.3], [-15.75, 15.38], [-10.5, 14.237], [-5.25, 14.238], [0, 14.976], [5.25, 14.238], [10.5, 14.237], [15.75, 15.38], [21, 15.3], [26.25, 15.45], [31.5, 16.628], [36.75, 17.218], [42, 18], [51, 15.588], [57.588, 9], [60, 0], [57.588, -9], [51, -15.588], [42, -18], [42, -18], [36.75, -17.218], [31.5, -16.628], [26.25, -15.45], [21, -15.3], [15.75, -15.38], [10.5, -14.237], [5.25, -14.238], [0, -14.976], [-5.25, -14.238], [-10.5, -14.237], [-15.75, -15.38], [-21, -15.3], [-26.25, -15.45], [-31.5, -16.628], [-36.75, -17.218], [-42, -18], [-51, -15.588], [-57.588, -9], [-60, 0], [-57.588, 9], [-51, 15.588], [-42, 18]];

module grip_body() {
  linear_extrude(height = thickness, scale = draft) polygon(grip);
}

difference() {
  union() {
    grip_body();
  }
}
