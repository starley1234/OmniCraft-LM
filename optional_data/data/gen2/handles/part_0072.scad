$fn = 32;

// ----------------------------------------------------------------------
// Handle: 80 x 30 mm grip, 12 mm thick
// ----------------------------------------------------------------------

// --- parameters (mm) ---
length = 80;              // grip length
width = 30;               // grip width
thickness = 12;           // grip thickness
waist = 0.8;              // width factor at the middle
draft = 0.9;              // top face scale of the extrusion
scallops = 4;             // finger rests per side
ripple = 0.04;            // depth factor of the finger rests

/* ergonomic grip outline, closed spline-like polygon in the XY plane */
grip = [[-25, 15], [-21.875, 14.297], [-18.75, 13.448], [-15.625, 13.172], [-12.5, 13.133], [-9.375, 12.422], [-6.25, 11.73], [-3.125, 12.047], [0, 12.48], [3.125, 12.047], [6.25, 11.73], [9.375, 12.422], [12.5, 13.133], [15.625, 13.172], [18.75, 13.448], [21.875, 14.297], [25, 15], [32.5, 12.99], [37.99, 7.5], [40, 0], [37.99, -7.5], [32.5, -12.99], [25, -15], [25, -15], [21.875, -14.297], [18.75, -13.448], [15.625, -13.172], [12.5, -13.133], [9.375, -12.422], [6.25, -11.73], [3.125, -12.047], [0, -12.48], [-3.125, -12.047], [-6.25, -11.73], [-9.375, -12.422], [-12.5, -13.133], [-15.625, -13.172], [-18.75, -13.448], [-21.875, -14.297], [-25, -15], [-32.5, -12.99], [-37.99, -7.5], [-40, 0], [-37.99, 7.5], [-32.5, 12.99], [-25, 15]];

module grip_body() {
  linear_extrude(height = thickness, scale = draft) polygon(grip);
}

difference() {
  union() {
    grip_body();
  }
}
