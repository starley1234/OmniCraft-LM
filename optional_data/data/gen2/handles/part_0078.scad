$fn = 32;

// ----------------------------------------------------------------------
// Handle: 180 x 42 mm grip, 12 mm thick
// ----------------------------------------------------------------------

// --- parameters (mm) ---
length = 180;             // grip length
width = 42;               // grip width
thickness = 12;           // grip thickness
waist = 0.8;              // width factor at the middle
draft = 0.97;             // top face scale of the extrusion
scallops = 6;             // finger rests per side
ripple = 0.06;            // depth factor of the finger rests

/* ergonomic grip outline, closed spline-like polygon in the XY plane */
grip = [[-69, 21], [-60.375, 19.817], [-51.75, 19.162], [-43.125, 18.917], [-34.5, 17.047], [-25.875, 18.025], [-17.25, 17.062], [-8.625, 16.161], [0, 17.808], [8.625, 16.161], [17.25, 17.062], [25.875, 18.025], [34.5, 17.047], [43.125, 18.917], [51.75, 19.162], [60.375, 19.817], [69, 21], [79.5, 18.187], [87.187, 10.5], [90, 0], [87.187, -10.5], [79.5, -18.187], [69, -21], [69, -21], [60.375, -19.817], [51.75, -19.162], [43.125, -18.917], [34.5, -17.047], [25.875, -18.025], [17.25, -17.062], [8.625, -16.161], [0, -17.808], [-8.625, -16.161], [-17.25, -17.062], [-25.875, -18.025], [-34.5, -17.047], [-43.125, -18.917], [-51.75, -19.162], [-60.375, -19.817], [-69, -21], [-79.5, -18.187], [-87.187, -10.5], [-90, 0], [-87.187, 10.5], [-79.5, 18.187], [-69, 21]];

module grip_body() {
  linear_extrude(height = thickness, scale = draft) polygon(grip);
}

difference() {
  union() {
    grip_body();
  }
}
