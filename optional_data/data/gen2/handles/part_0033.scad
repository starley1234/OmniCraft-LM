$fn = 32;

// ----------------------------------------------------------------------
// Handle: 80 x 26 mm grip, 10 mm thick
// ----------------------------------------------------------------------

// --- parameters (mm) ---
length = 80;              // grip length
width = 26;               // grip width
thickness = 10;           // grip thickness
waist = 0.86;             // width factor at the middle
draft = 0.94;             // top face scale of the extrusion
scallops = 4;             // finger rests per side
ripple = 0.04;            // depth factor of the finger rests

/* ergonomic grip outline, closed spline-like polygon in the XY plane */
grip = [[-27, 13], [-23.625, 12.573], [-20.25, 11.99], [-16.875, 11.891], [-13.5, 11.984], [-10.125, 11.436], [-6.75, 10.87], [-3.375, 11.208], [0, 11.627], [3.375, 11.208], [6.75, 10.87], [10.125, 11.436], [13.5, 11.984], [16.875, 11.891], [20.25, 11.99], [23.625, 12.573], [27, 13], [33.5, 11.258], [38.258, 6.5], [40, 0], [38.258, -6.5], [33.5, -11.258], [27, -13], [27, -13], [23.625, -12.573], [20.25, -11.99], [16.875, -11.891], [13.5, -11.984], [10.125, -11.436], [6.75, -10.87], [3.375, -11.208], [0, -11.627], [-3.375, -11.208], [-6.75, -10.87], [-10.125, -11.436], [-13.5, -11.984], [-16.875, -11.891], [-20.25, -11.99], [-23.625, -12.573], [-27, -13], [-33.5, -11.258], [-38.258, -6.5], [-40, 0], [-38.258, 6.5], [-33.5, 11.258], [-27, 13]];

module grip_body() {
  linear_extrude(height = thickness, scale = draft) polygon(grip);
}

difference() {
  union() {
    grip_body();
  }
}
