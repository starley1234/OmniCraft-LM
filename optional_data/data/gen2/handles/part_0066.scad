$fn = 32;

// ----------------------------------------------------------------------
// Handle: 80 x 30 mm grip, 14 mm thick
// ----------------------------------------------------------------------

// --- parameters (mm) ---
length = 80;              // grip length
width = 30;               // grip width
thickness = 14;           // grip thickness
waist = 0.72;             // width factor at the middle
draft = 0.9;              // top face scale of the extrusion

/* ergonomic grip outline, closed spline-like polygon in the XY plane */
grip = [[-25, 15], [-21.875, 14.016], [-18.75, 13.162], [-15.625, 12.441], [-12.5, 11.85], [-9.375, 11.391], [-6.25, 11.062], [-3.125, 10.866], [0, 10.8], [3.125, 10.866], [6.25, 11.062], [9.375, 11.391], [12.5, 11.85], [15.625, 12.441], [18.75, 13.162], [21.875, 14.016], [25, 15], [32.5, 12.99], [37.99, 7.5], [40, 0], [37.99, -7.5], [32.5, -12.99], [25, -15], [25, -15], [21.875, -14.016], [18.75, -13.162], [15.625, -12.441], [12.5, -11.85], [9.375, -11.391], [6.25, -11.062], [3.125, -10.866], [0, -10.8], [-3.125, -10.866], [-6.25, -11.062], [-9.375, -11.391], [-12.5, -11.85], [-15.625, -12.441], [-18.75, -13.162], [-21.875, -14.016], [-25, -15], [-32.5, -12.99], [-37.99, -7.5], [-40, 0], [-37.99, 7.5], [-32.5, 12.99], [-25, 15]];

module grip_body() {
  linear_extrude(height = thickness, scale = draft) polygon(grip);
}

difference() {
  union() {
    grip_body();
  }
}
