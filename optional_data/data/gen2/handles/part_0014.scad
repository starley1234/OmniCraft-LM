$fn = 32;

// ----------------------------------------------------------------------
// Handle: 100 x 22 mm grip, 12 mm thick
// ----------------------------------------------------------------------

// --- parameters (mm) ---
length = 100;             // grip length
width = 22;               // grip width
thickness = 12;           // grip thickness
waist = 0.86;             // width factor at the middle
draft = 0.9;              // top face scale of the extrusion

/* ergonomic grip outline, closed spline-like polygon in the XY plane */
grip = [[-39, 11], [-34.125, 10.639], [-29.25, 10.326], [-24.375, 10.062], [-19.5, 9.845], [-14.625, 9.677], [-9.75, 9.556], [-4.875, 9.484], [0, 9.46], [4.875, 9.484], [9.75, 9.556], [14.625, 9.677], [19.5, 9.845], [24.375, 10.062], [29.25, 10.326], [34.125, 10.639], [39, 11], [44.5, 9.526], [48.526, 5.5], [50, 0], [48.526, -5.5], [44.5, -9.526], [39, -11], [39, -11], [34.125, -10.639], [29.25, -10.326], [24.375, -10.062], [19.5, -9.845], [14.625, -9.677], [9.75, -9.556], [4.875, -9.484], [0, -9.46], [-4.875, -9.484], [-9.75, -9.556], [-14.625, -9.677], [-19.5, -9.845], [-24.375, -10.062], [-29.25, -10.326], [-34.125, -10.639], [-39, -11], [-44.5, -9.526], [-48.526, -5.5], [-50, 0], [-48.526, 5.5], [-44.5, 9.526], [-39, 11]];

module grip_body() {
  linear_extrude(height = thickness, scale = draft) polygon(grip);
}

difference() {
  union() {
    grip_body();
  }
}
