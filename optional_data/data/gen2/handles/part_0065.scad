$fn = 32;

// ----------------------------------------------------------------------
// Handle: 150 x 36 mm grip, 12 mm thick
// ----------------------------------------------------------------------

// --- parameters (mm) ---
length = 150;             // grip length
width = 36;               // grip width
thickness = 12;           // grip thickness
waist = 0.8;              // width factor at the middle
draft = 0.97;             // top face scale of the extrusion

/* ergonomic grip outline, closed spline-like polygon in the XY plane */
grip = [[-57, 18], [-49.875, 17.156], [-42.75, 16.425], [-35.625, 15.806], [-28.5, 15.3], [-21.375, 14.906], [-14.25, 14.625], [-7.125, 14.456], [0, 14.4], [7.125, 14.456], [14.25, 14.625], [21.375, 14.906], [28.5, 15.3], [35.625, 15.806], [42.75, 16.425], [49.875, 17.156], [57, 18], [66, 15.588], [72.588, 9], [75, 0], [72.588, -9], [66, -15.588], [57, -18], [57, -18], [49.875, -17.156], [42.75, -16.425], [35.625, -15.806], [28.5, -15.3], [21.375, -14.906], [14.25, -14.625], [7.125, -14.456], [0, -14.4], [-7.125, -14.456], [-14.25, -14.625], [-21.375, -14.906], [-28.5, -15.3], [-35.625, -15.806], [-42.75, -16.425], [-49.875, -17.156], [-57, -18], [-66, -15.588], [-72.588, -9], [-75, 0], [-72.588, 9], [-66, 15.588], [-57, 18]];

module grip_body() {
  linear_extrude(height = thickness, scale = draft) polygon(grip);
}

difference() {
  union() {
    grip_body();
  }
}
