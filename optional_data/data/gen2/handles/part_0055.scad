$fn = 32;

// ----------------------------------------------------------------------
// Handle: 150 x 42 mm grip, 16 mm thick
// ----------------------------------------------------------------------

// --- parameters (mm) ---
length = 150;             // grip length
width = 42;               // grip width
thickness = 16;           // grip thickness
waist = 0.86;             // width factor at the middle
draft = 0.97;             // top face scale of the extrusion

/* ergonomic grip outline, closed spline-like polygon in the XY plane */
grip = [[-54, 21], [-47.25, 20.311], [-40.5, 19.714], [-33.75, 19.208], [-27, 18.795], [-20.25, 18.473], [-13.5, 18.244], [-6.75, 18.106], [0, 18.06], [6.75, 18.106], [13.5, 18.244], [20.25, 18.473], [27, 18.795], [33.75, 19.208], [40.5, 19.714], [47.25, 20.311], [54, 21], [64.5, 18.187], [72.187, 10.5], [75, 0], [72.187, -10.5], [64.5, -18.187], [54, -21], [54, -21], [47.25, -20.311], [40.5, -19.714], [33.75, -19.208], [27, -18.795], [20.25, -18.473], [13.5, -18.244], [6.75, -18.106], [0, -18.06], [-6.75, -18.106], [-13.5, -18.244], [-20.25, -18.473], [-27, -18.795], [-33.75, -19.208], [-40.5, -19.714], [-47.25, -20.311], [-54, -21], [-64.5, -18.187], [-72.187, -10.5], [-75, 0], [-72.187, 10.5], [-64.5, 18.187], [-54, 21]];

module grip_body() {
  linear_extrude(height = thickness, scale = draft) polygon(grip);
}

difference() {
  union() {
    grip_body();
  }
}
