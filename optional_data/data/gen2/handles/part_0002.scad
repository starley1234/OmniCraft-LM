$fn = 32;

// ----------------------------------------------------------------------
// Handle: 150 x 42 mm grip, 14 mm thick
// ----------------------------------------------------------------------

// --- parameters (mm) ---
length = 150;             // grip length
width = 42;               // grip width
thickness = 14;           // grip thickness
waist = 0.8;              // width factor at the middle
draft = 0.94;             // top face scale of the extrusion

/* ergonomic grip outline, closed spline-like polygon in the XY plane */
grip = [[-54, 21], [-47.25, 20.016], [-40.5, 19.162], [-33.75, 18.441], [-27, 17.85], [-20.25, 17.391], [-13.5, 17.062], [-6.75, 16.866], [0, 16.8], [6.75, 16.866], [13.5, 17.062], [20.25, 17.391], [27, 17.85], [33.75, 18.441], [40.5, 19.162], [47.25, 20.016], [54, 21], [64.5, 18.187], [72.187, 10.5], [75, 0], [72.187, -10.5], [64.5, -18.187], [54, -21], [54, -21], [47.25, -20.016], [40.5, -19.162], [33.75, -18.441], [27, -17.85], [20.25, -17.391], [13.5, -17.062], [6.75, -16.866], [0, -16.8], [-6.75, -16.866], [-13.5, -17.062], [-20.25, -17.391], [-27, -17.85], [-33.75, -18.441], [-40.5, -19.162], [-47.25, -20.016], [-54, -21], [-64.5, -18.187], [-72.187, -10.5], [-75, 0], [-72.187, 10.5], [-64.5, 18.187], [-54, 21]];

module grip_body() {
  linear_extrude(height = thickness, scale = draft) polygon(grip);
}

difference() {
  union() {
    grip_body();
  }
}
