$fn = 32;

// ----------------------------------------------------------------------
// Handle: 150 x 30 mm grip, 12 mm thick
// ----------------------------------------------------------------------

// --- parameters (mm) ---
length = 150;             // grip length
width = 30;               // grip width
thickness = 12;           // grip thickness
waist = 0.86;             // width factor at the middle
draft = 0.94;             // top face scale of the extrusion

/* ergonomic grip outline, closed spline-like polygon in the XY plane */
grip = [[-60, 15], [-52.5, 14.508], [-45, 14.081], [-37.5, 13.72], [-30, 13.425], [-22.5, 13.195], [-15, 13.031], [-7.5, 12.933], [0, 12.9], [7.5, 12.933], [15, 13.031], [22.5, 13.195], [30, 13.425], [37.5, 13.72], [45, 14.081], [52.5, 14.508], [60, 15], [67.5, 12.99], [72.99, 7.5], [75, 0], [72.99, -7.5], [67.5, -12.99], [60, -15], [60, -15], [52.5, -14.508], [45, -14.081], [37.5, -13.72], [30, -13.425], [22.5, -13.195], [15, -13.031], [7.5, -12.933], [0, -12.9], [-7.5, -12.933], [-15, -13.031], [-22.5, -13.195], [-30, -13.425], [-37.5, -13.72], [-45, -14.081], [-52.5, -14.508], [-60, -15], [-67.5, -12.99], [-72.99, -7.5], [-75, 0], [-72.99, 7.5], [-67.5, 12.99], [-60, 15]];

module grip_body() {
  linear_extrude(height = thickness, scale = draft) polygon(grip);
}

difference() {
  union() {
    grip_body();
  }
}
