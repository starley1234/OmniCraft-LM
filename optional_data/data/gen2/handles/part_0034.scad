$fn = 32;

// ----------------------------------------------------------------------
// Handle: 180 x 42 mm grip, 16 mm thick
// ----------------------------------------------------------------------

// --- parameters (mm) ---
length = 180;             // grip length
width = 42;               // grip width
thickness = 16;           // grip thickness
waist = 0.86;             // width factor at the middle
draft = 0.9;              // top face scale of the extrusion
scallops = 4;             // finger rests per side
ripple = 0.05;            // depth factor of the finger rests

/* ergonomic grip outline, closed spline-like polygon in the XY plane */
grip = [[-69, 21], [-60.375, 20.311], [-51.75, 19.283], [-43.125, 19.208], [-34.5, 19.5], [-25.875, 18.473], [-17.25, 17.389], [-8.625, 18.106], [0, 18.963], [8.625, 18.106], [17.25, 17.389], [25.875, 18.473], [34.5, 19.5], [43.125, 19.208], [51.75, 19.283], [60.375, 20.311], [69, 21], [79.5, 18.187], [87.187, 10.5], [90, 0], [87.187, -10.5], [79.5, -18.187], [69, -21], [69, -21], [60.375, -20.311], [51.75, -19.283], [43.125, -19.208], [34.5, -19.5], [25.875, -18.473], [17.25, -17.389], [8.625, -18.106], [0, -18.963], [-8.625, -18.106], [-17.25, -17.389], [-25.875, -18.473], [-34.5, -19.5], [-43.125, -19.208], [-51.75, -19.283], [-60.375, -20.311], [-69, -21], [-79.5, -18.187], [-87.187, -10.5], [-90, 0], [-87.187, 10.5], [-79.5, 18.187], [-69, 21]];

module grip_body() {
  linear_extrude(height = thickness, scale = draft) polygon(grip);
}

difference() {
  union() {
    grip_body();
  }
}
