$fn = 32;

// ----------------------------------------------------------------------
// Handle: 80 x 26 mm grip, 14 mm thick
// ----------------------------------------------------------------------

// --- parameters (mm) ---
length = 80;              // grip length
width = 26;               // grip width
thickness = 14;           // grip thickness
waist = 0.72;             // width factor at the middle
draft = 0.9;              // top face scale of the extrusion
scallops = 6;             // finger rests per side
ripple = 0.04;            // depth factor of the finger rests

/* ergonomic grip outline, closed spline-like polygon in the XY plane */
grip = [[-27, 13], [-23.625, 12.066], [-20.25, 11.407], [-16.875, 10.968], [-13.5, 9.962], [-10.125, 10.112], [-6.75, 9.588], [-3.375, 9.155], [0, 9.734], [3.375, 9.155], [6.75, 9.588], [10.125, 10.112], [13.5, 9.962], [16.875, 10.968], [20.25, 11.407], [23.625, 12.066], [27, 13], [33.5, 11.258], [38.258, 6.5], [40, 0], [38.258, -6.5], [33.5, -11.258], [27, -13], [27, -13], [23.625, -12.066], [20.25, -11.407], [16.875, -10.968], [13.5, -9.962], [10.125, -10.112], [6.75, -9.588], [3.375, -9.155], [0, -9.734], [-3.375, -9.155], [-6.75, -9.588], [-10.125, -10.112], [-13.5, -9.962], [-16.875, -10.968], [-20.25, -11.407], [-23.625, -12.066], [-27, -13], [-33.5, -11.258], [-38.258, -6.5], [-40, 0], [-38.258, 6.5], [-33.5, 11.258], [-27, 13]];

module grip_body() {
  linear_extrude(height = thickness, scale = draft) polygon(grip);
}

difference() {
  union() {
    grip_body();
  }
}
