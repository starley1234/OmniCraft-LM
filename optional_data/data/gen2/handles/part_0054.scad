$fn = 32;

// ----------------------------------------------------------------------
// Handle: 100 x 26 mm grip, 14 mm thick
// ----------------------------------------------------------------------

// --- parameters (mm) ---
length = 100;             // grip length
width = 26;               // grip width
thickness = 14;           // grip thickness
waist = 0.8;              // width factor at the middle
draft = 0.97;             // top face scale of the extrusion

/* ergonomic grip outline, closed spline-like polygon in the XY plane */
grip = [[-37, 13], [-32.375, 12.391], [-27.75, 11.862], [-23.125, 11.416], [-18.5, 11.05], [-13.875, 10.766], [-9.25, 10.562], [-4.625, 10.441], [0, 10.4], [4.625, 10.441], [9.25, 10.562], [13.875, 10.766], [18.5, 11.05], [23.125, 11.416], [27.75, 11.862], [32.375, 12.391], [37, 13], [43.5, 11.258], [48.258, 6.5], [50, 0], [48.258, -6.5], [43.5, -11.258], [37, -13], [37, -13], [32.375, -12.391], [27.75, -11.862], [23.125, -11.416], [18.5, -11.05], [13.875, -10.766], [9.25, -10.562], [4.625, -10.441], [0, -10.4], [-4.625, -10.441], [-9.25, -10.562], [-13.875, -10.766], [-18.5, -11.05], [-23.125, -11.416], [-27.75, -11.862], [-32.375, -12.391], [-37, -13], [-43.5, -11.258], [-48.258, -6.5], [-50, 0], [-48.258, 6.5], [-43.5, 11.258], [-37, 13]];

module grip_body() {
  linear_extrude(height = thickness, scale = draft) polygon(grip);
}

difference() {
  union() {
    grip_body();
  }
}
