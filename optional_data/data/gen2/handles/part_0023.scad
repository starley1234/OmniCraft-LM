$fn = 32;

// ----------------------------------------------------------------------
// Handle: 100 x 36 mm grip, 14 mm thick
// ----------------------------------------------------------------------

// --- parameters (mm) ---
length = 100;             // grip length
width = 36;               // grip width
thickness = 14;           // grip thickness
waist = 0.86;             // width factor at the middle
draft = 0.97;             // top face scale of the extrusion

/* ergonomic grip outline, closed spline-like polygon in the XY plane */
grip = [[-32, 18], [-28, 17.409], [-24, 16.898], [-20, 16.464], [-16, 16.11], [-12, 15.834], [-8, 15.638], [-4, 15.519], [0, 15.48], [4, 15.519], [8, 15.638], [12, 15.834], [16, 16.11], [20, 16.464], [24, 16.898], [28, 17.409], [32, 18], [41, 15.588], [47.588, 9], [50, 0], [47.588, -9], [41, -15.588], [32, -18], [32, -18], [28, -17.409], [24, -16.898], [20, -16.464], [16, -16.11], [12, -15.834], [8, -15.638], [4, -15.519], [0, -15.48], [-4, -15.519], [-8, -15.638], [-12, -15.834], [-16, -16.11], [-20, -16.464], [-24, -16.898], [-28, -17.409], [-32, -18], [-41, -15.588], [-47.588, -9], [-50, 0], [-47.588, 9], [-41, 15.588], [-32, 18]];

module grip_body() {
  linear_extrude(height = thickness, scale = draft) polygon(grip);
}

difference() {
  union() {
    grip_body();
  }
}
