$fn = 32;

// ----------------------------------------------------------------------
// Handle: 80 x 22 mm grip, 16 mm thick
// ----------------------------------------------------------------------

// --- parameters (mm) ---
length = 80;              // grip length
width = 22;               // grip width
thickness = 16;           // grip thickness
waist = 0.86;             // width factor at the middle
draft = 0.94;             // top face scale of the extrusion

/* ergonomic grip outline, closed spline-like polygon in the XY plane */
grip = [[-29, 11], [-25.375, 10.639], [-21.75, 10.326], [-18.125, 10.062], [-14.5, 9.845], [-10.875, 9.677], [-7.25, 9.556], [-3.625, 9.484], [0, 9.46], [3.625, 9.484], [7.25, 9.556], [10.875, 9.677], [14.5, 9.845], [18.125, 10.062], [21.75, 10.326], [25.375, 10.639], [29, 11], [34.5, 9.526], [38.526, 5.5], [40, 0], [38.526, -5.5], [34.5, -9.526], [29, -11], [29, -11], [25.375, -10.639], [21.75, -10.326], [18.125, -10.062], [14.5, -9.845], [10.875, -9.677], [7.25, -9.556], [3.625, -9.484], [0, -9.46], [-3.625, -9.484], [-7.25, -9.556], [-10.875, -9.677], [-14.5, -9.845], [-18.125, -10.062], [-21.75, -10.326], [-25.375, -10.639], [-29, -11], [-34.5, -9.526], [-38.526, -5.5], [-40, 0], [-38.526, 5.5], [-34.5, 9.526], [-29, 11]];

module grip_body() {
  linear_extrude(height = thickness, scale = draft) polygon(grip);
}

difference() {
  union() {
    grip_body();
  }
}
