$fn = 32;

// ----------------------------------------------------------------------
// Handle: 120 x 22 mm grip, 12 mm thick
// ----------------------------------------------------------------------

// --- parameters (mm) ---
length = 120;             // grip length
width = 22;               // grip width
thickness = 12;           // grip thickness
waist = 0.8;              // width factor at the middle
draft = 0.9;              // top face scale of the extrusion

/* ergonomic grip outline, closed spline-like polygon in the XY plane */
grip = [[-49, 11], [-42.875, 10.484], [-36.75, 10.037], [-30.625, 9.659], [-24.5, 9.35], [-18.375, 9.109], [-12.25, 8.938], [-6.125, 8.834], [0, 8.8], [6.125, 8.834], [12.25, 8.938], [18.375, 9.109], [24.5, 9.35], [30.625, 9.659], [36.75, 10.037], [42.875, 10.484], [49, 11], [54.5, 9.526], [58.526, 5.5], [60, 0], [58.526, -5.5], [54.5, -9.526], [49, -11], [49, -11], [42.875, -10.484], [36.75, -10.037], [30.625, -9.659], [24.5, -9.35], [18.375, -9.109], [12.25, -8.938], [6.125, -8.834], [0, -8.8], [-6.125, -8.834], [-12.25, -8.938], [-18.375, -9.109], [-24.5, -9.35], [-30.625, -9.659], [-36.75, -10.037], [-42.875, -10.484], [-49, -11], [-54.5, -9.526], [-58.526, -5.5], [-60, 0], [-58.526, 5.5], [-54.5, 9.526], [-49, 11]];

module grip_body() {
  linear_extrude(height = thickness, scale = draft) polygon(grip);
}

difference() {
  union() {
    grip_body();
  }
}
