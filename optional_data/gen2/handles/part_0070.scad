$fn = 32;

// ----------------------------------------------------------------------
// Handle: 180 x 42 mm grip, 10 mm thick
// ----------------------------------------------------------------------

// --- parameters (mm) ---
length = 180;             // grip length
width = 42;               // grip width
thickness = 10;           // grip thickness
waist = 0.86;             // width factor at the middle
draft = 0.9;              // top face scale of the extrusion
scallops = 5;             // finger rests per side
ripple = 0.06;            // depth factor of the finger rests

/* ergonomic grip outline, closed spline-like polygon in the XY plane */
grip = [[-69, 21], [-60.375, 20.42], [-51.75, 20.08], [-43.125, 18.56], [-34.5, 18.795], [-25.875, 19.353], [-17.25, 17.518], [-8.625, 17.697], [0, 19.144], [8.625, 17.697], [17.25, 17.518], [25.875, 19.353], [34.5, 18.795], [43.125, 18.56], [51.75, 20.08], [60.375, 20.42], [69, 21], [79.5, 18.187], [87.187, 10.5], [90, 0], [87.187, -10.5], [79.5, -18.187], [69, -21], [69, -21], [60.375, -20.42], [51.75, -20.08], [43.125, -18.56], [34.5, -18.795], [25.875, -19.353], [17.25, -17.518], [8.625, -17.697], [0, -19.144], [-8.625, -17.697], [-17.25, -17.518], [-25.875, -19.353], [-34.5, -18.795], [-43.125, -18.56], [-51.75, -20.08], [-60.375, -20.42], [-69, -21], [-79.5, -18.187], [-87.187, -10.5], [-90, 0], [-87.187, 10.5], [-79.5, 18.187], [-69, 21]];

module grip_body() {
  linear_extrude(height = thickness, scale = draft) polygon(grip);
}

difference() {
  union() {
    grip_body();
  }
}
