$fn = 32;

// ----------------------------------------------------------------------
// Handle: 60 x 42 mm grip, 20 mm thick
// ----------------------------------------------------------------------

// --- parameters (mm) ---
length = 60;              // grip length
width = 42;               // grip width
thickness = 20;           // grip thickness
waist = 0.86;             // width factor at the middle
draft = 0.94;             // top face scale of the extrusion
scallops = 4;             // finger rests per side
ripple = 0.05;            // depth factor of the finger rests

/* ergonomic grip outline, closed spline-like polygon in the XY plane */
grip = [[-9, 21], [-7.875, 20.311], [-6.75, 19.283], [-5.625, 19.208], [-4.5, 19.5], [-3.375, 18.473], [-2.25, 17.389], [-1.125, 18.106], [0, 18.963], [1.125, 18.106], [2.25, 17.389], [3.375, 18.473], [4.5, 19.5], [5.625, 19.208], [6.75, 19.283], [7.875, 20.311], [9, 21], [19.5, 18.187], [27.187, 10.5], [30, 0], [27.187, -10.5], [19.5, -18.187], [9, -21], [9, -21], [7.875, -20.311], [6.75, -19.283], [5.625, -19.208], [4.5, -19.5], [3.375, -18.473], [2.25, -17.389], [1.125, -18.106], [0, -18.963], [-1.125, -18.106], [-2.25, -17.389], [-3.375, -18.473], [-4.5, -19.5], [-5.625, -19.208], [-6.75, -19.283], [-7.875, -20.311], [-9, -21], [-19.5, -18.187], [-27.187, -10.5], [-30, 0], [-27.187, 10.5], [-19.5, 18.187], [-9, 21]];

module grip_body() {
  linear_extrude(height = thickness, scale = draft) polygon(grip);
}

difference() {
  union() {
    grip_body();
  }
}
