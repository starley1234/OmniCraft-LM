$fn = 32;

// ----------------------------------------------------------------------
// Handle: 60 x 26 mm grip, 10 mm thick
// ----------------------------------------------------------------------

// --- parameters (mm) ---
length = 60;              // grip length
width = 26;               // grip width
thickness = 10;           // grip thickness
waist = 0.86;             // width factor at the middle
draft = 0.97;             // top face scale of the extrusion

/* ergonomic grip outline, closed spline-like polygon in the XY plane */
grip = [[-17, 13], [-14.875, 12.573], [-12.75, 12.204], [-10.625, 11.891], [-8.5, 11.635], [-6.375, 11.436], [-4.25, 11.294], [-2.125, 11.208], [0, 11.18], [2.125, 11.208], [4.25, 11.294], [6.375, 11.436], [8.5, 11.635], [10.625, 11.891], [12.75, 12.204], [14.875, 12.573], [17, 13], [23.5, 11.258], [28.258, 6.5], [30, 0], [28.258, -6.5], [23.5, -11.258], [17, -13], [17, -13], [14.875, -12.573], [12.75, -12.204], [10.625, -11.891], [8.5, -11.635], [6.375, -11.436], [4.25, -11.294], [2.125, -11.208], [0, -11.18], [-2.125, -11.208], [-4.25, -11.294], [-6.375, -11.436], [-8.5, -11.635], [-10.625, -11.891], [-12.75, -12.204], [-14.875, -12.573], [-17, -13], [-23.5, -11.258], [-28.258, -6.5], [-30, 0], [-28.258, 6.5], [-23.5, 11.258], [-17, 13]];

module grip_body() {
  linear_extrude(height = thickness, scale = draft) polygon(grip);
}

difference() {
  union() {
    grip_body();
  }
}
