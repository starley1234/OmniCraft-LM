$fn = 32;

// ----------------------------------------------------------------------
// Handle: 80 x 30 mm grip, 16 mm thick
// ----------------------------------------------------------------------

// --- parameters (mm) ---
length = 80;              // grip length
width = 30;               // grip width
thickness = 16;           // grip thickness
waist = 0.86;             // width factor at the middle
draft = 0.9;              // top face scale of the extrusion

/* ergonomic grip outline, closed spline-like polygon in the XY plane */
grip = [[-25, 15], [-21.875, 14.508], [-18.75, 14.081], [-15.625, 13.72], [-12.5, 13.425], [-9.375, 13.195], [-6.25, 13.031], [-3.125, 12.933], [0, 12.9], [3.125, 12.933], [6.25, 13.031], [9.375, 13.195], [12.5, 13.425], [15.625, 13.72], [18.75, 14.081], [21.875, 14.508], [25, 15], [32.5, 12.99], [37.99, 7.5], [40, 0], [37.99, -7.5], [32.5, -12.99], [25, -15], [25, -15], [21.875, -14.508], [18.75, -14.081], [15.625, -13.72], [12.5, -13.425], [9.375, -13.195], [6.25, -13.031], [3.125, -12.933], [0, -12.9], [-3.125, -12.933], [-6.25, -13.031], [-9.375, -13.195], [-12.5, -13.425], [-15.625, -13.72], [-18.75, -14.081], [-21.875, -14.508], [-25, -15], [-32.5, -12.99], [-37.99, -7.5], [-40, 0], [-37.99, 7.5], [-32.5, 12.99], [-25, 15]];

module grip_body() {
  linear_extrude(height = thickness, scale = draft) polygon(grip);
}

difference() {
  union() {
    grip_body();
  }
}
