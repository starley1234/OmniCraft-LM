$fn = 32;

// ----------------------------------------------------------------------
// Handle: 120 x 30 mm grip, 20 mm thick
// ----------------------------------------------------------------------

// --- parameters (mm) ---
length = 120;             // grip length
width = 30;               // grip width
thickness = 20;           // grip thickness
waist = 0.8;              // width factor at the middle
draft = 0.9;              // top face scale of the extrusion
scallops = 6;             // finger rests per side
ripple = 0.06;            // depth factor of the finger rests

/* ergonomic grip outline, closed spline-like polygon in the XY plane */
grip = [[-45, 15], [-39.375, 14.155], [-33.75, 13.688], [-28.125, 13.512], [-22.5, 12.176], [-16.875, 12.875], [-11.25, 12.188], [-5.625, 11.544], [0, 12.72], [5.625, 11.544], [11.25, 12.188], [16.875, 12.875], [22.5, 12.176], [28.125, 13.512], [33.75, 13.688], [39.375, 14.155], [45, 15], [52.5, 12.99], [57.99, 7.5], [60, 0], [57.99, -7.5], [52.5, -12.99], [45, -15], [45, -15], [39.375, -14.155], [33.75, -13.688], [28.125, -13.512], [22.5, -12.176], [16.875, -12.875], [11.25, -12.188], [5.625, -11.544], [0, -12.72], [-5.625, -11.544], [-11.25, -12.188], [-16.875, -12.875], [-22.5, -12.176], [-28.125, -13.512], [-33.75, -13.688], [-39.375, -14.155], [-45, -15], [-52.5, -12.99], [-57.99, -7.5], [-60, 0], [-57.99, 7.5], [-52.5, 12.99], [-45, 15]];

module grip_body() {
  linear_extrude(height = thickness, scale = draft) polygon(grip);
}

difference() {
  union() {
    grip_body();
  }
}
